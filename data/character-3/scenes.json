  {
    "id": 4,
    "name": "Orlok: The Summons",
    "description": "Story (about 90 s): the Count wakes his household one by one, the moon rises in the big window, the knight answers from the hill, and the guest is sent to Lady Mina.",
    "steps": [
      {
        "type": "fleet-mode",
        "mode": "hold",
        "node": "Orlok",
        "force": true,
        "maxMs": 150000,
        "reason": "orlok-story"
      },
      {
        "type": "audio",
        "audioId": "spooky-horror-ambience",
        "volume": 40,
        "jawSync": false,
        "concurrent": true
      },
      {
        "type": "wait",
        "duration": 1500
      },
      {
        "type": "pose",
        "poseId": 31
      },
      {
        "type": "goblin-video",
        "goblinName": "Goblin 2",
        "videoId": "Moon.mp4",
        "loop": false,
        "waitMs": 0,
        "concurrent": true
      },
      {
        "type": "sayThis",
        "text": "[Romanian accent] [labored breath] Liniște... quiet. Lună, the moon, climbs my window. Now my household wakes."
      },
      {
        "type": "pose",
        "poseId": 20
      },
      {
        "type": "light",
        "partId": "8",
        "state": "on",
        "brightness": 100,
        "duration": 800
      },
      {
        "type": "sayThis",
        "text": "[Romanian accent] [breathes] Sir Dragomir! Your Lord calls the hill. Does the bar still hold?"
      },
      {
        "type": "fleet-say",
        "node": "Sir Dragomir",
        "text": "[Romanian accent] It holds, my lord. Stai, carriages! The watch stands.",
        "wait": true
      },
      {
        "type": "pose",
        "poseId": 24
      },
      {
        "type": "sayThis",
        "text": "[Romanian accent] [breathes] And the big one in the ground... dig quieter, frate. Brother, the dead are trying to sleep."
      },
      {
        "type": "pose",
        "poseId": 21
      },
      {
        "type": "light",
        "partId": "8",
        "state": "on",
        "brightness": 100,
        "duration": 0
      },
      {
        "type": "sayThis",
        "text": "[Romanian accent] [labored breath] Below us, in oak and iron, the lady dreams. Încet... slowly. Do not wake her."
      },
      {
        "type": "wait",
        "duration": 2500
      },
      {
        "type": "pose",
        "poseId": 32
      },
      {
        "type": "sayThis",
        "text": "[Romanian accent] [breathes] Go down to the wall, prietene. Ask Mina if she dreamed of you. Your Lord... will know."
      },
      {
        "type": "pose",
        "poseId": 33
      },
      {
        "type": "light",
        "partId": "8",
        "state": "off",
        "brightness": 100,
        "duration": 0
      },
      {
        "type": "wait",
        "duration": 3000
      },
      {
        "type": "pose",
        "poseId": 1
      },
      {
        "type": "fleet-mode",
        "mode": "release",
        "node": "Orlok",
        "reason": "orlok-story"
      }
    ]
  },
