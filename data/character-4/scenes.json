        "type": "pose",
        "poseId": 12,
        "options": {
          "transitionDurationMs": 1500
        },
        "concurrent": true
      },
      {
        "type": "wait",
        "duration": 1600
      },
      {
        "type": "fleet-say",
        "node": "Mina",
        "text": "[whispers] Tell Sir Dragomir the night was quiet."
      },
      {
        "type": "wait",
        "duration": 1500
      },
      {
        "type": "pose",
        "poseId": 19,
        "options": {
          "transitionDurationMs": 1500
