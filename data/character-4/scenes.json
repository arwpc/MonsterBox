  {
    "id": 4,
    "name": "Sir Dragomir: The Horseless Carriages",
    "description": "Story (~75 s): he watches the road, mistakes every car for a horseless carriage, shows the wraiths riding with them, and the Count teases him.",
    "steps": [
      {
        "type": "fleet-mode",
        "mode": "hold",
        "node": "Sir Dragomir",
        "maxMs": 150000,
        "reason": "dragomir-scene"
      },
      {
        "type": "audio",
        "audioId": "scary-eerie-and-dramatic-background-sound",
        "volume": 35,
        "jawSync": false,
        "concurrent": true
      },
      {
        "type": "pose",
        "poseId": 1,
        "options": {
          "transitionDurationMs": 1500
        }
      },
      {
        "type": "wait",
        "duration": 1500
      },
      {
        "type": "pose",
        "poseId": 20,
        "options": {
          "transitionDurationMs": 2500
        },
        "concurrent": true
      },
      {
        "type": "wait",
        "duration": 2600
