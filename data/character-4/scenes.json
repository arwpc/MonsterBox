  {
    "id": 6,
    "name": "Sir Dragomir: The Riddle at the Wall",
    "description": "Story (~90 s): dragging chains; a riddle with thinking time, then a fragment of the 1462 siege with the wraith army in the big window, a war cry, and Groundbreaker's answer.",
    "steps": [
      {
        "type": "fleet-mode",
        "mode": "hold",
        "node": "Sir Dragomir",
        "maxMs": 170000,
        "reason": "dragomir-scene"
      },
      {
        "type": "audio",
        "audioId": "09 - Dragging Chains",
        "volume": 35,
        "jawSync": false,
        "concurrent": true
      },
      {
        "type": "pose",
        "poseId": 1,
        "options": {
          "transitionDurationMs": 1500
        }
      },
      {
        "type": "wait",
        "duration": 1500
      },
      {
        "type": "pose",
