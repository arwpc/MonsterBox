<% /** * Unified Calibration UI (Positions v1.5) * MonsterBox - Single-page calibration for all part types */ %>


  <div class="calibration-container">
    <!-- Header -->
    <div class="cal-header">
      <div class="cal-controls">
        <div class="part-selector">
          <select id="partSelect" class="mb-select" title="Select a part to calibrate">
            <option value="">Select a part...</option>
            <% if (parts && parts.length> 0) { %>
              <% parts.forEach(part=> { %>
                <option value="<%= part.id %>" data-type="<%= part.type %>">
                  <%= part.name %> (<%= part.type %>)
                </option>
                <% }); %>
                  <% } %>
          </select>
        </div>

        <button class="emergency-stop" id="eStopBtn" disabled title="Emergency stop all movement">
          🛑 E-STOP
        </button>

        <div class="speed-cap">
          <label>Speed Cap:</label>
          <input type="range" class="mb-range" id="speedCap" min="0" max="100" value="50" title="Set global speed cap" />
          <span class="speed-value" id="speedValue">50%</span>
        </div>
      </div>
    </div>

    <!-- Alert Area -->
    <div id="alertArea"></div>

    <!-- PCA9685 Board Visual + Channel Assignment -->
    <div class="pca-board-section">
      <div class="cal-panel">
        <h2>PCA9685 Servo Driver Board</h2>

        <div class="pca-board-wrapper">
          <!-- Visual board rendering -->
          <div class="pca-board" id="pcaBoard">
            <div class="pca-board-title">PCA9685</div>
            <div class="pca-board-subtitle">16-CHANNEL 12-BIT PWM DRIVER</div>

            <!-- I2C input header (left side) -->
            <div class="pca-i2c-header">
              <div class="pca-i2c-pin"><span class="pca-i2c-label">GND</span></div>
              <div class="pca-i2c-pin"><span class="pca-i2c-label">OE</span></div>
              <div class="pca-i2c-pin"><span class="pca-i2c-label">SCL</span></div>
              <div class="pca-i2c-pin"><span class="pca-i2c-label">SDA</span></div>
              <div class="pca-i2c-pin"><span class="pca-i2c-label">VCC</span></div>
              <div class="pca-i2c-pin"><span class="pca-i2c-label">V+</span></div>
            </div>

            <!-- PCA9685 chip (center) -->
            <div class="pca-chip">
              <div class="pca-chip-text">PCA9685<br>NXP</div>
            </div>

            <!-- LED power indicator -->
            <div class="pca-led" title="Power LED"></div>

            <!-- Electrolytic capacitor -->
            <div class="pca-cap"><div class="pca-cap-stripe"></div></div>

            <!-- Screw terminal for V+ -->
            <div class="pca-screw-terminal"></div>

            <!-- Address jumper pads -->
            <div class="pca-addr-jumpers">
              <div class="pca-addr-label">A0</div>
              <div class="pca-addr-pad"></div>
              <div class="pca-addr-label">A1</div>
              <div class="pca-addr-pad"></div>
              <div class="pca-addr-label">A2</div>
              <div class="pca-addr-pad"></div>
              <div class="pca-addr-label">A3</div>
              <div class="pca-addr-pad"></div>
              <div class="pca-addr-label">A4</div>
              <div class="pca-addr-pad"></div>
              <div class="pca-addr-label">A5</div>
              <div class="pca-addr-pad"></div>
            </div>

            <!-- 16 Servo Channel Ports -->
            <div class="pca-channels-area">
              <!-- Row 1: Channels 0-7 -->
              <div class="pca-channels-row" id="pcaRow1">
                <% for (var ch = 0; ch < 8; ch++) { %>
                <div class="pca-channel" data-channel="<%= ch %>" id="pcaCh<%= ch %>" onclick="selectPcaChannel(<%= ch %>)" title="Select this servo channel">
                  <div class="pca-channel-tooltip" id="pcaTooltip<%= ch %>">
                    Ch <%= ch %>: <span class="pca-tooltip-part">Empty</span>
                  </div>
                  <div class="pca-channel-label"><%= ch %></div>
                  <div class="pca-pin-group">
                    <div class="pca-pin pca-pin-sig"></div>
                    <div class="pca-pin pca-pin-vcc"></div>
                    <div class="pca-pin pca-pin-gnd"></div>
                  </div>
                </div>
                <% } %>
              </div>
              <!-- Row 2: Channels 8-15 -->
              <div class="pca-channels-row" id="pcaRow2">
                <% for (var ch = 8; ch < 16; ch++) { %>
                <div class="pca-channel" data-channel="<%= ch %>" id="pcaCh<%= ch %>" onclick="selectPcaChannel(<%= ch %>)" title="Select this servo channel">
                  <div class="pca-channel-tooltip" id="pcaTooltip<%= ch %>">
                    Ch <%= ch %>: <span class="pca-tooltip-part">Empty</span>
                  </div>
                  <div class="pca-channel-label"><%= ch %></div>
                  <div class="pca-pin-group">
                    <div class="pca-pin pca-pin-sig"></div>
                    <div class="pca-pin pca-pin-vcc"></div>
                    <div class="pca-pin pca-pin-gnd"></div>
                  </div>
                </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Channel assignment table -->
          <div class="pca-assignment-panel">
            <table class="pca-assignment-table">
              <thead>
                <tr>
                  <th>Ch</th>
                  <th>Assigned Part</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="pcaAssignmentBody">
                <!-- Populated by JS -->
              </tbody>
            </table>

            <div class="pca-legend">
              <div class="pca-legend-item"><div class="pca-legend-dot sig"></div> Unassigned</div>
              <div class="pca-legend-item"><div class="pca-legend-dot assigned"></div> Assigned</div>
              <div class="pca-legend-item"><div class="pca-legend-dot selected"></div> Selected</div>
              <div class="pca-legend-item"><div class="pca-legend-dot conflict"></div> Conflict</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="cal-grid">
      <!-- Left Column: Jog & Bounds -->
      <div>
        <!-- Jog Panel -->
        <div class="cal-panel">
          <h2>Jog Controls</h2>

          <div class="position-display">
            <div class="position-value" id="positionValue">-</div>
            <div class="position-label">Current Position (normalized)</div>
            <div class="mt-1">
              <span id="calConfidenceBadge" class="mb-badge hidden">Unknown</span>
            </div>
          </div>

          <!-- Home Button (open-loop parts only) -->
          <div id="calHomeSection" class="text-center mb-2 hidden">
            <button class="mb-btn mb-btn-secondary mb-btn-sm" id="homeBtn" disabled title="Home part to retract endstop">
              <i class="bi bi-house-door"></i> Home (Retract to Endstop)
            </button>
          </div>

          <div class="jog-pad">
            <div class="scale-selector">
              <button class="scale-btn active" data-scale="fine" title="Use fine jog step">Fine</button>
              <button class="scale-btn" data-scale="med" title="Use medium jog step">Med</button>
              <button class="scale-btn" data-scale="coarse" title="Use coarse jog step">Coarse</button>
            </div>

            <div class="jog-buttons">
              <button class="jog-btn" id="jogMin" disabled title="Jog toward minimum">◀ Min</button>
              <button class="jog-btn stop" id="stopBtn" disabled title="Stop movement">STOP</button>
              <button class="jog-btn" id="jogMax" disabled title="Jog toward maximum">Max ▶</button>
            </div>
          </div>
        </div>

        <!-- Bounds Panel -->
        <div class="cal-panel cal-panel-gap">
          <h2>Calibration Bounds</h2>

          <div class="bounds-display">
            <div>
              <strong>Min:</strong> <span id="minBound">0.000</span>
            </div>
            <div>
              <strong>Max:</strong> <span id="maxBound">1.000</span>
            </div>
          </div>

          <div class="bounds-actions">
            <button class="cal-action-btn" id="setMinBtn" disabled title="Set minimum bound here">Set Min</button>
            <button class="cal-action-btn" id="setMaxBtn" disabled title="Set maximum bound here">Set Max</button>
          </div>
        </div>

        <!-- Learn Move Panel (for open-loop only) -->
        <div class="cal-panel cal-panel-gap hidden" id="learnPanel">
          <h2>Learn Movement (Open-Loop)</h2>

          <div class="learn-panel">
            <h3>⚠️ Advanced: Motion Calibration</h3>
            <p>Run probes at different speeds to calibrate time-based positioning.</p>

            <div class="probe-inputs">
              <div class="probe-row">
                <span>30% PWM</span>
                <input type="number" id="probe1Time" placeholder="Time (ms)" value="600" title="Probe run time in milliseconds" />
                <input type="number" id="probe1Delta" placeholder="Distance moved" step="0.01" title="Measured distance moved" />
                <button class="btn-small btn-go" onclick="runProbe(0)" title="Run probe at 30% PWM">Run</button>
              </div>
              <div class="probe-row">
                <span>50% PWM</span>
                <input type="number" id="probe2Time" placeholder="Time (ms)" value="600" title="Probe run time in milliseconds" />
                <input type="number" id="probe2Delta" placeholder="Distance moved" step="0.01" title="Measured distance moved" />
                <button class="btn-small btn-go" onclick="runProbe(1)" title="Run probe at 50% PWM">Run</button>
              </div>
              <div class="probe-row">
                <span>70% PWM</span>
                <input type="number" id="probe3Time" placeholder="Time (ms)" value="600" title="Probe run time in milliseconds" />
                <input type="number" id="probe3Delta" placeholder="Distance moved" step="0.01" title="Measured distance moved" />
                <button class="btn-small btn-go" onclick="runProbe(2)" title="Run probe at 70% PWM">Run</button>
              </div>
            </div>

            <button class="cal-action-btn" id="saveLearnBtn" disabled title="Save learned motion model">Save Learned Motion</button>
          </div>
        </div>
      </div>

      <!-- Right Column: Presets -->
      <div>
        <div class="cal-panel">
          <h2>Position Presets</h2>

          <div class="add-preset">
            <input type="text" id="presetName" placeholder="Preset name..." title="Enter a preset name" />
            <button class="cal-action-btn" id="addPresetBtn" disabled title="Save current position as preset">Set Here</button>
          </div>

          <div class="presets-list" id="presetsList">
            <div class="alert alert-info">
              Select a part to view and manage presets.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Status Bar -->
  <div class="status-bar">
    <div class="status-info">
      <div class="status-item">
        <span class="status-label">Selected Part</span>
        <span class="status-value" id="statusPart">None</span>
      </div>
      <div class="status-item">
        <span class="status-label">Part Type</span>
        <span class="status-value" id="statusType">-</span>
      </div>
      <div class="status-item">
        <span class="status-label">Capability</span>
        <span class="status-value" id="statusCapability">-</span>
      </div>
    </div>
    <div class="status-item">
      <span class="status-label">System Status</span>
      <span class="status-value" id="statusSystem">Ready</span>
    </div>
  </div>

  <!-- Named confirmation for destructive calibration actions. -->
  <div class="mb-modal hidden" id="calConfirmModal" role="dialog" aria-modal="true" aria-labelledby="calConfirmTitle">
    <div class="mb-modal-backdrop" id="calConfirmBackdrop"></div>
    <div class="mb-modal-dialog">
      <div class="mb-modal-header">
        <h2 class="mb-modal-title" id="calConfirmTitle">Delete preset</h2>
      </div>
      <div class="mb-modal-body">
        <p class="mb-0" id="calConfirmBody">This cannot be undone.</p>
      </div>
      <div class="mb-modal-footer">
        <button type="button" class="mb-btn mb-btn-secondary" id="calConfirmCancel" title="Cancel">Cancel</button>
        <button type="button" class="mb-btn mb-btn-danger" id="calConfirmOk" title="Confirm delete">Delete</button>
      </div>
    </div>
  </div>

  <script>
    // State
    let currentPartId = null;
    let currentProfile = null;
    let currentScale = 'fine';
    let globalSpeedCap = 50;
    let isMoving = false;

    // PCA9685 board state
    let allParts = [];            // All parts for current character
    let pcaChannelMap = {};       // channel -> part mapping
    let selectedPcaChannel = -1;  // Currently selected channel on the board

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      setupEventListeners();
      updateSpeedCap();
      loadPcaBoardState();
    });

    function setupEventListeners() {
      // Part selection
      document.getElementById('partSelect').addEventListener('change', handlePartSelect);

      // E-Stop
      document.getElementById('eStopBtn').addEventListener('click', emergencyStop);

      // Speed cap
      document.getElementById('speedCap').addEventListener('input', (e) => {
        globalSpeedCap = parseInt(e.target.value, 10);
        document.getElementById('speedValue').textContent = globalSpeedCap + '%';
        updateSpeedCap();
      });

      // Scale selection
      document.querySelectorAll('.scale-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('.scale-btn').forEach(b => b.classList.remove('active'));
          e.target.classList.add('active');
          currentScale = e.target.dataset.scale;
        });
      });

      // Jog buttons
      document.getElementById('jogMin').addEventListener('click', () => nudge('min'));
      document.getElementById('jogMax').addEventListener('click', () => nudge('max'));
      document.getElementById('stopBtn').addEventListener('click', stopMovement);

      // Bounds
      document.getElementById('setMinBtn').addEventListener('click', setMin);
      document.getElementById('setMaxBtn').addEventListener('click', setMax);

      // Presets
      document.getElementById('addPresetBtn').addEventListener('click', addPreset);

      // Home button
      document.getElementById('homeBtn').addEventListener('click', homePart);
    }

    async function handlePartSelect(e) {
      const partId = e.target.value;
      if (!partId) {
        disableAllControls();
        return;
      }

      currentPartId = parseInt(partId, 10);
      const partType = e.target.selectedOptions[0].dataset.type;

      showAlert('Loading calibration profile...', 'info');

      try {
        // Load profile
        const response = await fetch(`/api/calibration/${currentPartId}/profile`);
        const data = await response.json();

        if (data.success && data.profile) {
          currentProfile = data.profile;
          enableControls();
          updateUI();
          showAlert(`Loaded profile for ${e.target.selectedOptions[0].text}`, 'info');
        } else {
          // Create default profile
          await createDefaultProfile(partType);
        }
      } catch (err) {
        showAlert('Failed to load profile: ' + err.message, 'danger');
        console.error('Load profile error:', err);
      }

      // Update status bar
      document.getElementById('statusPart').textContent = e.target.selectedOptions[0].text;
      document.getElementById('statusType').textContent = partType;

      // Show/hide home button for open-loop parts
      const isOpenLoop = partType === 'linear_actuator' || partType === 'continuous_servo';
      const homeSection = document.getElementById('calHomeSection');
      const homeBtn = document.getElementById('homeBtn');
      if (homeSection) homeSection.classList.toggle('hidden', !isOpenLoop);
      if (homeBtn) homeBtn.disabled = !partId;

      // Fetch current position and confidence on part select
      await updatePosition();
    }

    async function createDefaultProfile(partType) {
      const capability = getDefaultCapability(partType);
      const motion = getDefaultMotion(partType);

      const profile = {
        partId: currentPartId,
        capability,
        bounds: { minP: 0, maxP: 1 },
        presets: [],
        motion,
        version: 1
      };

      try {
        const response = await fetch(`/api/calibration/${currentPartId}/profile`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(profile)
        });

        const data = await response.json();
        if (data.success) {
          currentProfile = data.profile;
          enableControls();
          updateUI();
          showAlert('Created new calibration profile', 'info');
        }
      } catch (err) {
        showAlert('Failed to create profile: ' + err.message, 'danger');
      }
    }

    function getDefaultCapability(partType) {
      if (partType === 'servo') {
        return { kind: 'absolute-servo', usMin: 500, usMax: 2500, invert: false };
      } else if (partType === 'linear_actuator' || partType === 'motor') {
        return { kind: 'openloop-linear', invert: false };
      } else if (partType === 'stepper') {
        return { kind: 'stepper', stepsMin: 0, stepsMax: 200, invert: false };
      }
      return { kind: 'absolute-servo', usMin: 500, usMax: 2500, invert: false };
    }

    function getDefaultMotion(partType) {
      if (partType === 'servo' || partType === 'stepper') {
        return { type: 'direct-map' };
      } else {
        return {
          type: 'time-at-speed',
          bins: [{ pwmPct: 50, unitsPerSec: 0.2 }],
          settleMs: 120
        };
      }
    }

    function enableControls() {
      document.getElementById('eStopBtn').disabled = false;
      document.getElementById('jogMin').disabled = false;
      document.getElementById('jogMax').disabled = false;
      document.getElementById('stopBtn').disabled = false;
      document.getElementById('setMinBtn').disabled = false;
      document.getElementById('setMaxBtn').disabled = false;
      document.getElementById('addPresetBtn').disabled = false;

      // Show learn panel for open-loop
      if (currentProfile && currentProfile.motion.type === 'time-at-speed') {
        document.getElementById('learnPanel').classList.remove('hidden');
      } else {
        document.getElementById('learnPanel').classList.add('hidden');
      }
    }

    function disableAllControls() {
      document.getElementById('eStopBtn').disabled = true;
      document.getElementById('jogMin').disabled = true;
      document.getElementById('jogMax').disabled = true;
      document.getElementById('stopBtn').disabled = true;
      document.getElementById('setMinBtn').disabled = true;
      document.getElementById('setMaxBtn').disabled = true;
      document.getElementById('addPresetBtn').disabled = true;
      document.getElementById('learnPanel').classList.add('hidden');
    }

    function updateUI() {
      if (!currentProfile) return;

      // Update bounds display
      document.getElementById('minBound').textContent = currentProfile.bounds.minP.toFixed(3);
      document.getElementById('maxBound').textContent = currentProfile.bounds.maxP.toFixed(3);

      // Update capability
      document.getElementById('statusCapability').textContent = currentProfile.capability.kind;

      // Update presets list
      renderPresets();
    }

    function renderPresets() {
      const container = document.getElementById('presetsList');
      if (!currentProfile || !currentProfile.presets || currentProfile.presets.length === 0) {
        container.innerHTML = '<div class="alert alert-info">No presets yet. Add one using "Set Here".</div>';
        return;
      }

      container.innerHTML = currentProfile.presets.map(preset => `
    <div class="preset-item">
      <div class="preset-info">
        <div class="preset-name">${escapeHtml(preset.name)}</div>
        <div class="preset-value">p = ${preset.p.toFixed(3)}</div>
      </div>
      <div class="preset-actions">
        <button title="Move the part to this saved preset" class="btn-small btn-go" onclick="goToPreset('${escapeHtml(preset.name)}')">Go</button>
        <button title="Delete this saved preset" class="btn-small btn-delete" onclick="deletePreset('${escapeHtml(preset.name)}')">Delete</button>
      </div>
    </div>
  `).join('');
    }

    async function nudge(dir) {
      if (isMoving) return;
      isMoving = true;
      document.getElementById('statusSystem').textContent = 'Moving...';

      try {
        const response = await fetch(`/api/calibration/${currentPartId}/nudge`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dir, scale: currentScale })
        });

        const data = await response.json();
        if (data.success) {
          showAlert(`Nudged ${dir} (${currentScale})`, 'info');
          await updatePosition();
        } else {
          showAlert('Nudge failed: ' + data.error, 'danger');
        }
      } catch (err) {
        showAlert('Nudge error: ' + err.message, 'danger');
      } finally {
        isMoving = false;
        document.getElementById('statusSystem').textContent = 'Ready';
      }
    }

    async function stopMovement() {
      try {
        const response = await fetch(`/api/calibration/${currentPartId}/stop`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();
        if (data.success) {
          showAlert('Movement stopped', 'warning');
        }
      } catch (err) {
        showAlert('Stop failed: ' + err.message, 'danger');
      } finally {
        isMoving = false;
        document.getElementById('statusSystem').textContent = 'Ready';
      }
    }

    async function emergencyStop() {
      await stopMovement();
      showAlert('🛑 EMERGENCY STOP ACTIVATED', 'danger');
    }

    async function setMin() {
      try {
        const response = await fetch(`/api/calibration/${currentPartId}/set-min`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();
        if (data.success) {
          currentProfile.bounds = data.bounds;
          updateUI();
          showAlert('Min bound set to current position', 'info');
        }
      } catch (err) {
        showAlert('Set min failed: ' + err.message, 'danger');
      }
    }

    async function setMax() {
      try {
        const response = await fetch(`/api/calibration/${currentPartId}/set-max`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const data = await response.json();
        if (data.success) {
          currentProfile.bounds = data.bounds;
          updateUI();
          showAlert('Max bound set to current position', 'info');
        }
      } catch (err) {
        showAlert('Set max failed: ' + err.message, 'danger');
      }
    }

    async function addPreset() {
      const name = document.getElementById('presetName').value.trim();
      if (!name) {
        showAlert('Enter a preset name', 'warning');
        return;
      }

      // Get current position from display
      const currentP = parseFloat(document.getElementById('positionValue').textContent) || 0.5;

      // Add to profile
      const existingIndex = currentProfile.presets.findIndex(p => p.name === name);
      if (existingIndex >= 0) {
        currentProfile.presets[existingIndex].p = currentP;
      } else {
        currentProfile.presets.push({ name, p: currentP });
      }

      try {
        const response = await fetch(`/api/calibration/${currentPartId}/profile`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(currentProfile)
        });

        const data = await response.json();
        if (data.success) {
          currentProfile = data.profile;
          document.getElementById('presetName').value = '';
          renderPresets();
          showAlert(`Preset "${name}" saved at ${currentP.toFixed(3)}`, 'info');
        }
      } catch (err) {
        showAlert('Save preset failed: ' + err.message, 'danger');
      }
    }

    async function goToPreset(name) {
      const preset = currentProfile.presets.find(p => p.name === name);
      if (!preset) return;

      if (isMoving) return;
      isMoving = true;
      document.getElementById('statusSystem').textContent = 'Moving...';

      try {
        const response = await fetch(`/api/calibration/${currentPartId}/goto`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ p: preset.p, speedPct: globalSpeedCap })
        });

        const data = await response.json();
        if (data.success) {
          showAlert(`Moving to preset "${name}"`, 'info');
          await updatePosition();
        } else {
          showAlert('Move failed: ' + data.error, 'danger');
        }
      } catch (err) {
        showAlert('Move error: ' + err.message, 'danger');
      } finally {
        isMoving = false;
        document.getElementById('statusSystem').textContent = 'Ready';
      }
    }

    async function deletePreset(name) {
      // Name what is about to be destroyed. A native browser dialog cannot be styled,
      // is unusable on a phone, and reads identically for every preset.
      const ok = await confirmDestructive('Delete preset', `Delete preset "${name}"? This cannot be undone.`);
      if (!ok) return;

      currentProfile.presets = currentProfile.presets.filter(p => p.name !== name);

      try {
        const response = await fetch(`/api/calibration/${currentPartId}/profile`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(currentProfile)
        });

        const data = await response.json();
        if (data.success) {
          currentProfile = data.profile;
          renderPresets();
          showAlert(`Preset "${name}" deleted`, 'info');
        }
      } catch (err) {
        showAlert('Delete preset failed: ' + err.message, 'danger');
      }
    }

    // Update confidence badge for open-loop parts
    function updateConfidenceBadge(positionKnown, confidence) {
      const badge = document.getElementById('calConfidenceBadge');
      if (!badge) return;
      // Only show when home section is visible (open-loop parts)
      const homeSection = document.getElementById('calHomeSection');
      if (!homeSection || homeSection.classList.contains('hidden')) {
        badge.classList.add('hidden');
        return;
      }
      badge.classList.remove('hidden');
      if (confidence === 'homed') {
        badge.className = 'mb-badge mb-badge-success';
        badge.textContent = 'Homed';
      } else if (confidence === 'tracked' && positionKnown !== false) {
        badge.className = 'mb-badge mb-badge-warning';
        badge.textContent = 'Tracked';
      } else {
        badge.className = 'mb-badge mb-badge-danger';
        badge.textContent = 'Unknown - Home Required';
      }
    }

    // Home part to retract endstop
    async function homePart() {
      if (!currentPartId) return;
      const btn = document.getElementById('homeBtn');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Homing...';
      }
      try {
        const response = await fetch(`/api/calibration/${currentPartId}/home`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ direction: 'retract' })
        });
        const data = await response.json();
        if (data.success) {
          if (data.currentP != null) {
            document.getElementById('positionValue').textContent = Number(data.currentP).toFixed(3);
          }
          updateConfidenceBadge(data.positionKnown, data.confidence);
          showAlert('Homed successfully', 'info');
        } else {
          showAlert('Home failed: ' + (data.error || 'Unknown'), 'danger');
        }
      } catch (err) {
        showAlert('Home error: ' + err.message, 'danger');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-house-door"></i> Home (Retract to Endstop)';
        }
      }
    }

    async function updatePosition() {
      if (!currentPartId) return;
      try {
        const response = await fetch(`/api/calibration/${currentPartId}/position`);
        const data = await response.json();
        if (data.success && data.currentP != null) {
          document.getElementById('positionValue').textContent = Number(data.currentP).toFixed(3);
          updateConfidenceBadge(data.positionKnown, data.confidence);
        }
      } catch (err) {
        console.warn('Could not read position:', err.message);
      }
    }

    async function updateSpeedCap() {
      try {
        await fetch('/api/calibration/global-speed-cap', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ speedPct: globalSpeedCap })
        });
      } catch (err) {
        console.error('Failed to update speed cap:', err);
      }
    }

    function showAlert(message, type = 'info') {
      const alertArea = document.getElementById('alertArea');
      const alert = document.createElement('div');
      alert.className = `mb-alert mb-alert-${type}`;
      alert.textContent = message;
      alertArea.innerHTML = '';
      alertArea.appendChild(alert);
      setTimeout(() => alert.remove(), 5000);
    }

    /**
     * Styled, named confirmation for a destructive action. Resolves true/false.
     * Falls back to the browser dialog only if the markup is missing, so the
     * failure mode is "still asks" rather than "deletes silently".
     */
    function confirmDestructive(title, body) {
      return new Promise((resolve) => {
        const modal = document.getElementById('calConfirmModal');
        const okBtn = document.getElementById('calConfirmOk');
        const noBtn = document.getElementById('calConfirmCancel');
        const backdrop = document.getElementById('calConfirmBackdrop');
        const titleEl = document.getElementById('calConfirmTitle');
        const bodyEl = document.getElementById('calConfirmBody');

        if (!modal || !okBtn || !noBtn) { resolve(window.confirm(body)); return; }

        titleEl.textContent = title;
        bodyEl.textContent = body;

        const close = (result) => {
          modal.classList.add('hidden');
          okBtn.removeEventListener('click', onOk);
          noBtn.removeEventListener('click', onNo);
          if (backdrop) backdrop.removeEventListener('click', onNo);
          document.removeEventListener('keydown', onKey);
          resolve(result);
        };
        const onOk = () => close(true);
        const onNo = () => close(false);
        const onKey = (evt) => { if (evt.key === 'Escape') close(false); };

        okBtn.addEventListener('click', onOk);
        noBtn.addEventListener('click', onNo);
        if (backdrop) backdrop.addEventListener('click', onNo);
        document.addEventListener('keydown', onKey);

        modal.classList.remove('hidden');
        okBtn.focus();
      });
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Probe functions for learn mode
    async function runProbe(index) {
      const pwmPcts = [30, 50, 70];
      const timeInputs = ['probe1Time', 'probe2Time', 'probe3Time'];
      const deltaInputs = ['probe1Delta', 'probe2Delta', 'probe3Delta'];

      const msRun = parseInt(document.getElementById(timeInputs[index]).value, 10);
      const pwmPct = pwmPcts[index];

      showAlert(`Running probe at ${pwmPct}% for ${msRun}ms...`, 'info');

      // Simulate probe run - in production, this would actually move the part
      // and user would measure the distance traveled
      setTimeout(() => {
        showAlert(`Probe ${index + 1} complete. Enter measured distance.`, 'info');
      }, msRun + 500);
    }

    // ==================== PCA9685 Board Functions ====================

    async function loadPcaBoardState() {
      try {
        var response = await fetch('/setup/calibration/api/parts');
        var data = await response.json();
        if (data.success && data.parts) {
          allParts = data.parts;
        } else {
          allParts = [];
        }
      } catch (err) {
        console.error('Failed to load parts for PCA board:', err);
        allParts = [];
      }
      buildPcaChannelMap();
      renderPcaBoard();
      renderPcaAssignmentTable();
    }

    function buildPcaChannelMap() {
      pcaChannelMap = {};
      var channelCounts = {};

      allParts.forEach(function(part) {
        if (!part.config) return;
        var ch = part.config.channel;
        if (ch == null && part.config.pcaChannel != null) ch = part.config.pcaChannel;
        if (ch == null) return;
        // Only PCA9685 servos
        var ctlType = part.config.controllerType || part.controllerType || '';
        if (ctlType !== 'pca9685') return;

        ch = parseInt(ch, 10);
        if (isNaN(ch) || ch < 0 || ch > 15) return;

        channelCounts[ch] = (channelCounts[ch] || 0) + 1;

        if (!pcaChannelMap[ch]) {
          pcaChannelMap[ch] = [];
        }
        pcaChannelMap[ch].push(part);
      });
    }

    function renderPcaBoard() {
      for (var ch = 0; ch < 16; ch++) {
        var el = document.getElementById('pcaCh' + ch);
        if (!el) continue;

        el.classList.remove('assigned', 'conflict', 'selected-channel');

        var parts = pcaChannelMap[ch];
        var tooltipPart = el.querySelector('.pca-tooltip-part');

        if (parts && parts.length > 0) {
          if (parts.length > 1) {
            el.classList.add('conflict');
            tooltipPart.textContent = parts.length + ' parts (CONFLICT!)';
          } else {
            el.classList.add('assigned');
            tooltipPart.textContent = parts[0].name;
          }
        } else {
          tooltipPart.textContent = 'Empty';
        }

        if (ch === selectedPcaChannel) {
          el.classList.add('selected-channel');
        }
      }
    }

    function renderPcaAssignmentTable() {
      var tbody = document.getElementById('pcaAssignmentBody');
      if (!tbody) return;

      // Build options list from servo parts
      var servoParts = allParts.filter(function(p) {
        return p.type === 'servo';
      });

      var rows = '';
      for (var ch = 0; ch < 16; ch++) {
        var parts = pcaChannelMap[ch] || [];
        var isConflict = parts.length > 1;
        var assigned = parts.length > 0 ? parts[0] : null;

        var partOptions = '<option value="">-- empty --</option>';
        servoParts.forEach(function(p) {
          var sel = (assigned && String(p.id) === String(assigned.id)) ? ' selected' : '';
          partOptions += '<option value="' + p.id + '"' + sel + '>' + escapeHtml(p.name) + ' (id:' + p.id + ')</option>';
        });

        var conflictBadge = isConflict ? ' <span class="pca-conflict-flag" title="Multiple parts assigned to this channel!">CONFLICT</span>' : '';

        rows += '<tr' + (ch === selectedPcaChannel ? ' class="is-selected"' : '') + '>';
        rows += '<td class="ch-num">' + ch + '</td>';
        rows += '<td><select title="Assign a hardware part to this PCA9685 channel" class="pca-ch-select" data-channel="' + ch + '" onchange="assignPartToChannel(' + ch + ', this.value)">' + partOptions + '</select>' + conflictBadge + '</td>';
        rows += '<td><button title="Test this PCA9685 servo channel" class="pca-test-btn" id="pcaTestBtn' + ch + '" onclick="testPcaChannel(' + ch + ')"' + (!assigned ? ' disabled' : '') + '>Test</button></td>';
        rows += '</tr>';
      }

      tbody.innerHTML = rows;
    }

    function selectPcaChannel(ch) {
      selectedPcaChannel = (selectedPcaChannel === ch) ? -1 : ch;
      renderPcaBoard();
      renderPcaAssignmentTable();

      // Also select the part in the main calibration dropdown if one is assigned
      var parts = pcaChannelMap[ch];
      if (parts && parts.length === 1) {
        var select = document.getElementById('partSelect');
        if (select) {
          select.value = parts[0].id;
          select.dispatchEvent(new Event('change'));
        }
      }
    }

    async function assignPartToChannel(channel, partId) {
      if (!partId) {
        // Unassign: find the part currently on this channel and clear its channel
        var existing = pcaChannelMap[channel];
        if (existing && existing.length > 0) {
          for (var i = 0; i < existing.length; i++) {
            await updatePartChannel(existing[i].id, null);
          }
        }
        await loadPcaBoardState();
        showAlert('Channel ' + channel + ' cleared', 'info');
        return;
      }

      // Assign: update the part's config.channel
      await updatePartChannel(partId, channel);
      await loadPcaBoardState();
      showAlert('Assigned to channel ' + channel, 'info');
    }

    async function updatePartChannel(partId, channel) {
      try {
        // Load current part data first
        var part = allParts.find(function(p) { return String(p.id) === String(partId); });
        if (!part) return;

        var config = Object.assign({}, part.config || {});
        if (channel !== null) {
          config.channel = parseInt(channel, 10);
          config.controllerType = 'pca9685';
          if (!config.address) config.address = 64; // 0x40
        } else {
          delete config.channel;
        }

        var response = await fetch('/setup/calibration/api/parts/' + partId, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ config: config })
        });

        var data = await response.json();
        if (!data.success) {
          showAlert('Failed to update channel: ' + (data.error || 'Unknown error'), 'danger');
        }
      } catch (err) {
        showAlert('Error updating channel: ' + err.message, 'danger');
      }
    }

    async function testPcaChannel(channel) {
      var btn = document.getElementById('pcaTestBtn' + channel);
      var parts = pcaChannelMap[channel];
      if (!parts || parts.length === 0) return;

      var part = parts[0];
      if (btn) {
        btn.classList.remove('test-ok', 'test-fail');
        btn.classList.add('testing');
        btn.textContent = 'Testing...';
        btn.disabled = true;
      }

      try {
        var response = await fetch('/api/parts/' + part.id + '/test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'test' })
        });

        var data = await response.json();

        if (btn) {
          btn.classList.remove('testing');
          btn.disabled = false;
          if (data.success) {
            btn.classList.add('test-ok');
            btn.textContent = 'OK';
            showAlert('Channel ' + channel + ' (' + part.name + '): Test passed', 'info');
          } else {
            btn.classList.add('test-fail');
            btn.textContent = 'FAIL';
            showAlert('Channel ' + channel + ' (' + part.name + '): ' + (data.error || 'Test failed'), 'danger');
          }
        }

        // Reset button text after 3 seconds
        setTimeout(function() {
          if (btn) {
            btn.classList.remove('test-ok', 'test-fail');
            btn.textContent = 'Test';
          }
        }, 3000);

      } catch (err) {
        if (btn) {
          btn.classList.remove('testing');
          btn.classList.add('test-fail');
          btn.textContent = 'ERR';
          btn.disabled = false;
        }
        showAlert('Test error on channel ' + channel + ': ' + err.message, 'danger');

        setTimeout(function() {
          if (btn) {
            btn.classList.remove('test-fail');
            btn.textContent = 'Test';
          }
        }, 3000);
      }
    }

    // ==================== End PCA9685 Board Functions ====================

    document.getElementById('saveLearnBtn')?.addEventListener('click', async () => {
      const probes = [
        {
          pwmPct: 30,
          msRun: parseInt(document.getElementById('probe1Time').value, 10),
          measuredDeltaP: parseFloat(document.getElementById('probe1Delta').value) || 0
        },
        {
          pwmPct: 50,
          msRun: parseInt(document.getElementById('probe2Time').value, 10),
          measuredDeltaP: parseFloat(document.getElementById('probe2Delta').value) || 0
        },
        {
          pwmPct: 70,
          msRun: parseInt(document.getElementById('probe3Time').value, 10),
          measuredDeltaP: parseFloat(document.getElementById('probe3Delta').value) || 0
        }
      ].filter(p => p.measuredDeltaP > 0);

      if (probes.length < 2) {
        showAlert('Need at least 2 completed probes', 'warning');
        return;
      }

      try {
        const response = await fetch(`/api/calibration/${currentPartId}/learn-openloop`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ probes })
        });

        const data = await response.json();
        if (data.success) {
          currentProfile.motion = data.motion;
          showAlert('Motion model learned successfully!', 'info');
        }
      } catch (err) {
        showAlert('Learn failed: ' + err.message, 'danger');
      }
    });
  </script>