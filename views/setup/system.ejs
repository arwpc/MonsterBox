          <div class="mb-panel-header"><h5 class="mb-panel-title"><i class="bi bi-person-walking"></i> Idle Loop Status</h5></div>
          <div class="mb-panel-body">
            <dl class="row mb-0">
              <dt class="col-sm-5">Status</dt>
              <dd class="col-sm-7"><span class="mb-badge" id="mvtIdleStatus">—</span></dd>
              <dt class="col-sm-5">Current Pose</dt>
              <dd class="col-sm-7" id="mvtIdlePose">—</dd>
