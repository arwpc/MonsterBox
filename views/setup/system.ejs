      <div class="col-lg-6">
        <div class="mb-panel h-100">
          <div class="mb-panel-header"><h5 class="mb-panel-title"><i class="bi bi-gear"></i> Servo Health</h5></div>
          <div class="mb-panel-body" id="mvtServoHealth">
            <p class="mb-text-muted mb-0">No telemetry data yet</p>
          </div>
