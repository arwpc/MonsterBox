</div>

<div id="systemAlerts" class="mt-3"></div>

<script>
(function () {
  'use strict';
  /* ─── Helpers ──────────────────────────────────────────────────────────────── */
  var $ = function (sel) { return document.querySelector(sel); };
  var $$ = function (sel) { return document.querySelectorAll(sel); };

  /* ─── Feedback primitives ──────────────────────────────────────────────────
     This page used to reach for the browser's own blocking dialogs. A native
     dialog cannot be themed, is unusable on a phone, and — the reason that
     matters most on THIS page — cannot show which node it is about to power
     off. These are the design system's toast and modal instead.
     ─────────────────────────────────────────────────────────────────────── */

  /** Inline, panel-scoped status message. `type` is success|warning|danger|info. */
  function showAlert(containerId, type, msg) {
    var el = document.getElementById(containerId);
    if (!el) return;
    var kind = (type === 'success' || type === 'warning' || type === 'danger' || type === 'info') ? type : 'info';
    el.innerHTML = '<div class="mb-alert mb-alert-' + kind + '" role="status">' + msg + '</div>';
  }

  /** Transient page-level toast — same shape as the one in mb-control-bar.js. */
  function sysToast(message, severity) {
    var region = document.querySelector('.mb-toast-region');
    if (!region) {
      region = document.createElement('div');
      region.className = 'mb-toast-region';
      region.setAttribute('role', 'status');
      region.setAttribute('aria-live', 'polite');
      document.body.appendChild(region);
    }
    var toast = document.createElement('div');
    toast.className = 'mb-toast mb-toast-' + (severity || 'info');
    toast.setAttribute('data-mb-toast', severity || 'info');
    toast.textContent = message == null ? '' : String(message);
    region.appendChild(toast);
    setTimeout(function () { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 5000);
    return toast;
  }

  /**
   * Promise<boolean> confirmation built from the design system.
   * opts: { title, message, target, details[], confirmLabel, cancelLabel, danger }
   * `target` is rendered on its own line, so the operator reads the NAME of the
   * thing they are about to take down before they agree to take it down.
   */
  function sysConfirm(opts) {
    var o = opts || {};
    return new Promise(function (resolve) {
      var host = document.createElement('div');
      host.setAttribute('data-mb-confirm', '');

      var backdrop = document.createElement('div');
      backdrop.className = 'mb-modal-backdrop';

      var modal = document.createElement('div');
      modal.className = 'mb-modal';
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');

      var dialog = document.createElement('div');
      dialog.className = 'mb-modal-dialog';

      var header = document.createElement('div');
      header.className = 'mb-modal-header';
      var titleEl = document.createElement('h3');
      titleEl.className = 'mb-modal-title';
      titleEl.textContent = o.title || 'Are you sure?';
      header.appendChild(titleEl);

      var body = document.createElement('div');
      body.className = 'mb-modal-body';
      if (o.message) {
        var msg = document.createElement('p');
        msg.className = 'mb-text-secondary sys-confirm-message';
        msg.textContent = o.message;
        body.appendChild(msg);
      }
      if (o.target) {
        var target = document.createElement('p');
        target.className = 'sys-confirm-target ' + (o.danger === false ? 'mb-text-primary' : 'mb-text-danger');
        target.setAttribute('data-mb-confirm-target', '');
        target.textContent = o.target;
        body.appendChild(target);
      }
      if (o.details && o.details.length) {
        var list = document.createElement('ul');
        list.className = 'mb-text-sm mb-text-muted sys-confirm-details';
        o.details.forEach(function (d) {
          var li = document.createElement('li');
          li.textContent = d;
          list.appendChild(li);
        });
        body.appendChild(list);
      }

      var footer = document.createElement('div');
      footer.className = 'mb-modal-footer';
      var cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.className = 'mb-btn mb-btn-secondary';
      cancel.setAttribute('data-mb-confirm-cancel', '');
      cancel.textContent = o.cancelLabel || 'Cancel';
      var ok = document.createElement('button');
      ok.type = 'button';
      ok.className = 'mb-btn ' + (o.danger === false ? 'mb-btn-primary' : 'mb-btn-danger');
      ok.setAttribute('data-mb-confirm-ok', '');
      ok.textContent = o.confirmLabel || 'Confirm';
      footer.appendChild(cancel);
      footer.appendChild(ok);

      dialog.appendChild(header);
      dialog.appendChild(body);
      dialog.appendChild(footer);
      modal.appendChild(dialog);
      host.appendChild(backdrop);
      host.appendChild(modal);
      document.body.appendChild(host);

      var previouslyFocused = document.activeElement;
      var settled = false;
      function close(result) {
        if (settled) return;
        settled = true;
        document.removeEventListener('keydown', onKey, true);
        if (host.parentNode) host.parentNode.removeChild(host);
        try { if (previouslyFocused && previouslyFocused.focus) previouslyFocused.focus(); } catch (e) { }
        resolve(result);
      }
      function onKey(e) { if (e.key === 'Escape') { e.preventDefault(); close(false); } }
      document.addEventListener('keydown', onKey, true);
      backdrop.addEventListener('click', function () { close(false); });
      modal.addEventListener('click', function (e) { if (e.target === modal) close(false); });
      cancel.addEventListener('click', function () { close(false); });
      ok.addEventListener('click', function () { close(true); });

      // Focus the safe choice, never the destructive one.
      setTimeout(function () { try { cancel.focus(); } catch (e) { } }, 0);
    });
  }

  /** Name of the node these power controls act on. Filled from /api/system/info. */
  var nodeName = 'this node';

  function formatUptime(seconds) {
    var d = Math.floor(seconds / 86400);
    var h = Math.floor((seconds % 86400) / 3600);
    var m = Math.floor((seconds % 3600) / 60);
    if (d > 0) return d + 'd ' + h + 'h ' + m + 'm';
    if (h > 0) return h + 'h ' + m + 'm';
    return m + 'm';
  }

  function apiGet(url, cb) {
    var xhr = new XMLHttpRequest();
    xhr.open('GET', url);
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.onload = function () {
      try { cb(null, JSON.parse(xhr.responseText)); } catch (e) { cb(e); }
    };
    xhr.onerror = function () { cb(new Error('Network error')); };
    xhr.send();
  }

  function apiPost(url, body, cb) {
    var xhr = new XMLHttpRequest();
    xhr.open('POST', url);
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.onload = function () {
      try { cb(null, JSON.parse(xhr.responseText)); } catch (e) { cb(e); }
    };
    xhr.onerror = function () { cb(new Error('Network error')); };
    xhr.send(JSON.stringify(body || {}));
  }

  function apiPut(url, body, cb) {
    var xhr = new XMLHttpRequest();
    xhr.open('PUT', url);
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.onload = function () {
      try { cb(null, JSON.parse(xhr.responseText)); } catch (e) { cb(e); }
    };
    xhr.onerror = function () { cb(new Error('Network error')); };
    xhr.send(JSON.stringify(body || {}));
  }

  function apiDelete(url, cb) {
    var xhr = new XMLHttpRequest();
    xhr.open('DELETE', url);
    xhr.setRequestHeader('Accept', 'application/json');
    xhr.onload = function () {
      try { cb(null, JSON.parse(xhr.responseText)); } catch (e) { cb(e); }
    };
    xhr.onerror = function () { cb(new Error('Network error')); };
    xhr.send();
  }

  /* ─── Gauge Drawing ────────────────────────────────────────────────────────── */
  /**
   * Canvas cannot reference a CSS variable, so the tokens are resolved to
   * concrete colours here. They used to be Bootstrap's --bs-* with hard-coded
   * hex fallbacks, which meant the gauges were the one part of this page the
   * three MonsterBox themes could not reach.
   */
  function token(name) {
    var cs = getComputedStyle(document.documentElement);
    var v = (cs.getPropertyValue(name) || '').trim();
    // Semantic tokens are aliases (--mb-primary: var(--mb-accent-poison)).
    // Browsers normally substitute these at computed-value time, but follow
    // the chain by hand rather than hand canvas an unpaintable "var(...)".
    var guard = 0;
    while (v.indexOf('var(') === 0 && guard++ < 5) {
      var inner = v.slice(4, v.indexOf(')')).trim();
      v = (cs.getPropertyValue(inner) || '').trim();
    }
    return v;
  }

  function drawGauge(canvasId, percent, color) {
    var canvas = document.getElementById(canvasId);
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var w = canvas.width, h = canvas.height;
    var cx = w / 2, cy = h / 2, r = (Math.min(w, h) / 2) - 8;
    var startAngle = 0.75 * Math.PI;
    var endAngle = 2.25 * Math.PI;
    var pct = Math.max(0, Math.min(100, percent || 0));
    var sweepAngle = startAngle + (pct / 100) * (endAngle - startAngle);

    ctx.clearRect(0, 0, w, h);

    // Background arc
    ctx.beginPath();
    ctx.arc(cx, cy, r, startAngle, endAngle);
    ctx.strokeStyle = token('--mb-bg-3');
    ctx.lineWidth = 8;
    ctx.lineCap = 'round';
    ctx.stroke();

    // Value arc
    if (pct > 0) {
      ctx.beginPath();
      ctx.arc(cx, cy, r, startAngle, sweepAngle);
      ctx.strokeStyle = color || token('--mb-primary');
      ctx.lineWidth = 8;
      ctx.lineCap = 'round';
      ctx.stroke();
    }
  }

  function gaugeColor(pct) {
    if (pct >= 90) return token('--mb-danger');
    if (pct >= 70) return token('--mb-warning');
    return token('--mb-success');
  }

  function tempColor(temp) {
    var t = parseFloat(temp);
    if (t >= 80) return token('--mb-danger');
    if (t >= 65) return token('--mb-warning');
    return token('--mb-success');
  }

  /* ─── Tab 1: Overview ──────────────────────────────────────────────────────── */
  function loadSystemInfo() {
    apiGet('/api/system/info', function (err, data) {
      if (err || !data || !data.success) return;
      if (data.version) $('#infoVersion').textContent = 'v' + data.version;
      $('#infoHostname').textContent = data.hostname || 'Unknown';
      // The power controls must say WHICH machine they take down. Until this
      // resolves they read "this node", never a name that might be wrong.
      if (data.hostname) {
        nodeName = data.hostname;
        var nodeNameEl = $('#sysNodeName');
        if (nodeNameEl) nodeNameEl.textContent = data.hostname;
        var rebootBtn = $('#btnReboot');
        if (rebootBtn) rebootBtn.title = 'Reboot ' + data.hostname + ' — it comes back on its own in 30-60 seconds';
        var shutdownBtn = $('#btnShutdown');
        if (shutdownBtn) shutdownBtn.title = 'Power off ' + data.hostname + ' — it will NOT come back without physical access';
      }
      $('#infoNode').textContent = data.nodeVersion || 'Unknown';
      $('#infoPlatform').textContent = data.platform || 'Unknown';
      $('#infoUptime').textContent = data.systemUptime ? formatUptime(data.systemUptime) : 'Unknown';
      $('#infoCpuModel').textContent = data.cpuModel || 'Unknown';
      $('#infoCpuCount').textContent = data.cpuCount || 'Unknown';
    });
  }

  function refreshGauges() {
    apiGet('/api/system/performance', function (err, data) {
      if (err || !data || !data.success) return;
      var p = data.performance;

      drawGauge('gaugeCpu', p.cpu, gaugeColor(p.cpu));
      $('#gaugeCpuText').textContent = p.cpu + '%';

      drawGauge('gaugeMem', p.memory, gaugeColor(p.memory));
      $('#gaugeMemText').textContent = p.memory + '%';

      var temp = p.temperature ? parseFloat(p.temperature) : 0;
      var tempPct = Math.min(100, (temp / 85) * 100);
      drawGauge('gaugeTemp', tempPct, tempColor(temp));
      $('#gaugeTempText').innerHTML = (p.temperature || '--') + '&deg;C';

      var disk = p.disk || 0;
      drawGauge('gaugeDisk', disk, gaugeColor(disk));
      $('#gaugeDiskText').textContent = disk + '%';

      var now = new Date();
      $('#gaugeTimestamp').textContent = 'Updated: ' + now.toLocaleTimeString();
    });
  }

  var gaugeInterval = null;
  function startGaugeRefresh() {
    refreshGauges();
    gaugeInterval = setInterval(refreshGauges, 5000);
  }
  function stopGaugeRefresh() {
    if (gaugeInterval) { clearInterval(gaugeInterval); gaugeInterval = null; }
  }

  /* ─── Tab 2: Performance History ───────────────────────────────────────────── */
  var currentPeriod = '24h';

  function drawPerfChart(data) {
    var canvas = document.getElementById('perfChart');
    if (!canvas || !data || data.length === 0) {
      if (canvas) {
        var ctx2 = canvas.getContext('2d');
        ctx2.clearRect(0, 0, canvas.width, canvas.height);
        ctx2.fillStyle = token('--mb-fg-muted');
        ctx2.font = '14px sans-serif';
        ctx2.textAlign = 'center';
        ctx2.fillText('No performance data available for this period.', canvas.width / 2, canvas.height / 2);
      }
      return;
    }

    var ctx = canvas.getContext('2d');
    var W = canvas.width = canvas.offsetWidth;
    var H = canvas.height = 280;
    var pad = { top: 20, right: 20, bottom: 30, left: 40 };
    var chartW = W - pad.left - pad.right;
    var chartH = H - pad.top - pad.bottom;

    ctx.clearRect(0, 0, W, H);

    // Read theme colors from the MonsterBox tokens, so the chart follows
    // whichever of the three themes is active.
    var gridColor = token('--mb-bg-3');
    var textColor = token('--mb-fg-secondary');
    var primaryC = token('--mb-info');
    var successC = token('--mb-success');
    var dangerC = token('--mb-danger');

    // Grid
    ctx.strokeStyle = gridColor;
    ctx.lineWidth = 0.5;
    for (var g = 0; g <= 4; g++) {
      var gy = pad.top + (chartH / 4) * g;
      ctx.beginPath();
      ctx.moveTo(pad.left, gy);
      ctx.lineTo(W - pad.right, gy);
      ctx.stroke();
      ctx.fillStyle = textColor;
      ctx.font = '10px sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText((100 - g * 25) + '%', pad.left - 5, gy + 4);
    }

    function drawLine(arr, color) {
      if (!arr || arr.length < 2) return;
      ctx.beginPath();
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      for (var i = 0; i < arr.length; i++) {
        var x = pad.left + (i / (arr.length - 1)) * chartW;
        var y = pad.top + (1 - arr[i] / 100) * chartH;
        if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }

    var cpuArr = [], memArr = [], tempArr = [];
    for (var j = 0; j < data.length; j++) {
      cpuArr.push(data[j].cpu || 0);
      memArr.push(data[j].memory || 0);
      var t = data[j].temperature ? (parseFloat(data[j].temperature) / 85) * 100 : 0;
      tempArr.push(Math.min(100, t));
    }

    drawLine(cpuArr, primaryC);
    drawLine(memArr, successC);
    drawLine(tempArr, dangerC);

    // Legend
    var legendItems = [
      { color: primaryC, label: 'CPU' },
      { color: successC, label: 'Memory' },
      { color: dangerC, label: 'Temperature' }
    ];
    var lx = pad.left + 10;
    for (var li = 0; li < legendItems.length; li++) {
      ctx.fillStyle = legendItems[li].color;
      ctx.fillRect(lx, pad.top + 5, 12, 3);
      ctx.fillStyle = textColor;
      ctx.font = '11px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(legendItems[li].label, lx + 16, pad.top + 10);
      lx += 80;
    }

    // Summary
    var sumCpu = 0, sumMem = 0, sumTemp = 0, tempCount = 0;
    for (var s = 0; s < data.length; s++) {
      sumCpu += data[s].cpu || 0;
      sumMem += data[s].memory || 0;
      if (data[s].temperature) { sumTemp += parseFloat(data[s].temperature); tempCount++; }
    }
    $('#perfAvgCpu').textContent = data.length ? (sumCpu / data.length).toFixed(1) : '--';
    $('#perfAvgMem').textContent = data.length ? (sumMem / data.length).toFixed(1) : '--';
    $('#perfAvgTemp').textContent = tempCount ? (sumTemp / tempCount).toFixed(1) : '--';
  }

  function loadPerfHistory(period) {
    currentPeriod = period || currentPeriod;
    apiGet('/api/system/performance/history?period=' + currentPeriod, function (err, data) {
      if (err || !data || !data.success) { drawPerfChart([]); return; }
      drawPerfChart(data.data || []);
    });
  }

  // Period buttons
  var periodBtns = $$('#performance .sys-period-btn');
  for (var pi = 0; pi < periodBtns.length; pi++) {
    periodBtns[pi].addEventListener('click', function () {
      for (var b = 0; b < periodBtns.length; b++) periodBtns[b].classList.remove('active');
      this.classList.add('active');
      loadPerfHistory(this.getAttribute('data-period'));
    });
  }

  /* ─── Tab 3: Logs ──────────────────────────────────────────────────────────── */
  var logAutoTimer = null;

  function loadLogs() {
    var source = $('#logSource').value;
    var lines = $('#logLines').value;

    if (source === 'console' || source === 'errors') {
      var src = (source === 'errors') ? 'stderr' : 'stdout';
      $('#logService').disabled = true;
      apiGet('/api/system/console?lines=' + lines + '&source=' + src, function (err, data) {
        if (err || !data) { $('#logOutput').textContent = 'Error loading console output'; return; }
        $('#logOutput').textContent = data.output || 'No output available';
        var el = $('#logOutput');
        el.scrollTop = el.scrollHeight;
      });
    } else {
      $('#logService').disabled = false;
      var service = $('#logService').value;
      apiGet('/api/system/logs?service=' + encodeURIComponent(service) + '&lines=' + lines, function (err, data) {
        if (err || !data) { $('#logOutput').textContent = 'Error loading logs'; return; }
        $('#logOutput').textContent = data.logs || 'No logs available';
        var el = $('#logOutput');
        el.scrollTop = el.scrollHeight;
      });
    }
  }

  $('#btnRefreshLogs').addEventListener('click', loadLogs);
  $('#logSource').addEventListener('change', loadLogs);
  $('#logService').addEventListener('change', loadLogs);
  $('#logLines').addEventListener('change', loadLogs);
  $('#logAutoRefresh').addEventListener('change', function () {
    if (this.checked) {
      loadLogs();
      logAutoTimer = setInterval(loadLogs, 5000);
    } else {
      if (logAutoTimer) { clearInterval(logAutoTimer); logAutoTimer = null; }
    }
  });

  /* ─── System Volume ──────────────────────────────────────────────────────── */
  function loadVolume() {
    apiGet('/api/system/volume', function (err, data) {
      if (err || !data || !data.success) return;
      var vol = Math.round((data.volume || 0) * 100);
      var slider = $('#systemVolumeSlider');
      var display = $('#systemVolumeDisplay');
      if (slider) slider.value = vol;
      if (display) display.textContent = vol + '%';
    });
  }

  (function() {
    var slider = $('#systemVolumeSlider');
    if (slider) {
      slider.addEventListener('input', function () {
        var display = $('#systemVolumeDisplay');
        if (display) display.textContent = this.value + '%';
      });
    }
    var btnSave = $('#btnSaveVolume');
    if (btnSave) {
      btnSave.addEventListener('click', function () {
        var vol = parseInt($('#systemVolumeSlider').value, 10);
        apiPut('/api/system/volume', { volume: vol }, function (err, data) {
          if (err || !data || !data.success) {
            showAlert('volumeMessage', 'danger', 'Failed: ' + ((data && data.error) || 'Unknown error'));
          } else {
            showAlert('volumeMessage', 'success', 'System volume set to ' + vol + '%');
          }
        });
      });
    }
  })();

  /* ─── Tab 4: Settings ──────────────────────────────────────────────────────── */
  function loadSettings() {
    loadVolume();
    apiGet('/api/system/settings', function (err, data) {
      if (err || !data || !data.success) return;
      var s = data.settings;

      // CPU Governor
      var govSelect = $('#cpuGovernor');
      govSelect.innerHTML = '';
      var avail = (s.cpu && s.cpu.availableGovernors) || [];
      for (var i = 0; i < avail.length; i++) {
        var opt = document.createElement('option');
        opt.value = avail[i];
        opt.textContent = avail[i];
        if (s.cpu && avail[i] === s.cpu.governor) opt.selected = true;
        govSelect.appendChild(opt);
      }
      if (avail.length === 0) {
        govSelect.innerHTML = '<option>N/A</option>';
      }
      $('#cpuGovernorCurrent').value = (s.cpu && s.cpu.governor) || 'unknown';

      // GPU
      $('#gpuMemory').textContent = (s.gpu && s.gpu.memory) || 'N/A';

      // Swap
      $('#swapTotal').textContent = (s.memory && s.memory.swapTotalMB) ? s.memory.swapTotalMB + ' MB' : 'N/A';
      $('#swapUsed').textContent = (s.memory && s.memory.swapUsedMB != null) ? s.memory.swapUsedMB + ' MB' : 'N/A';
    });

    // Startup tasks
    apiGet('/api/system/settings/startup', function (err, data) {
      if (err || !data || !data.success) return;
      var tasks = data.tasks || [];
      var html = '';
      for (var i = 0; i < tasks.length; i++) {
        html += '<label class="mb-switch sys-startup-row" title="Enable or disable this service at startup">' +
          '<input class="startup-toggle" type="checkbox" data-service="' + tasks[i].service + '"' +
          (tasks[i].enabled ? ' checked' : '') + '>' +
          '<span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>' +
          '<span class="mb-mono">' + tasks[i].service + '</span></label>';
      }
      $('#startupTasksList').innerHTML = html || '<p class="mb-text-muted">No startup tasks found</p>';

      // Bind toggle handlers
      var toggles = $$('.startup-toggle');
      for (var t = 0; t < toggles.length; t++) {
        toggles[t].addEventListener('change', function () {
          var svc = this.getAttribute('data-service');
          var en = this.checked;
          apiPut('/api/system/settings/startup', { service: svc, enabled: en }, function (err2, res) {
            if (err2 || !res || !res.success) {
              showAlert('systemAlerts', 'danger', 'Failed to update startup task');
            }
          });
        });
      }
    });
  }

  $('#btnSaveCpuGovernor').addEventListener('click', function () {
    var gov = $('#cpuGovernor').value;
    apiPut('/api/system/settings', { category: 'cpu', key: 'governor', value: gov }, function (err, data) {
      if (err || !data || !data.success) {
        showAlert('cpuMessage', 'danger', 'Failed: ' + ((data && data.error) || 'Unknown error'));
      } else {
        showAlert('cpuMessage', 'success', 'CPU governor set to ' + gov);
        $('#cpuGovernorCurrent').value = gov;
      }
    });
  });

  /* ─── Performance Presets ──────────────────────────────────────────────────── */
  function loadPresets() {
    apiGet('/api/system/presets', function (err, data) {
      if (err || !data || !data.success) return;
      var presets = data.presets || {};
      var html = '';
      var keys = Object.keys(presets);
      for (var i = 0; i < keys.length; i++) {
        var id = keys[i];
        var p = presets[id];
        var s = p.settings || {};
        html += '<div class="col-md-6 col-lg-4">' +
          '<div class="mb-card h-100 sys-preset-card">' +
          '<h6 class="mb-1">' + p.label + '</h6>' +
          '<p class="mb-text-sm mb-text-muted mb-2">' + p.description + '</p>' +
          '<ul class="list-unstyled mb-text-sm mb-2">' +
          '<li>Governor: <strong>' + s.governor + '</strong></li>' +
          '<li>GPU Mem: <strong>' + s.gpu_mem + ' MB</strong></li>' +
          '<li>ARM Freq: <strong>' + s.arm_freq + ' MHz</strong></li>' +
          '<li>I2C: <strong>' + (s.i2c_baudrate / 1000) + ' kHz</strong></li>' +
          '</ul>' +
          '<button title="Apply this system preset" class="mb-btn mb-btn-secondary mb-btn-sm mb-btn-block preset-apply-btn" data-preset="' + id + '">Apply</button>' +
          '</div></div>';
      }
      $('#presetsList').innerHTML = html || '<p class="mb-text-muted">No presets available</p>';

      var btns = $$('.preset-apply-btn');
      for (var b = 0; b < btns.length; b++) {
        btns[b].addEventListener('click', function () {
          var presetId = this.getAttribute('data-preset');
          var btn = this;
          btn.disabled = true;
          btn.setAttribute('data-busy', 'true');
          btn.textContent = 'Applying...';
          apiPost('/api/system/presets/apply', { presetId: presetId }, function (err2, res) {
            btn.disabled = false;
            btn.removeAttribute('data-busy');
            btn.textContent = 'Apply';
            if (err2 || !res || !res.success) {
              showAlert('presetMessage', 'danger', 'Failed: ' + ((res && res.error) || 'Unknown error'));
              return;
            }
            var msgs = [];
            var results = res.results || [];
            for (var r = 0; r < results.length; r++) {
              if (results[r].key === 'governor' && results[r].success) {
                msgs.push('CPU governor set to <strong>' + results[r].value + '</strong>');
              } else if (results[r].key === 'boot_config') {
                msgs.push('<span class="mb-text-warning">' + results[r].message + '</span>');
              } else if (!results[r].success) {
                msgs.push('<span class="mb-text-danger">' + results[r].key + ': ' + results[r].error + '</span>');
              }
            }
            showAlert('presetMessage', 'info', 'Preset <strong>' + (res.label || presetId) + '</strong> applied.<br>' + msgs.join('<br>'));
            loadSettings();
          });
        });
      }
    });
  }

  /* ─── Tab 5: SSH Keys ──────────────────────────────────────────────────────── */
  function loadSSHKeys() {
    apiGet('/api/system/ssh/keys', function (err, data) {
      if (err || !data || !data.success) return;
      var keys = data.keys || [];
      var tbody = $('#sshKeysBody');
      var deploySelect = $('#deployKeySelect');

      if (keys.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="mb-text-muted">No SSH keys found</td></tr>';
        deploySelect.innerHTML = '<option>-- no keys --</option>';
        return;
      }

      var html = '';
      var dhtml = '<option value="">-- select key --</option>';
      for (var i = 0; i < keys.length; i++) {
        var k = keys[i];
        var created = k.created ? new Date(k.created).toLocaleDateString() : '--';
        html += '<tr><td data-label="Name">' + k.name + '</td>' +
          '<td data-label="Fingerprint"><code class="mb-text-sm">' + (k.fingerprint || '--').substring(0, 47) + '</code></td>' +
          '<td data-label="Created">' + created + '</td>' +
          '<td data-label="Actions"><button title="Remove this SSH credential" aria-label="Delete SSH key ' + k.name + '" class="mb-btn mb-btn-secondary mb-btn-sm mb-btn-icon ssh-delete-btn" data-name="' + k.name + '"><i class="bi bi-trash"></i></button></td></tr>';
        dhtml += '<option value="' + k.name + '">' + k.name + '</option>';
      }
      tbody.innerHTML = html;
      deploySelect.innerHTML = dhtml;

      // Bind delete buttons
      var delBtns = $$('.ssh-delete-btn');
      for (var d = 0; d < delBtns.length; d++) {
        delBtns[d].addEventListener('click', function () {
          var name = this.getAttribute('data-name');
          sysConfirm({
            title: 'Delete SSH key?',
            message: 'This removes the key pair from this node. Any host that trusts only this key becomes unreachable from here.',
            target: name,
            confirmLabel: 'Delete key'
          }).then(function (ok) {
            if (!ok) return;
            apiDelete('/api/system/ssh/keys/' + encodeURIComponent(name), function (err2, res) {
              if (err2 || !res || !res.success) {
                showAlert('systemAlerts', 'danger', 'Failed to delete key');
              } else {
                sysToast('SSH key "' + name + '" deleted', 'success');
                loadSSHKeys();
              }
            });
          });
        });
      }
    });
  }

  $('#btnGenerateKey').addEventListener('click', function () {
    var type = $('#sshKeyType').value;
    var comment = $('#sshKeyComment').value;
    apiPost('/api/system/ssh/keys/generate', { type: type, comment: comment }, function (err, data) {
      if (err || !data || !data.success) {
        showAlert('sshGenMessage', 'danger', 'Failed: ' + ((data && data.error) || 'Unknown error'));
      } else {
        showAlert('sshGenMessage', 'success', 'Key generated: ' + data.name);
        loadSSHKeys();
      }
    });
  });

  $('#btnDeployKey').addEventListener('click', function () {
    var keyName = $('#deployKeySelect').value;
    var host = $('#deployHost').value;
    if (!keyName || !host) {
      showAlert('sshDeployMessage', 'warning', 'Select a key and enter a host');
      return;
    }
    apiPost('/api/system/ssh/keys/deploy', { keyName: keyName, host: host }, function (err, data) {
      if (err || !data || !data.success) {
        showAlert('sshDeployMessage', 'danger', 'Failed: ' + ((data && data.error) || 'Unknown error'));
      } else {
        showAlert('sshDeployMessage', 'success', 'Key deployed to ' + host);
      }
    });
  });

  /* ─── Tab 6: Templates ─────────────────────────────────────────────────────── */
  function loadTemplates() {
    apiGet('/api/system/templates', function (err, data) {
      if (err || !data || !data.success) return;
      var tpls = data.templates || [];
      var tbody = $('#templatesBody');

      if (tpls.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="mb-text-muted">No templates saved</td></tr>';
        return;
      }

      var html = '';
      for (var i = 0; i < tpls.length; i++) {
        var t = tpls[i];
        var created = t.created ? new Date(t.created).toLocaleDateString() : '--';
        html += '<tr><td data-label="Name">' + (t.name || 'Untitled') + '</td>' +
          '<td data-label="Description">' + (t.description || '--') + '</td>' +
          '<td data-label="Created">' + created + '</td>' +
          '<td data-label="Actions"><span class="mb-row-sm">' +
          '<button class="mb-btn mb-btn-secondary mb-btn-sm mb-btn-icon tpl-apply-btn" data-id="' + t.id + '" title="Apply this template" aria-label="Apply template"><i class="bi bi-play-circle"></i></button>' +
          '<button class="mb-btn mb-btn-secondary mb-btn-sm mb-btn-icon tpl-delete-btn" data-id="' + t.id + '" data-name="' + (t.name || 'Untitled') + '" title="Delete this template" aria-label="Delete template"><i class="bi bi-trash"></i></button>' +
          '</span></td></tr>';
      }
      tbody.innerHTML = html;

      // Bind
      var applyBtns = $$('.tpl-apply-btn');
      for (var a = 0; a < applyBtns.length; a++) {
        applyBtns[a].addEventListener('click', function () {
          var id = this.getAttribute('data-id');
          apiPost('/api/system/templates/' + id + '/apply', {}, function (err2, res) {
            if (err2 || !res || !res.success) {
              showAlert('systemAlerts', 'danger', 'Failed to apply template');
            } else {
              showAlert('systemAlerts', 'success', 'Template applied');
              loadSettings();
            }
          });
        });
      }

      var delBtns = $$('.tpl-delete-btn');
      for (var dd = 0; dd < delBtns.length; dd++) {
        delBtns[dd].addEventListener('click', function () {
          var id = this.getAttribute('data-id');
          var tplName = this.getAttribute('data-name') || 'Untitled';
          sysConfirm({
            title: 'Delete config template?',
            message: 'The saved configuration snapshot is removed. Settings already applied to this node are not changed.',
            target: tplName,
            confirmLabel: 'Delete template'
          }).then(function (ok) {
            if (!ok) return;
            apiDelete('/api/system/templates/' + id, function (err2, res) {
              if (err2 || !res || !res.success) {
                showAlert('systemAlerts', 'danger', 'Failed to delete template');
              } else {
                sysToast('Template "' + tplName + '" deleted', 'success');
                loadTemplates();
              }
            });
          });
        });
      }
    });
  }

  function saveTemplate() {
    var name = $('#tplName').value;
    var desc = ($('#tplDesc') && $('#tplDesc').value) || '';
    if (!name) { showAlert('tplMessage', 'warning', 'Name required'); return; }
    apiPost('/api/system/templates', { name: name, description: desc }, function (err, data) {
      if (err || !data || !data.success) {
        showAlert('tplMessage', 'danger', 'Failed: ' + ((data && data.error) || 'Unknown error'));
      } else {
        showAlert('tplMessage', 'success', 'Template saved');
        $('#tplName').value = '';
        $('#tplDesc').value = '';
        loadTemplates();
      }
    });
  }

  $('#btnSaveTemplate').addEventListener('click', saveTemplate);
  $('#btnSaveTemplateForm').addEventListener('click', saveTemplate);

  /* ─── Theme Gallery ─────────────────────────────────────────────────────── */
  // v8.1.1: retired Bootswatch picker. Three curated MonsterBox themes only.
  // Bootswatch files are still on disk for backwards compat — if someone has
  // a legacy theme in config, it still renders — they just can't select it.
  // A swatch has to show the theme it names, not the theme currently applied,
  // so these three cannot be --mb-* tokens. The literal colours live in
  // /css/setup-system.css as .sys-swatch-<theme>-<n> classes — one place, still
  // outside the markup, and they stay in step with tokens.css by name.
  var THEMES = [
    { name: 'haunted-console', label: 'Haunted Console', dark: true },
    { name: 'cold-crypt',      label: 'Cold Crypt',      dark: true },
    { name: 'bright-ops',      label: 'Bright Ops',      dark: false }
  ];

  var __rawCurrent = '<%= (typeof config !== "undefined" && config && config.theme) ? config.theme : "haunted-console" %>';
  var __legacyMap = {
    'dark':         'haunted-console',
    'default-dark': 'haunted-console',
    'light':        'bright-ops',
    'default-light':'bright-ops'
  };
  var currentTheme = __legacyMap[__rawCurrent] || __rawCurrent;
  // If the saved theme is a legacy Bootswatch name, fall through to default.
  var __validNames = THEMES.map(function (t) { return t.name; });
  if (__validNames.indexOf(currentTheme) === -1) currentTheme = 'haunted-console';
  var previewTheme = currentTheme;

  function buildThemeGallery() {
    var gallery = document.getElementById('themeGallery');
    if (!gallery) return;
    var html = '';
    for (var i = 0; i < THEMES.length; i++) {
      var t = THEMES[i];
      var isActive = (t.name === currentTheme);
      html += '<div class="col-6 col-md-4 col-lg-3">' +
        '<div class="mb-card mb-card-interactive theme-card sys-theme-card' + (isActive ? ' sys-theme-card-active' : '') +
        '" data-theme="' + t.name + '" role="button" tabindex="0" aria-pressed="' + (isActive ? 'true' : 'false') + '">' +
        '<div class="sys-swatches">' +
        '<span class="sys-swatch sys-swatch-' + t.name + '-1"></span>' +
        '<span class="sys-swatch sys-swatch-' + t.name + '-2"></span>' +
        '<span class="sys-swatch sys-swatch-' + t.name + '-3"></span>' +
        '</div>' +
        '<strong class="sys-theme-name">' + t.label + '</strong>' +
        '<span class="mb-badge sys-theme-kind">' + (t.dark ? 'Dark' : 'Light') + '</span>';
      if (isActive) {
        html += '<span class="mb-badge mb-badge-primary sys-theme-check" data-sys-current><i class="bi bi-check-lg"></i></span>';
      }
      html += '</div></div>';
    }
    gallery.innerHTML = html;

    // Bind click handlers
    var cards = gallery.querySelectorAll('.theme-card');
    for (var j = 0; j < cards.length; j++) {
      cards[j].addEventListener('click', function () {
        var name = this.getAttribute('data-theme');
        doPreviewTheme(name);
      });
      // The card is role="button"; a keyboard user must be able to fire it.
      cards[j].addEventListener('keydown', function (evt) {
        if (evt.key !== 'Enter' && evt.key !== ' ') return;
        evt.preventDefault();
        doPreviewTheme(this.getAttribute('data-theme'));
      });
    }
  }

  function doPreviewTheme(name) {
    previewTheme = name;
    var t = null;
    for (var i = 0; i < THEMES.length; i++) {
      if (THEMES[i].name === name) { t = THEMES[i]; break; }
    }
    if (!t) return;

    // Swap CSS link — curated themes all ride on the default Bootstrap core;
    // the MonsterBox tokens.css handles the palette via data-mb-theme.
    var bsLink = document.querySelector('link[href*="/vendor/bootswatch/"], link[href*="/vendor/bootstrap/bootstrap"]');
    if (bsLink) {
      bsLink.href = '/vendor/bootstrap/bootstrap.min.css';
    }

    // Set data attributes
    document.documentElement.setAttribute('data-bs-theme', t.dark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-mb-theme', name);

    // Update preview label
    var label = document.getElementById('themePreviewLabel');
    if (label) label.textContent = 'Previewing: ' + t.label;

    // Update card selection
    var cards = document.querySelectorAll('.theme-card');
    for (var j = 0; j < cards.length; j++) {
      var cardName = cards[j].getAttribute('data-theme');
      var selected = (cardName === name);
      cards[j].classList.toggle('sys-theme-card-active', selected);
      cards[j].setAttribute('aria-pressed', selected ? 'true' : 'false');
      // The check mark marks the SAVED theme, not the previewed one.
      var badge = cards[j].querySelector('[data-sys-current]');
      if (badge && cardName !== currentTheme) badge.remove();
    }
  }

  // Reset preview to currently saved theme
  var btnResetPreview = document.getElementById('btnResetPreview');
  if (btnResetPreview) {
    btnResetPreview.addEventListener('click', function () {
      doPreviewTheme(currentTheme);
    });
  }

  // Apply theme (save to server)
  var btnApplyTheme = document.getElementById('btnApplyTheme');
  if (btnApplyTheme) {
    btnApplyTheme.addEventListener('click', function () {
      apiPost('/api/config/theme', { theme: previewTheme }, function (err, data) {
        if (err || !data || !data.success) {
          showAlert('themeMessage', 'danger', '<i class="bi bi-exclamation-triangle"></i> Failed: ' + ((data && data.error) || 'Unknown error'));
        } else {
          showAlert('themeMessage', 'success', '<i class="bi bi-check-circle"></i> Theme saved! Reloading...');
          setTimeout(function () { window.location.reload(); }, 1000);
        }
      });
    });
  }

  buildThemeGallery();
  var initLabel = document.getElementById('themePreviewLabel');
  if (initLabel) {
    for (var ti = 0; ti < THEMES.length; ti++) {
      if (THEMES[ti].name === currentTheme) {
        initLabel.textContent = 'Current: ' + THEMES[ti].label;
        break;
      }
    }
  }

  /* ─── Service Restart / Optimize / Reboot / Shutdown ──────────────────────── */
  $('#btnRestartService').addEventListener('click', function () {
    var btn = $('#btnRestartService');
    sysConfirm({
      title: 'Restart the MonsterBox service?',
      message: 'The node stays powered on; only the MonsterBox process restarts. Anything currently playing stops, and this page reloads in about ten seconds.',
      target: nodeName,
      danger: false,
      confirmLabel: 'Restart service'
    }).then(function (ok) {
      if (!ok) return;
      btn.disabled = true;
      btn.setAttribute('data-busy', 'true');
      btn.innerHTML = '<span>Restarting…</span>';
      showAlert('systemAlerts', 'info', '<i class="bi bi-arrow-repeat"></i> Restarting MonsterBox service on <strong>' + nodeName + '</strong>…');
      apiPost('/api/system/restart-service', {}, function () {
        // Wait for service to come back up, then reload page
        setTimeout(function () {
          showAlert('systemAlerts', 'success', '<i class="bi bi-check-circle"></i> Service restarted. Reloading…');
          setTimeout(function () { window.location.reload(); }, 3000);
        }, 7000);
      });
    });
  });

  $('#btnOptimize').addEventListener('click', function () {
    var btn = $('#btnOptimize');
    sysConfirm({
      title: 'Run animatronic optimization?',
      message: 'Tunes this node for animatronic duty. It does not restart or power anything off.',
      target: nodeName,
      danger: false,
      confirmLabel: 'Run optimization',
      details: [
        'Disables unnecessary services (Samba, CUPS, Bluetooth, …)',
        'Applies performance tuning',
        'Caps log sizes',
        'A reboot afterwards is recommended, not required'
      ]
    }).then(function (ok) {
      if (!ok) return;
      btn.disabled = true;
      btn.setAttribute('data-busy', 'true');
      btn.innerHTML = '<span>Optimizing…</span>';
      showAlert('systemAlerts', 'info', '<i class="bi bi-lightning-charge"></i> Running optimization… this may take 1-2 minutes.');
      fetch('/api/system/optimize', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          btn.disabled = false;
          btn.removeAttribute('data-busy');
          btn.innerHTML = '<i class="bi bi-lightning-charge"></i> Optimize';
          if (data.success) {
            showAlert('systemAlerts', 'success', '<i class="bi bi-check-circle"></i> Optimization complete. A reboot is recommended.');
            sysConfirm({
              title: 'Reboot now?',
              message: 'Optimization is finished. Some of it only takes effect after a restart. This node goes away for 30-60 seconds and comes back on its own.',
              target: nodeName,
              confirmLabel: 'Reboot this node'
            }).then(function (rebootOk) {
              if (rebootOk) doReboot();
            });
          } else {
            showAlert('systemAlerts', 'danger', '<i class="bi bi-x-circle"></i> Optimization failed: ' + (data.error || 'Unknown error'));
          }
        })
        .catch(function (err) {
          btn.disabled = false;
          btn.removeAttribute('data-busy');
          btn.innerHTML = '<i class="bi bi-lightning-charge"></i> Optimize';
          showAlert('systemAlerts', 'danger', '<i class="bi bi-x-circle"></i> Optimization error: ' + err.message);
        });
    });
  });

  function doReboot() {
    showAlert('systemAlerts', 'warning', '<i class="bi bi-arrow-clockwise"></i> Rebooting <strong>' + nodeName + '</strong>… it should answer again in 30-60 seconds.');
    sysToast('Rebooting ' + nodeName + '…', 'warning');
    apiPost('/api/system/reboot', {}, function () { });
  }

  $('#btnReboot').addEventListener('click', function () {
    sysConfirm({
      title: 'Reboot this node?',
      message: 'Everything running on this node stops at once — scenes, audio, motion, any hand near a moving part. It powers itself back up without help.',
      target: nodeName,
      confirmLabel: 'Reboot ' + nodeName,
      details: [
        'Back online on its own in roughly 30-60 seconds',
        'Any scene or queue currently playing is cut off'
      ]
    }).then(function (ok) {
      if (ok) doReboot();
    });
  });

  $('#btnShutdown').addEventListener('click', function () {
    sysConfirm({
      title: 'Power off this node?',
      // The asymmetry that earns this its own warning: a reboot costs a minute
      // of waiting, a shutdown costs a trip to wherever the animatronic is
      // standing. Nothing on this screen — or any screen — can undo it.
      message: 'This is the one action here that no screen can undo. The Pi is headless and inside the animatronic: bringing it back means physically reaching it and cycling its power.',
      target: nodeName,
      confirmLabel: 'Power off ' + nodeName,
      details: [
        'The web interface, the fleet and SSH all go away with it',
        'It will NOT come back on its own — someone has to be there',
        'A reboot does everything a shutdown does, and returns by itself'
      ]
    }).then(function (ok) {
      if (!ok) return;
      showAlert('systemAlerts', 'danger', '<i class="bi bi-power"></i> Powering off <strong>' + nodeName + '</strong>. It will not return until its power is cycled by hand.');
      sysToast('Powering off ' + nodeName + ' — physical access required to restart', 'danger');
      apiPost('/api/system/shutdown', {}, function () { });
    });
  });

  /* ─── Resource Health Tab ──────────────────────────────────────────────────── */
  var resRefreshTimer = null;

  function loadResourceStatus() {
    apiGet('/api/resource/status', function (err, data) {
      if (err || !data || !data.success) return;
      var s = data.status;
      var el = function (id) { return document.getElementById(id); };
      if (el('resPid')) el('resPid').textContent = s.pid;
      if (el('resUptime')) el('resUptime').textContent = s.uptimeFormatted;
      if (el('resPriority')) el('resPriority').textContent = s.priority;
      if (el('resEnv')) el('resEnv').textContent = s.environment;
      if (el('resNodeVer')) el('resNodeVer').textContent = s.nodeVersion;
      if (el('resPlatform')) el('resPlatform').textContent = s.platform;
      if (el('resCpu1')) el('resCpu1').textContent = s.cpu.load1m;
      if (el('resCpu5')) el('resCpu5').textContent = s.cpu.load5m;
      if (el('resCpu15')) el('resCpu15').textContent = s.cpu.load15m;
      if (el('resCpuCores')) el('resCpuCores').textContent = s.cpu.cores;
    });

    apiGet('/api/resource/memory', function (err, data) {
      if (err || !data || !data.success) return;
      var m = data.memory;
      var el = function (id) { return document.getElementById(id); };
      if (el('resHeapUsed')) el('resHeapUsed').textContent = m.heapUsedMB + ' MB';
      if (el('resSysFree')) el('resSysFree').textContent = m.systemFreeMB + ' MB';
      if (el('resSysTotal')) el('resSysTotal').textContent = m.systemTotalMB + ' MB';
      var pct = Math.round(m.rssMB / (m.systemTotalMB || 1) * 100);
      var levelKind = m.level === 'critical' ? 'danger' : m.level === 'warning' ? 'warning' : 'success';
      var bar = el('resMemBar');
      if (bar) {
        bar.style.width = pct + '%';
        bar.className = 'mb-meter-fill sys-meter-' + levelKind;
      }
      var barText = el('resMemBarText');
      if (barText) barText.textContent = m.rssMB + ' MB';
      var badge = el('resMemLevel');
      if (badge) {
        badge.textContent = m.level;
        badge.className = 'mb-badge mb-badge-' + levelKind;
      }
    });

    apiGet('/api/resource/health', function (err, data) {
      var body = document.getElementById('resHealthBody');
      if (!body) return;
      if (!data || !data.success || !data.health) {
        body.innerHTML = '<p class="mb-text-muted mb-0">No health check data</p>';
        return;
      }
      var h = data.health;
      var html = '<p class="mb-2"><strong>Overall: </strong><span class="mb-badge mb-badge-' +
        (h.overallStatus === 'CRITICAL' ? 'danger' : h.overallStatus === 'WARNING' ? 'warning' : 'success') +
        '">' + h.overallStatus + '</span></p><dl class="row mb-0">';
      var checks = h.checks || {};
      for (var key in checks) {
        if (checks.hasOwnProperty(key)) {
          var c = checks[key];
          var icon = c.status === 'ok' ? '✓' : c.status === 'warning' ? '⚠' : '✗';
          html += '<dt class="col-sm-5">' + icon + ' ' + key + '</dt>';
          html += '<dd class="col-sm-7"><span class="mb-badge mb-badge-' +
            (c.status === 'ok' ? 'success' : c.status === 'warning' ? 'warning' : 'danger') +
            '">' + c.status + '</span>';
          if (c.error) html += ' <small class="mb-text-muted">' + c.error + '</small>';
          html += '</dd>';
        }
      }
      html += '</dl>';
      if (h.timestamp) html += '<small class="mb-text-muted">Last check: ' + new Date(h.timestamp).toLocaleString() + '</small>';
      body.innerHTML = html;
    });
  }

  function startResRefresh() {
    loadResourceStatus();
    if (resRefreshTimer) clearInterval(resRefreshTimer);
    resRefreshTimer = setInterval(loadResourceStatus, 30000);
  }

  function stopResRefresh() {
    if (resRefreshTimer) { clearInterval(resRefreshTimer); resRefreshTimer = null; }
  }

  /* ─── Movement Telemetry Tab ─────────────────────────────────────────────── */
  function loadMovementTelemetry() {
    var periodSel = document.getElementById('mvtPeriod');
    var period = periodSel ? periodSel.value : '3600000';

    apiGet('/api/movement/telemetry?period=' + period, function (err, data) {
      if (err || !data || !data.success) return;
      var t = data.telemetry || {};
      var el = function (id) { return document.getElementById(id); };
      if (el('mvtLatencyAvg')) el('mvtLatencyAvg').textContent = t.latency && t.latency.avg != null ? t.latency.avg.toFixed(1) + ' ms' : '—';
      if (el('mvtLatencyP95')) el('mvtLatencyP95').textContent = t.latency && t.latency.p95 != null ? t.latency.p95.toFixed(1) + ' ms' : '—';
      if (el('mvtCycleAvg')) el('mvtCycleAvg').textContent = t.cycleTime && t.cycleTime.avg != null ? t.cycleTime.avg.toFixed(0) + ' ms' : '—';
      if (el('mvtCmdRate')) el('mvtCmdRate').textContent = t.commandRate && t.commandRate.avg != null ? t.commandRate.avg.toFixed(1) : '—';
    });

    apiGet('/api/movement/claims', function (err, data) {
      var el = document.getElementById('mvtClaims');
      if (!el) return;
      if (!data || !data.success || !data.claims || Object.keys(data.claims).length === 0) {
        el.innerHTML = '<p class="mb-text-muted mb-0">No active claims</p>';
        return;
      }
      var html = '<table class="mb-table mb-table-stack"><thead><tr><th>Servo</th><th>Owner</th><th>Priority</th></tr></thead><tbody>';
      for (var partId in data.claims) {
        if (data.claims.hasOwnProperty(partId)) {
          var c = data.claims[partId];
          html += '<tr><td data-label="Servo">' + partId + '</td><td data-label="Owner">' + (c.owner || '—') +
            '</td><td data-label="Priority">' + (c.priority || '—') + '</td></tr>';
        }
      }
      html += '</tbody></table>';
      el.innerHTML = html;
    });

    apiGet('/api/movement/idle/status', function (err, data) {
      if (err || !data || !data.success) return;
      var s = data.status || {};
      var el = function (id) { return document.getElementById(id); };
      var statusBadge = el('mvtIdleStatus');
      if (statusBadge) {
        statusBadge.textContent = s.running ? 'Running' : 'Stopped';
        statusBadge.className = 'mb-badge' + (s.running ? ' mb-badge-success' : '');
      }
      if (el('mvtIdlePose')) el('mvtIdlePose').textContent = s.currentPoseId || '—';
      if (el('mvtIdleChar')) el('mvtIdleChar').textContent = s.characterId || '—';
    });
  }

  var mvtPeriodSel = document.getElementById('mvtPeriod');
  if (mvtPeriodSel) {
    mvtPeriodSel.addEventListener('change', loadMovementTelemetry);
  }

  /* ─── Tab change handler ───────────────────────────────────────────────────── */
  var tabEl = document.getElementById('systemTabs');
  if (tabEl) {
    tabEl.addEventListener('shown.bs.tab', function (ev) {
      var target = ev.target.getAttribute('data-bs-target');
      if (target === '#overview') { startGaugeRefresh(); }
      else { stopGaugeRefresh(); }
      if (target === '#performance') { loadPerfHistory(currentPeriod); }
      if (target === '#logs') { loadLogs(); }
      if (target === '#settings') { loadSettings(); loadPresets(); }
      if (target === '#ssh') { loadSSHKeys(); }
      if (target === '#templates') { loadTemplates(); }
      if (target === '#resource') { startResRefresh(); }
      else { stopResRefresh(); }
      if (target === '#movement') { loadMovementTelemetry(); }
    });
  }

  /* ─── Init ─────────────────────────────────────────────────────────────────── */
  loadSystemInfo();
  startGaugeRefresh();

})();
</script>
