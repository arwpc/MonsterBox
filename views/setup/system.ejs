      <div class="col-lg-6">
        <div class="mb-panel">
          <div class="mb-panel-header"><h5 class="mb-panel-title"><i class="bi bi-lock"></i> Active Servo Claims</h5></div>
          <div class="mb-panel-body" id="mvtClaims">
            <p class="mb-text-muted mb-0">No active claims</p>
