<!--
  Node actions.

  Reboot and Shutdown used to sit here as two more identical outline buttons
  next to Optimize and Restart Service: four uniform switches in the top-right
  of the page an operator opens to read a CPU temperature or change the theme.
  Two of those four take the machine away, and on a headless Pi sealed inside
  an animatronic, Shutdown cannot be undone from any screen.

  They are separated and weighted now. Recoverable maintenance on the left;
  power actions in their own danger-bordered group that names the node it is
  about to take down and says out loud what undoing it costs.
-->
<div class="sys-actions">
  <div class="sys-actions-maint" role="group" aria-label="Maintenance actions">
    <button class="mb-btn mb-btn-secondary mb-btn-sm" id="btnOptimize" title="Run animatronic optimization — disables bloat services, tunes performance">
      <i class="bi bi-lightning-charge"></i> Optimize
    </button>
    <button class="mb-btn mb-btn-secondary mb-btn-sm" id="btnRestartService" title="Restart the MonsterBox service without rebooting the node">
      <i class="bi bi-arrow-repeat"></i> Restart Service
    </button>
  </div>

  <div class="sys-power" role="group" aria-labelledby="sysPowerHeading">
    <div class="sys-power-head" id="sysPowerHeading">
      <i class="bi bi-exclamation-triangle-fill mb-text-danger" aria-hidden="true"></i>
      <span>Power &middot; <span id="sysNodeName" class="mb-mono">this node</span></span>
    </div>
    <div class="sys-power-actions">
      <button class="mb-btn mb-btn-danger sys-power-btn" id="btnReboot" title="Reboot this node — it comes back on its own in 30-60 seconds">
        <i class="bi bi-arrow-clockwise"></i> Reboot this node
      </button>
      <button class="mb-btn mb-btn-danger mb-btn-glow sys-power-btn sys-power-btn-off" id="btnShutdown" title="Power this node off — it will NOT come back without physical access">
        <i class="bi bi-power"></i> Shut down this node
      </button>
    </div>
    <p class="sys-power-note">
      <i class="bi bi-hand-index-thumb" aria-hidden="true"></i>
      Shutting down cannot be undone from here. Bringing this node back means reaching
      the Pi inside the animatronic and power-cycling it by hand.
    </p>
  </div>
</div>

<!-- Tab Navigation.
     Bootstrap's tab plugin still drives these (it needs data-bs-toggle and the
     .nav-link hook for keyboard navigation); .mb-tabs / .mb-tab give them the
     design system's appearance, and .mb-tab keys its selected state off
     aria-selected, which Bootstrap already sets. -->
<ul class="nav nav-tabs mb-tabs mb-3" id="systemTabs" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link mb-tab active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab" title="Show system overview">
      <i class="bi bi-speedometer2"></i> Overview
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link mb-tab" id="performance-tab" data-bs-toggle="tab" data-bs-target="#performance" type="button" role="tab" title="Show performance history">
      <i class="bi bi-graph-up"></i> Performance
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link mb-tab" id="logs-tab" data-bs-toggle="tab" data-bs-target="#logs" type="button" role="tab" title="Show system logs">
      <i class="bi bi-journal-text"></i> Logs
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link mb-tab" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab" title="Show system settings">
      <i class="bi bi-gear"></i> Settings
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link mb-tab" id="ssh-tab" data-bs-toggle="tab" data-bs-target="#ssh" type="button" role="tab" title="Show SSH keys">
      <i class="bi bi-key"></i> SSH Keys
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link mb-tab" id="templates-tab" data-bs-toggle="tab" data-bs-target="#templates" type="button" role="tab" title="Show config templates">
      <i class="bi bi-clipboard-data"></i> Templates
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link mb-tab" id="resource-tab" data-bs-toggle="tab" data-bs-target="#resource" type="button" role="tab" title="Show resource usage">
      <i class="bi bi-cpu"></i> Resources
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link mb-tab" id="movement-tab" data-bs-toggle="tab" data-bs-target="#movement" type="button" role="tab" title="Show movement telemetry">
      <i class="bi bi-activity"></i> Movement
    </button>
  </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="systemTabContent">

  <!-- ══════════════════ Tab 1: Overview ══════════════════ -->
  <div class="tab-pane fade show active" id="overview" role="tabpanel">
    <div class="row g-3">
      <!-- System Info Card -->
      <div class="col-lg-6">
        <div class="mb-panel h-100">
          <div class="mb-panel-header"><h5 class="mb-panel-title"><i class="bi bi-info-circle"></i> System Information</h5></div>
          <div class="mb-panel-body">
            <dl class="row mb-0">
              <dt class="col-sm-5">MonsterBox Version</dt>
              <dd class="col-sm-7"><span class="mb-badge mb-badge-primary" id="infoVersion"><%= typeof appVersion !== 'undefined' ? appVersion : 'loading...' %></span></dd>
              <dt class="col-sm-5">Hostname</dt>
              <dd class="col-sm-7" id="infoHostname">Loading...</dd>
              <dt class="col-sm-5">Node.js</dt>
              <dd class="col-sm-7" id="infoNode">Loading...</dd>
              <dt class="col-sm-5">Platform</dt>
              <dd class="col-sm-7" id="infoPlatform">Loading...</dd>
              <dt class="col-sm-5">System Uptime</dt>
              <dd class="col-sm-7" id="infoUptime">Loading...</dd>
              <dt class="col-sm-5">CPU Model</dt>
              <dd class="col-sm-7" id="infoCpuModel">Loading...</dd>
              <dt class="col-sm-5">CPU Cores</dt>
              <dd class="col-sm-7" id="infoCpuCount">Loading...</dd>
            </dl>
          </div>
        </div>
      </div>

      <!-- Live Gauges -->
      <div class="col-12">
        <div class="mb-panel">
          <div class="mb-panel-header">
            <h5 class="mb-panel-title"><i class="bi bi-speedometer"></i> Live Performance</h5>
            <small class="mb-text-muted mb-text-sm" id="gaugeTimestamp">--</small>
          </div>
          <div class="mb-panel-body">
            <div class="row text-center g-3">
              <div class="col-6 col-md-3">
                <h6 class="sys-gauge-label">CPU</h6>
                <div class="sys-gauge">
                  <canvas id="gaugeCpu" width="100" height="100"></canvas>
                  <span class="sys-gauge-value" id="gaugeCpuText">--%</span>
                </div>
              </div>
              <div class="col-6 col-md-3">
                <h6 class="sys-gauge-label">Memory</h6>
                <div class="sys-gauge">
                  <canvas id="gaugeMem" width="100" height="100"></canvas>
                  <span class="sys-gauge-value" id="gaugeMemText">--%</span>
                </div>
              </div>
              <div class="col-6 col-md-3">
                <h6 class="sys-gauge-label">Temperature</h6>
                <div class="sys-gauge">
                  <canvas id="gaugeTemp" width="100" height="100"></canvas>
                  <span class="sys-gauge-value" id="gaugeTempText">--&deg;C</span>
                </div>
              </div>
              <div class="col-6 col-md-3">
                <h6 class="sys-gauge-label">Disk</h6>
                <div class="sys-gauge">
                  <canvas id="gaugeDisk" width="100" height="100"></canvas>
                  <span class="sys-gauge-value" id="gaugeDiskText">--%</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Theme Gallery -->
      <div class="col-12">
        <div class="mb-panel">
          <div class="mb-panel-header">
            <h5 class="mb-panel-title"><i class="bi bi-palette"></i> Theme Settings</h5>
            <div class="mb-row-sm sys-theme-actions">
              <span class="mb-badge" id="themePreviewLabel">Previewing: --</span>
              <button type="button" class="mb-btn mb-btn-ghost mb-btn-sm" id="btnResetPreview" title="Reset theme preview">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
              </button>
              <button type="button" class="mb-btn mb-btn-primary mb-btn-sm" id="btnApplyTheme" title="Apply selected theme">
                <i class="bi bi-check-circle"></i> Apply Theme
              </button>
            </div>
          </div>
          <div class="mb-panel-body">
            <div id="themeMessage" class="mb-3"></div>
            <div class="row g-3" id="themeGallery"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════ Tab 2: Performance ══════════════════ -->
  <div class="tab-pane fade" id="performance" role="tabpanel">
    <div class="mb-panel">
      <div class="mb-panel-header">
        <h5 class="mb-panel-title"><i class="bi bi-graph-up"></i> Performance History</h5>
        <div class="mb-btn-group">
          <button class="mb-btn mb-btn-secondary mb-btn-sm sys-period-btn active" data-period="24h" title="Show last 24 hours">24 Hours</button>
          <button class="mb-btn mb-btn-secondary mb-btn-sm sys-period-btn" data-period="1w" title="Show last 1 week">1 Week</button>
          <button class="mb-btn mb-btn-secondary mb-btn-sm sys-period-btn" data-period="1m" title="Show last 1 month">1 Month</button>
        </div>
      </div>
      <div class="mb-panel-body">
        <div class="mb-3">
          <canvas id="perfChart" class="sys-chart" height="280"></canvas>
        </div>
        <div class="row text-center" id="perfSummary">
          <div class="col-4"><strong>Avg CPU:</strong> <span id="perfAvgCpu">--</span>%</div>
          <div class="col-4"><strong>Avg Memory:</strong> <span id="perfAvgMem">--</span>%</div>
          <div class="col-4"><strong>Avg Temp:</strong> <span id="perfAvgTemp">--</span>&deg;C</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════ Tab 3: Logs ══════════════════ -->
  <div class="tab-pane fade" id="logs" role="tabpanel">
    <div class="mb-panel">
      <div class="mb-panel-header sys-log-toolbar">
        <select class="mb-select mb-select-auto" id="logSource" title="Select log source">
          <option value="journal" selected>Journal (systemd)</option>
          <option value="console">Console Output (stdout)</option>
          <option value="errors">Error Output (stderr)</option>
        </select>
        <select class="mb-select mb-select-auto" id="logService" title="Select service for logs">
          <option value="monsterbox">monsterbox</option>
          <option value="mjpg-streamer">mjpg-streamer</option>
          <option value="pigpiod">pigpiod</option>
          <option value="pipewire">pipewire</option>
        </select>
        <select class="mb-select mb-select-auto" id="logLines" title="Select number of log lines">
          <option value="50">50 lines</option>
          <option value="100" selected>100 lines</option>
          <option value="200">200 lines</option>
          <option value="500">500 lines</option>
        </select>
        <button class="mb-btn mb-btn-primary mb-btn-sm" id="btnRefreshLogs" title="Refresh logs"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        <label class="mb-switch" for="logAutoRefresh" title="Toggle log auto-refresh">
          <input type="checkbox" id="logAutoRefresh">
          <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
          <span>Auto-refresh</span>
        </label>
      </div>
      <div class="mb-panel-body sys-log-body">
        <pre id="logOutput" class="sys-log-output">Loading logs...</pre>
      </div>
    </div>
  </div>

  <!-- ══════════════════ Tab 4: Settings ══════════════════ -->
  <div class="tab-pane fade" id="settings" role="tabpanel">
    <div class="accordion" id="settingsAccordion">
      <!-- System Volume -->
      <div class="accordion-item">
        <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#volumeSettings" title="Expand system volume settings"><i class="bi bi-volume-up me-2"></i>System Volume</button></h2>
        <div id="volumeSettings" class="accordion-collapse collapse show" data-bs-parent="#settingsAccordion">
          <div class="accordion-body">
            <div class="sys-volume-row">
              <i class="bi bi-volume-off fs-5" aria-hidden="true"></i>
              <input type="range" class="mb-range" id="systemVolumeSlider" min="0" max="100" step="1" value="90" title="Adjust system volume">
              <i class="bi bi-volume-up fs-5" aria-hidden="true"></i>
              <span class="mb-badge mb-badge-primary sys-volume-value" id="systemVolumeDisplay">90%</span>
              <button class="mb-btn mb-btn-primary" id="btnSaveVolume" title="Apply system volume"><i class="bi bi-check-circle"></i> Apply</button>
            </div>
            <div id="volumeMessage" class="mt-2"></div>
          </div>
        </div>
      </div>

      <!-- CPU Settings -->
      <div class="accordion-item">
        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cpuSettings" title="Expand CPU settings">CPU Settings</button></h2>
        <div id="cpuSettings" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
          <div class="accordion-body">
            <div class="row align-items-end g-3">
              <div class="col-md-6">
                <label class="mb-field-label" for="cpuGovernor">CPU Governor</label>
                <select class="mb-select" id="cpuGovernor" title="Select CPU governor"><option>Loading...</option></select>
              </div>
              <div class="col-md-3">
                <label class="mb-field-label" for="cpuGovernorCurrent">Current</label>
                <input type="text" class="mb-input mb-input-mono" id="cpuGovernorCurrent" readonly title="Current CPU governor">
              </div>
              <div class="col-md-3">
                <button class="mb-btn mb-btn-primary mb-btn-block" id="btnSaveCpuGovernor" title="Apply CPU governor"><i class="bi bi-check-circle"></i> Apply</button>
              </div>
            </div>
            <div id="cpuMessage" class="mt-2"></div>
          </div>
        </div>
      </div>

      <!-- GPU Settings -->
      <div class="accordion-item">
        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#gpuSettings" title="Expand GPU settings">GPU Settings</button></h2>
        <div id="gpuSettings" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
          <div class="accordion-body">
            <dl class="row mb-0">
              <dt class="col-sm-4">GPU Memory</dt>
              <dd class="col-sm-8" id="gpuMemory">Loading...</dd>
            </dl>
            <small class="mb-text-muted">GPU memory allocation is set in /boot/config.txt and requires a reboot to change.</small>
          </div>
        </div>
      </div>

      <!-- Memory Settings -->
      <div class="accordion-item">
        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#memSettings" title="Expand memory and swap settings">Memory &amp; Swap</button></h2>
        <div id="memSettings" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
          <div class="accordion-body">
            <dl class="row mb-0">
              <dt class="col-sm-4">Swap Total</dt>
              <dd class="col-sm-8" id="swapTotal">Loading...</dd>
              <dt class="col-sm-4">Swap Used</dt>
              <dd class="col-sm-8" id="swapUsed">Loading...</dd>
            </dl>
          </div>
        </div>
      </div>

      <!-- Startup Tasks -->
      <div class="accordion-item">
        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#startupSettings" title="Expand startup tasks">Startup Tasks</button></h2>
        <div id="startupSettings" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
          <div class="accordion-body" id="startupTasksList">
            <p class="mb-text-muted">Loading startup tasks...</p>
          </div>
        </div>
      </div>

      <!-- Performance Presets -->
      <div class="accordion-item">
        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#presetSettings" title="Expand performance presets">Performance Presets</button></h2>
        <div id="presetSettings" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
          <div class="accordion-body">
            <p class="mb-text-muted mb-3">Select a preset optimized for your Raspberry Pi model. CPU governor changes apply immediately. Boot config changes require manual editing of <code>/boot/firmware/config.txt</code> and a reboot.</p>
            <div id="presetsList" class="row g-2">
              <p class="mb-text-muted">Loading presets...</p>
            </div>
            <div id="presetMessage" class="mt-3"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════ Tab 5: SSH Keys ══════════════════ -->
  <div class="tab-pane fade" id="ssh" role="tabpanel">
    <div class="row g-3">
      <div class="col-lg-8">
        <div class="mb-panel">
          <div class="mb-panel-header"><h5 class="mb-panel-title"><i class="bi bi-key"></i> SSH Keys</h5></div>
          <div class="mb-panel-body mb-table-scroll">
            <table class="mb-table mb-table-stack" id="sshKeysTable">
              <thead><tr><th>Name</th><th>Fingerprint</th><th>Created</th><th>Actions</th></tr></thead>
              <tbody id="sshKeysBody"><tr><td colspan="4" class="mb-text-muted">Loading...</td></tr></tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="mb-panel mb-3">
          <div class="mb-panel-header"><h6 class="mb-panel-title">Generate New Key</h6></div>
          <div class="mb-panel-body">
            <div class="mb-field">
              <label class="mb-field-label" for="sshKeyType">Key Type</label>
              <select class="mb-select" id="sshKeyType" title="Select SSH key type">
                <option value="ed25519" selected>Ed25519 (Recommended)</option>
                <option value="rsa">RSA 4096</option>
              </select>
            </div>
            <div class="mb-field">
              <label class="mb-field-label" for="sshKeyComment">Comment</label>
              <input type="text" class="mb-input" id="sshKeyComment" placeholder="MonsterBox key" title="SSH key comment">
            </div>
            <button class="mb-btn mb-btn-primary mb-btn-block" id="btnGenerateKey" title="Generate new SSH key"><i class="bi bi-plus-circle"></i> Generate</button>
            <div id="sshGenMessage" class="mt-2"></div>
          </div>
        </div>
        <div class="mb-panel">
          <div class="mb-panel-header"><h6 class="mb-panel-title">Deploy to Host</h6></div>
          <div class="mb-panel-body">
            <div class="mb-field">
              <label class="mb-field-label" for="deployKeySelect">Key</label>
              <select class="mb-select" id="deployKeySelect" title="Select key to deploy"><option>-- select key --</option></select>
            </div>
            <div class="mb-field">
              <label class="mb-field-label" for="deployHost">Host</label>
              <input type="text" class="mb-input" id="deployHost" placeholder="user@host" title="Host to deploy key to">
            </div>
            <button class="mb-btn mb-btn-primary mb-btn-block" id="btnDeployKey" title="Deploy SSH key to host"><i class="bi bi-send"></i> Deploy</button>
            <div id="sshDeployMessage" class="mt-2"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════ Tab 6: Templates ══════════════════ -->
  <div class="tab-pane fade" id="templates" role="tabpanel">
    <div class="row g-3">
      <div class="col-lg-8">
        <div class="mb-panel">
          <div class="mb-panel-header">
            <h5 class="mb-panel-title"><i class="bi bi-clipboard-data"></i> Saved Templates</h5>
            <button class="mb-btn mb-btn-primary mb-btn-sm" id="btnSaveTemplate" title="Save current config as template"><i class="bi bi-plus-circle"></i> Save Current Config</button>
          </div>
          <div class="mb-panel-body mb-table-scroll">
            <table class="mb-table mb-table-stack">
              <thead><tr><th>Name</th><th>Description</th><th>Created</th><th>Actions</th></tr></thead>
              <tbody id="templatesBody"><tr><td colspan="4" class="mb-text-muted">Loading...</td></tr></tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="mb-panel">
          <div class="mb-panel-header"><h6 class="mb-panel-title">Save New Template</h6></div>
          <div class="mb-panel-body">
            <div class="mb-field">
              <label class="mb-field-label" for="tplName">Name</label>
              <input type="text" class="mb-input" id="tplName" placeholder="My Config" title="Template name">
            </div>
            <div class="mb-field">
              <label class="mb-field-label" for="tplDesc">Description</label>
              <textarea class="mb-textarea" id="tplDesc" rows="2" placeholder="Description..." title="Template description"></textarea>
            </div>
            <button class="mb-btn mb-btn-primary mb-btn-block" id="btnSaveTemplateForm" title="Save template"><i class="bi bi-save"></i> Save</button>
            <div id="tplMessage" class="mt-2"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════════════════ Tab: Resources ══════════════════ -->
  <div class="tab-pane fade" id="resource" role="tabpanel">
    <div class="row g-3">
      <div class="col-lg-6">
        <div class="mb-panel h-100">
          <div class="mb-panel-header"><h5 class="mb-panel-title"><i class="bi bi-cpu"></i> Process Info</h5></div>
          <div class="mb-panel-body">
            <dl class="row mb-0">
              <dt class="col-sm-5">PID</dt>
              <dd class="col-sm-7" id="resPid">—</dd>
              <dt class="col-sm-5">Uptime</dt>
              <dd class="col-sm-7" id="resUptime">—</dd>
              <dt class="col-sm-5">Process Priority</dt>
              <dd class="col-sm-7" id="resPriority">—</dd>
              <dt class="col-sm-5">Environment</dt>
              <dd class="col-sm-7"><span class="mb-badge mb-badge-info" id="resEnv">—</span></dd>
              <dt class="col-sm-5">Node.js</dt>
              <dd class="col-sm-7" id="resNodeVer">—</dd>
              <dt class="col-sm-5">Platform</dt>
              <dd class="col-sm-7" id="resPlatform">—</dd>
            </dl>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="mb-panel h-100">
          <div class="mb-panel-header"><h5 class="mb-panel-title"><i class="bi bi-memory"></i> Memory</h5></div>
          <div class="mb-panel-body">
            <div class="mb-2">
              <span class="mb-field-label">Process RSS</span>
              <div class="mb-meter mb-meter-lg">
                <div class="mb-meter-fill" id="resMemBar" role="progressbar"></div>
              </div>
              <span class="mb-text-sm mb-mono" id="resMemBarText">0 MB</span>
            </div>
            <dl class="row mb-0 mt-3">
              <dt class="col-sm-5">Heap Used</dt>
              <dd class="col-sm-7" id="resHeapUsed">—</dd>
              <dt class="col-sm-5">System Free</dt>
              <dd class="col-sm-7" id="resSysFree">—</dd>
              <dt class="col-sm-5">System Total</dt>
              <dd class="col-sm-7" id="resSysTotal">—</dd>
              <dt class="col-sm-5">Status</dt>
              <dd class="col-sm-7"><span class="mb-badge" id="resMemLevel">—</span></dd>
            </dl>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="mb-panel">
          <div class="mb-panel-header"><h5 class="mb-panel-title"><i class="bi bi-bar-chart"></i> CPU Load</h5></div>
          <div class="mb-panel-body">
            <dl class="row mb-0">
              <dt class="col-sm-5">1-min avg</dt>
              <dd class="col-sm-7" id="resCpu1">—</dd>
              <dt class="col-sm-5">5-min avg</dt>
              <dd class="col-sm-7" id="resCpu5">—</dd>
              <dt class="col-sm-5">15-min avg</dt>
              <dd class="col-sm-7" id="resCpu15">—</dd>
              <dt class="col-sm-5">CPU Cores</dt>
              <dd class="col-sm-7" id="resCpuCores">—</dd>
