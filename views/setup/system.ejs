  <!-- ══════════════════ Tab: Movement ══════════════════ -->
  <div class="tab-pane fade" id="movement" role="tabpanel">
    <div class="row g-3">
      <div class="col-lg-6">
        <div class="mb-panel h-100">
          <div class="mb-panel-header">
            <h5 class="mb-panel-title"><i class="bi bi-activity"></i> Movement Telemetry</h5>
            <select class="mb-select mb-select-auto" id="mvtPeriod" title="Select telemetry time period">
              <option value="3600000">1 Hour</option>
              <option value="21600000">6 Hours</option>
              <option value="86400000">24 Hours</option>
              <option value="604800000">7 Days</option>
              <option value="2592000000">30 Days</option>
            </select>
          </div>
          <div class="mb-panel-body">
            <dl class="row mb-0">
              <dt class="col-sm-6">Servo Latency (avg)</dt>
              <dd class="col-sm-6" id="mvtLatencyAvg">—</dd>
              <dt class="col-sm-6">Servo Latency (p95)</dt>
              <dd class="col-sm-6" id="mvtLatencyP95">—</dd>
              <dt class="col-sm-6">Cycle Time (avg)</dt>
              <dd class="col-sm-6" id="mvtCycleAvg">—</dd>
              <dt class="col-sm-6">Commands/sec (avg)</dt>
              <dd class="col-sm-6" id="mvtCmdRate">—</dd>
