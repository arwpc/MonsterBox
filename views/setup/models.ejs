<div class="mdl-toolbar">
  <a class="mb-btn mb-btn-secondary mb-btn-sm" href="/setup/calibration" title="Back to Calibration">
    <i class="bi bi-arrow-left"></i> Back to Calibration
  </a>
</div>

  <div class="row g-3">
    <!-- Left Panel: Type + Editor -->
    <div class="col-lg-4">
      <!-- Type Selector -->
      <div class="mb-panel mb-3">
        <div class="mb-panel-header"><h2 class="mb-panel-title"><i class="bi bi-funnel"></i> Part Type</h2></div>
        <div class="mb-panel-body">
          <select id="typeSelect" class="mb-select" title="Select part type">
            <option value="servo">Servo</option>
            <option value="linear_actuator">Linear Actuator</option>
            <option value="motor">Motor (DC)</option>
            <option value="stepper">Stepper Motor</option>
            <option value="led">LED</option>
            <option value="light">Light</option>
            <option value="sensor">Sensor</option>
            <option value="motion_sensor">Motion Sensor</option>
            <option value="microphone">Microphone</option>
            <option value="speaker">Speaker</option>
            <option value="webcam">WebCam</option>
            <option value="head_tracking">Head Tracking</option>
          </select>
        </div>
      </div>

      <!-- Model Editor -->
      <div class="mb-panel">
        <div class="mb-panel-header" id="editorHeader">
          <h2 class="mb-panel-title"><i class="bi bi-pencil-square"></i> <span id="editorTitle">Create New Model</span></h2>
        </div>
        <div class="mb-panel-body">
          <input type="hidden" id="modelId" />
          <div class="mb-field">
            <label class="mb-field-label" for="modelName">Name <span class="mb-text-danger">*</span></label>
            <input id="modelName" class="mb-input" placeholder="e.g., MG90S Micro Servo" title="Model name" />
          </div>
          <div class="mb-field">
            <label class="mb-field-label" for="modelDesc">Description</label>
            <input id="modelDesc" class="mb-input" placeholder="Optional description" title="Model description" />
          </div>

          <hr />
          <h3 class="mb-eyebrow"><i class="bi bi-sliders"></i> Default Settings</h3>
          <div id="defaultsFieldsArea" class="row g-2 mb-3">
            <!-- Dynamic fields rendered by JS -->
          </div>

          <div class="mb-2">
            <a class="mb-btn mb-btn-link mb-btn-sm" data-bs-toggle="collapse" href="#rawDefaultsCollapse" role="button" title="Toggle raw JSON editor">
              <i class="bi bi-code-slash"></i> Raw JSON (advanced)
            </a>
            <div class="collapse" id="rawDefaultsCollapse">
              <textarea id="modelDefaults" rows="5" class="mb-textarea mdl-json mt-1"
                placeholder='{"key": "value"}' title="Raw JSON defaults"></textarea>
            </div>
          </div>

          <div class="mb-stack mt-3">
            <button class="mb-btn mb-btn-primary mb-btn-block" id="btnSaveModel" title="Save model"><i class="bi bi-save"></i> Save Model</button>
            <div class="mdl-editor-actions">
              <button class="mb-btn mb-btn-secondary" id="btnNewModel" title="Create new model"><i class="bi bi-plus"></i> New</button>
              <button class="mb-btn mb-btn-danger" id="btnDeleteModel" disabled title="Delete model"><i class="bi bi-trash"></i> Delete</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel: Models List -->
    <div class="col-lg-8">
      <div class="mb-panel">
        <div class="mb-panel-header">
          <h2 class="mb-panel-title"><i class="bi bi-list-ul"></i> <span id="listTitle">Servo</span> Models</h2>
          <div class="mb-row-sm">
            <!-- Hidden until something is selected. The handler writes
                 style.display directly, which outranks this class either way. -->
            <button class="mb-btn mb-btn-danger mb-btn-sm mdl-hidden" id="btnDeleteSelected" title="Delete selected models">
              <i class="bi bi-trash"></i> Delete Selected (<span id="selectedCount">0</span>)
            </button>
            <button class="mb-btn mb-btn-secondary mb-btn-sm" id="btnRefresh" title="Refresh models list">
              <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
          </div>
        </div>
        <div class="mb-panel-body mdl-table-body mb-table-scroll">
          <table class="mb-table mb-table-stack" id="modelsTable">
            <thead>
              <tr>
                <th class="mdl-col-check"><label class="mb-check"><input type="checkbox" id="selectAll" title="Select All"><span class="visually-hidden">Select all models</span></label></th>
                <th>Name</th>
                <th>Description</th>
                <th>Key Settings</th>
                <th class="mdl-col-actions">Actions</th>
              </tr>
            </thead>
            <tbody>
              <tr><td colspan="5" class="text-center mb-text-muted py-3">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Apply Model to Parts -->
      <div class="mb-panel mt-3">
        <div class="mb-panel-header"><h2 class="mb-panel-title"><i class="bi bi-link-45deg"></i> Apply Model to Parts</h2></div>
        <div class="mb-panel-body">
          <div class="row g-3 align-items-end">
            <div class="col-md-5">
              <label class="mb-field-label" for="partsSelect">Parts of this type</label>
              <select multiple id="partsSelect" class="mb-select mdl-parts-select" size="5" title="Select parts to apply model"></select>
            </div>
            <div class="col-md-4">
              <label class="mb-field-label" for="applyModelId">Selected Model</label>
              <input id="applyModelId" class="mb-input mb-input-mono" placeholder="Click a model row" readonly title="Selected model to apply" />
            </div>
            <div class="col-md-3">
              <div class="mb-stack-sm">
                <button id="btnApplyModel" class="mb-btn mb-btn-primary mb-btn-block" title="Assign model to selected parts"><i class="bi bi-link"></i> Assign Model</button>
                <button id="btnPushDefaults" class="mb-btn mb-btn-secondary mb-btn-block"
                  title="Merge model defaults into each part's config"><i class="bi bi-box-arrow-in-down"></i> Push Defaults</button>
              </div>
            </div>
          </div>
          <div id="applyStatus" class="mt-2 mb-text-sm mb-text-muted" role="status" aria-live="polite"></div>
        </div>
      </div>
    </div>
  </div>

<script>
(function () {
  /* ─── Feedback primitives ────────────────────────────────────────────
     This page used to report every outcome through the browser's own
     blocking dialogs — a dozen of them. They cannot be themed, they are
     miserable on a phone, and for a destructive action they cannot show
     WHICH model is about to be erased. Replaced with the design system's
     toast (for outcomes) and modal (for destructive choices).
     ──────────────────────────────────────────────────────────────────── */
  function toast(message, severity) {
    var region = document.querySelector('.mb-toast-region');
    if (!region) {
      region = document.createElement('div');
      region.className = 'mb-toast-region';
      region.setAttribute('role', 'status');
      region.setAttribute('aria-live', 'polite');
      document.body.appendChild(region);
    }
    var el = document.createElement('div');
    el.className = 'mb-toast mb-toast-' + (severity || 'info');
    el.setAttribute('data-mb-toast', severity || 'info');
    el.textContent = message == null ? '' : String(message);
    region.appendChild(el);
    setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 5000);
    return el;
  }

  /**
   * Promise<boolean> confirmation built from the design system.
   * opts: { title, message, target, details[], confirmLabel, cancelLabel }
   * `target` names the thing about to be destroyed, on its own line.
   */
  function mdlConfirm(opts) {
    var o = opts || {};
    return new Promise(function (resolve) {
      var host = document.createElement('div');
      host.setAttribute('data-mb-confirm', '');

      var backdrop = document.createElement('div');
      backdrop.className = 'mb-modal-backdrop';

      var modal = document.createElement('div');
      modal.className = 'mb-modal';
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');

      var dialog = document.createElement('div');
      dialog.className = 'mb-modal-dialog';

      var header = document.createElement('div');
      header.className = 'mb-modal-header';
      var titleEl = document.createElement('h3');
      titleEl.className = 'mb-modal-title';
      titleEl.textContent = o.title || 'Are you sure?';
      header.appendChild(titleEl);

      var body = document.createElement('div');
      body.className = 'mb-modal-body';
      if (o.message) {
        var msg = document.createElement('p');
        msg.className = 'mb-text-secondary mdl-confirm-message';
        msg.textContent = o.message;
        body.appendChild(msg);
      }
      if (o.target) {
        var target = document.createElement('p');
        target.className = 'mdl-confirm-target mb-text-danger';
        target.setAttribute('data-mb-confirm-target', '');
        target.textContent = o.target;
        body.appendChild(target);
      }
      if (o.details && o.details.length) {
        var list = document.createElement('ul');
        list.className = 'mb-text-sm mb-text-muted mdl-confirm-details';
        o.details.forEach(function (d) {
          var li = document.createElement('li');
          li.textContent = d;
          list.appendChild(li);
        });
        body.appendChild(list);
      }

      var footer = document.createElement('div');
      footer.className = 'mb-modal-footer';
      var cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.className = 'mb-btn mb-btn-secondary';
      cancel.setAttribute('data-mb-confirm-cancel', '');
      cancel.textContent = o.cancelLabel || 'Cancel';
      var ok = document.createElement('button');
      ok.type = 'button';
      ok.className = 'mb-btn mb-btn-danger';
      ok.setAttribute('data-mb-confirm-ok', '');
      ok.textContent = o.confirmLabel || 'Delete';
      footer.appendChild(cancel);
      footer.appendChild(ok);

      dialog.appendChild(header);
      dialog.appendChild(body);
      dialog.appendChild(footer);
      modal.appendChild(dialog);
      host.appendChild(backdrop);
      host.appendChild(modal);
      document.body.appendChild(host);

      var previouslyFocused = document.activeElement;
      var settled = false;
      function close(result) {
        if (settled) return;
        settled = true;
        document.removeEventListener('keydown', onKey, true);
        if (host.parentNode) host.parentNode.removeChild(host);
        try { if (previouslyFocused && previouslyFocused.focus) previouslyFocused.focus(); } catch (e) { }
        resolve(result);
      }
      function onKey(e) { if (e.key === 'Escape') { e.preventDefault(); close(false); } }
      document.addEventListener('keydown', onKey, true);
      backdrop.addEventListener('click', function () { close(false); });
      modal.addEventListener('click', function (e) { if (e.target === modal) close(false); });
      cancel.addEventListener('click', function () { close(false); });
      ok.addEventListener('click', function () { close(true); });

      // Focus the safe choice, never the destructive one.
      setTimeout(function () { try { cancel.focus(); } catch (e) { } }, 0);
    });
  }

  // ─── Field schemas per model type ────────────────────────────────────
  const MODEL_FIELDS = {
    servo: [
      { key: 'minPulse', label: 'Min Pulse (µs)', type: 'number', placeholder: '500' },
      { key: 'maxPulse', label: 'Max Pulse (µs)', type: 'number', placeholder: '2500' },
      { key: 'neutralPulse', label: 'Neutral Pulse (µs)', type: 'number', placeholder: '1500' },
      { key: 'rotationRangeDeg', label: 'Rotation Range (°)', type: 'number', placeholder: '180' },
      { key: 'servoType', label: 'Servo Type', type: 'select', options: ['standard', 'continuous', 'multi-turn', 'feedback'] },
    ],
    linear_actuator: [
      { key: 'speedMaxPct', label: 'Max Speed (%)', type: 'number', placeholder: '100' },
      { key: 'strokeMs', label: 'Stroke Time (ms)', type: 'number', placeholder: '2000' },
      { key: 'maxExtension', label: 'Max Extension (ms)', type: 'number', placeholder: '15000' },
      { key: 'maxRetraction', label: 'Max Retraction (ms)', type: 'number', placeholder: '15000' },
      { key: 'controlBoard', label: 'Control Board', type: 'select', options: ['MDD10A', 'BTS7960', 'L298N'] },
    ],
    motor: [
      { key: 'motorType', label: 'Motor Type', type: 'select', options: ['dc'] },
      { key: 'voltage', label: 'Voltage (V)', type: 'number', placeholder: '12' },
      { key: 'maxDutyPct', label: 'Max Duty (%)', type: 'number', placeholder: '100' },
      { key: 'recommendedDriver', label: 'Recommended Drivers', type: 'text', placeholder: 'MDD10A, BTS7960' },
    ],
    stepper: [
      { key: 'motorType', label: 'Motor Type', type: 'select', options: ['stepper'] },
      { key: 'stepsPerRevolution', label: 'Steps/Rev', type: 'number', placeholder: '200' },
      { key: 'stepAngleDeg', label: 'Step Angle (°)', type: 'number', placeholder: '1.8', step: 0.1 },
      { key: 'ratedCurrentA', label: 'Rated Current (A)', type: 'number', placeholder: '2', step: 0.1 },
      { key: 'holdingTorqueNcm', label: 'Holding Torque (Ncm)', type: 'number', placeholder: '59' },
      { key: 'phaseResistanceOhm', label: 'Phase Resistance (Ω)', type: 'number', placeholder: '1.4', step: 0.1 },
      { key: 'phaseInductancemH', label: 'Phase Inductance (mH)', type: 'number', placeholder: '3', step: 0.1 },
    ],
    led: [
      { key: 'brightness', label: 'Brightness (%)', type: 'number', placeholder: '50' },
      { key: 'pwmFrequency', label: 'PWM Frequency (Hz)', type: 'number', placeholder: '1000' },
      { key: 'maxCurrentMa', label: 'Max Current (mA)', type: 'number', placeholder: '20' },
      { key: 'forwardVoltageV', label: 'Forward Voltage (V)', type: 'number', placeholder: '2', step: 0.1 },
    ],
    light: [
      { key: 'brightness', label: 'Brightness (%)', type: 'number', placeholder: '100' },
    ],
    sensor: [
      { key: 'sensitivity', label: 'Sensitivity (%)', type: 'number', placeholder: '50' },
      { key: 'retriggerMs', label: 'Retrigger Delay (ms)', type: 'number', placeholder: '5000' },
    ],
    motion_sensor: [
      { key: 'sensitivity', label: 'Sensitivity (%)', type: 'number', placeholder: '50' },
      { key: 'retriggerMs', label: 'Retrigger Delay (ms)', type: 'number', placeholder: '5000' },
    ],
    microphone: [
      { key: 'sampleRate', label: 'Sample Rate (Hz)', type: 'number', placeholder: '16000' },
      { key: 'channels', label: 'Channels', type: 'number', placeholder: '1' },
      { key: 'format', label: 'Format', type: 'text', placeholder: 's16le' },
    ],
    speaker: [
      { key: 'outputDevice', label: 'Output Device', type: 'text', placeholder: 'default' },
      { key: 'volume', label: 'Volume (%)', type: 'number', placeholder: '80' },
      { key: 'format', label: 'Audio Format', type: 'select', options: ['mp3', 'wav', 'ogg'] },
    ],
    webcam: [
      { key: 'resolution', label: 'Resolution', type: 'select', options: ['320x240', '640x480', '1280x720', '1920x1080'] },
      { key: 'fps', label: 'FPS', type: 'number', placeholder: '30' },
      { key: 'quality', label: 'Quality (%)', type: 'number', placeholder: '85' },
    ],
    head_tracking: [
      { key: 'trackingMode', label: 'Tracking Mode', type: 'select', options: ['face', 'motion', 'color'] },
      { key: 'smoothing', label: 'Smoothing (0-1)', type: 'number', placeholder: '0.5', step: 0.1 },
    ],
  };

  // ─── Type display names ──────────────────────────────────────────────
  const TYPE_LABELS = {
    servo: 'Servo', linear_actuator: 'Linear Actuator', motor: 'Motor (DC)',
    stepper: 'Stepper Motor', led: 'LED', light: 'Light', sensor: 'Sensor',
    motion_sensor: 'Motion Sensor', microphone: 'Microphone', speaker: 'Speaker',
    webcam: 'WebCam', head_tracking: 'Head Tracking'
  };

  // ─── DOM refs ────────────────────────────────────────────────────────
  var typeSelect = document.getElementById('typeSelect');
  var listTitle = document.getElementById('listTitle');
  var editorTitle = document.getElementById('editorTitle');
  var btnDeleteSelected = document.getElementById('btnDeleteSelected');
  var selectAllCheckbox = document.getElementById('selectAll');
  var selectedCountSpan = document.getElementById('selectedCount');
  var tableBody = document.querySelector('#modelsTable tbody');
  var partsSelect = document.getElementById('partsSelect');
  var applyModelId = document.getElementById('applyModelId');
  var selectedModels = new Set();
  var defaultsFieldsArea = document.getElementById('defaultsFieldsArea');

  // ─── Render default fields for current type ──────────────────────────
  function renderDefaultFields(type, values) {
    var fields = MODEL_FIELDS[type] || [];
    var vals = values || {};
    var html = '';
    fields.forEach(function (f) {
      var val = vals[f.key] !== undefined ? vals[f.key] : '';
      // Handle arrays (like recommendedDriver)
      if (Array.isArray(val)) val = val.join(', ');
      var fieldId = 'defaults-field-' + f.key;
      if (f.type === 'select') {
        html += '<div class="col-md-6"><label class="mb-field-label" for="' + fieldId + '">' + f.label + '</label>' +
          '<select id="' + fieldId + '" title="Select the default value for this field" class="mb-select defaults-field" data-key="' + f.key + '">' +
          '<option value="">—</option>';
        (f.options || []).forEach(function (o) {
          html += '<option value="' + o + '"' + (String(val) === o ? ' selected' : '') + '>' + o + '</option>';
        });
        html += '</select></div>';
      } else if (f.type === 'number') {
        html += '<div class="col-md-6"><label class="mb-field-label" for="' + fieldId + '">' + f.label + '</label>' +
          '<input id="' + fieldId + '" type="number" class="mb-input defaults-field" title="Default value for ' + f.label + '" data-key="' + f.key + '"' +
          ' value="' + val + '" placeholder="' + (f.placeholder || '') + '"' +
          (f.step ? ' step="' + f.step + '"' : '') + '></div>';
      } else {
        html += '<div class="col-md-6"><label class="mb-field-label" for="' + fieldId + '">' + f.label + '</label>' +
          '<input id="' + fieldId + '" type="text" class="mb-input defaults-field" title="Default value for ' + f.label + '" data-key="' + f.key + '"' +
          ' value="' + val + '" placeholder="' + (f.placeholder || '') + '"></div>';
      }
    });
    if (!html) html = '<div class="mb-text-muted mb-text-sm col-12">No configurable defaults for this type.</div>';
    defaultsFieldsArea.innerHTML = html;
  }

  function collectDefaultFields() {
    var obj = {};
    document.querySelectorAll('.defaults-field').forEach(function (el) {
      var key = el.dataset.key;
      var val = el.value;
      if (val === '' || val === undefined) return;
      if (el.type === 'number' && val !== '') val = parseFloat(val);
      // Handle comma-separated text as arrays for known array fields
      if (el.type === 'text' && val.indexOf(',') > -1) {
        val = val.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
      }
      obj[key] = val;
    });
    return obj;
  }

  // ─── Summary of key settings for table display ──────────────────────
  function summarizeDefaults(type, defaults) {
    if (!defaults || Object.keys(defaults).length === 0) return '<span class="mb-text-muted">—</span>';
    var fields = MODEL_FIELDS[type] || [];
    var parts = [];
    fields.slice(0, 3).forEach(function (f) {
      if (defaults[f.key] !== undefined) {
        var v = defaults[f.key];
        if (Array.isArray(v)) v = v.join(', ');
        parts.push('<span class="mb-badge mdl-setting-badge">' + f.label.split('(')[0].trim() + ': ' + v + '</span>');
      }
    });
    return parts.join('') || '<span class="mb-text-muted">—</span>';
  }

  // ─── Selection management ────────────────────────────────────────────
  function updateSelectedCount() {
    selectedCountSpan.textContent = selectedModels.size;
    btnDeleteSelected.style.display = selectedModels.size > 0 ? 'inline-block' : 'none';
  }

  function updateSelectAllState() {
    var checkboxes = document.querySelectorAll('.model-checkbox');
    if (checkboxes.length === 0) {
      selectAllCheckbox.checked = false;
      selectAllCheckbox.indeterminate = false;
    } else if (selectedModels.size === checkboxes.length) {
      selectAllCheckbox.checked = true;
      selectAllCheckbox.indeterminate = false;
    } else if (selectedModels.size > 0) {
      selectAllCheckbox.checked = false;
      selectAllCheckbox.indeterminate = true;
    } else {
      selectAllCheckbox.checked = false;
      selectAllCheckbox.indeterminate = false;
    }
  }

  selectAllCheckbox.onchange = function () {
    var checkboxes = document.querySelectorAll('.model-checkbox');
    if (selectAllCheckbox.checked) {
      checkboxes.forEach(function (cb) { cb.checked = true; selectedModels.add(cb.getAttribute('data-model-id')); });
    } else {
      checkboxes.forEach(function (cb) { cb.checked = false; }); selectedModels.clear();
    }
    updateSelectedCount();
  };

  // ─── Load models ─────────────────────────────────────────────────────
  function loadModels() {
    var type = typeSelect.value;
    listTitle.textContent = TYPE_LABELS[type] || type;
    selectedModels.clear();
    updateSelectedCount();
    renderDefaultFields(type, {});
    clearForm();

    fetch('/setup/models/api/' + encodeURIComponent(type))
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var models = (d && d.models) || [];
        var html = '';
        if (models.length === 0) {
          html = '<tr><td colspan="5" class="text-center mb-text-muted py-3">No models for this type</td></tr>';
        } else {
          models.forEach(function (m) {
            html += '<tr class="model-row" data-model-id="' + m.id + '">' +
              '<td data-label="Select"><label class="mb-check"><input title="Select this model" type="checkbox" class="model-checkbox" data-model-id="' + m.id + '" onclick="event.stopPropagation()"><span class="visually-hidden">Select ' + (m.name || m.id) + '</span></label></td>' +
              '<td data-label="Name" class="fw-semibold">' + (m.name || '') + '</td>' +
              '<td data-label="Description" class="mb-text-sm mb-text-muted">' + (m.description || '') + '</td>' +
              '<td data-label="Key Settings">' + summarizeDefaults(type, m.defaults) + '</td>' +
              '<td data-label="Actions"><button title="Choose this model to apply" aria-label="Choose ' + (m.name || m.id) + ' to apply" class="mb-btn mb-btn-secondary mb-btn-sm mb-btn-icon" data-choose-apply="' + m.id + '" onclick="event.stopPropagation()">' +
              '<i class="bi bi-link"></i></button></td>' +
              '</tr>';
          });
        }
        tableBody.innerHTML = html;
        wireModelRowHandlers();
        loadPartsOfType();
      })
      .catch(function () { tableBody.innerHTML = '<tr><td colspan="5" class="mb-text-danger py-3">Failed to load</td></tr>'; });
  }

  function wireModelRowHandlers() {
    // Row click = edit
    document.querySelectorAll('.model-row').forEach(function (row) {
      row.addEventListener('click', function () { fillFormFromId(row.getAttribute('data-model-id')); });
    });
    // Choose button = set for apply
    document.querySelectorAll('[data-choose-apply]').forEach(function (btn) {
      btn.onclick = function () { applyModelId.value = btn.getAttribute('data-choose-apply'); };
    });
    // Checkboxes
    document.querySelectorAll('.model-checkbox').forEach(function (cb) {
      cb.onchange = function () {
        var mid = cb.getAttribute('data-model-id');
        if (cb.checked) selectedModels.add(mid); else selectedModels.delete(mid);
        updateSelectedCount();
        updateSelectAllState();
      };
    });
  }

  // ─── Form operations ─────────────────────────────────────────────────
  function clearForm() {
    document.getElementById('modelId').value = '';
    document.getElementById('modelName').value = '';
    document.getElementById('modelDesc').value = '';
    document.getElementById('modelDefaults').value = '';
    document.getElementById('btnDeleteModel').disabled = true;
    editorTitle.textContent = 'Create New Model';
    renderDefaultFields(typeSelect.value, {});
  }

  function fillFormFromId(id) {
    var type = typeSelect.value;
    fetch('/setup/models/api/' + encodeURIComponent(type) + '/' + encodeURIComponent(id))
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d || !d.success || !d.model) return;
        document.getElementById('modelId').value = d.model.id;
        document.getElementById('modelName').value = d.model.name || '';
        document.getElementById('modelDesc').value = d.model.description || '';
        document.getElementById('modelDefaults').value = JSON.stringify(d.model.defaults || {}, null, 2);
        document.getElementById('btnDeleteModel').disabled = false;
        editorTitle.textContent = 'Edit: ' + (d.model.name || d.model.id);
        renderDefaultFields(type, d.model.defaults || {});
        // Highlight row
        document.querySelectorAll('.model-row').forEach(function (r) { r.classList.remove('mdl-row-active'); });
        var row = document.querySelector('.model-row[data-model-id="' + id + '"]');
        if (row) row.classList.add('mdl-row-active');
      });
  }

  function loadPartsOfType() {
    var type = typeSelect.value;
    partsSelect.innerHTML = '';
    fetch('/api/parts')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var parts = (d && d.parts) || [];
        parts.filter(function (p) { return ((p.type || '').replace(/\-/g, '_') === type); })
          .forEach(function (p) {
            var opt = document.createElement('option');
            opt.value = p.id;
            opt.textContent = '#' + p.id + ' — ' + (p.name || '') + (p.modelId ? ' [' + p.modelId + ']' : '');
            partsSelect.appendChild(opt);
          });
      });
  }

  // ─── Save ─────────────────────────────────────────────────────────────
  document.getElementById('btnSaveModel').onclick = function () {
    var type = typeSelect.value;
    var id = document.getElementById('modelId').value.trim();
    var name = document.getElementById('modelName').value.trim();
    var description = document.getElementById('modelDesc').value.trim();
    if (!name) {
      toast('A model needs a name before it can be saved', 'warning');
      var nameEl = document.getElementById('modelName');
      nameEl.setAttribute('aria-invalid', 'true');
      nameEl.focus();
      return;
    }
    document.getElementById('modelName').removeAttribute('aria-invalid');

    // Collect from form fields, then merge any raw JSON overrides
    var defaults = collectDefaultFields();
    var rawCollapse = document.getElementById('rawDefaultsCollapse');
    if (rawCollapse && rawCollapse.classList.contains('show')) {
      var rawText = document.getElementById('modelDefaults').value.trim();
      if (rawText) {
        try {
          var rawObj = JSON.parse(rawText);
          defaults = Object.assign({}, defaults, rawObj);
        } catch (e) {
          toast('Invalid JSON in raw defaults: ' + e.message, 'danger');
          document.getElementById('modelDefaults').setAttribute('aria-invalid', 'true');
          return;
        }
        document.getElementById('modelDefaults').removeAttribute('aria-invalid');
      }
    }

    var payload = { name: name, description: description, defaults: defaults };
    var url = '/setup/models/api/' + encodeURIComponent(type) + (id ? '/' + encodeURIComponent(id) : '');
    var method = id ? 'PUT' : 'POST';
    fetch(url, { method: method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
      .then(function (r) { return r.json(); })
      .then(function (resp) {
        if (resp && resp.success) {
          toast('Saved "' + name + '"', 'success');
          loadModels();
          if (!id) clearForm();
        } else {
          toast('Save failed: ' + ((resp && resp.error) || 'Unknown error'), 'danger');
        }
      });
  };

  // ─── Delete ───────────────────────────────────────────────────────────
  document.getElementById('btnDeleteModel').onclick = function () {
    var type = typeSelect.value;
    var id = document.getElementById('modelId').value.trim();
    if (!id) { toast('Pick a model from the list first', 'warning'); return; }
    var name = document.getElementById('modelName').value.trim() || id;
    mdlConfirm({
      title: 'Delete this model?',
      message: 'The model definition is removed. Parts already assigned to it keep the settings they were given.',
      target: name,
      confirmLabel: 'Delete model'
    }).then(function (ok) {
      if (!ok) return;
      fetch('/setup/models/api/' + encodeURIComponent(type) + '/' + encodeURIComponent(id), { method: 'DELETE' })
        .then(function (r) { return r.json(); })
        .then(function () { toast('Deleted "' + name + '"', 'success'); clearForm(); loadModels(); });
    });
  };

  document.getElementById('btnNewModel').onclick = clearForm;

  // ─── Bulk delete ──────────────────────────────────────────────────────
  btnDeleteSelected.onclick = function () {
    if (selectedModels.size === 0) return;
    var type = typeSelect.value;
    // Name every model in the list, not just the count — "Delete 4 models?"
    // is not enough information to say yes to.
    var names = [];
    document.querySelectorAll('.model-checkbox').forEach(function (cb) {
      if (!cb.checked) return;
      var row = cb.closest('.model-row');
      var cell = row && row.querySelector('td[data-label="Name"]');
      names.push((cell && cell.textContent.trim()) || cb.getAttribute('data-model-id'));
    });
    mdlConfirm({
      title: 'Delete ' + selectedModels.size + ' model' + (selectedModels.size === 1 ? '' : 's') + '?',
      message: 'These model definitions are removed. Parts already assigned to them keep the settings they were given.',
      details: names,
      confirmLabel: 'Delete ' + selectedModels.size + ' model' + (selectedModels.size === 1 ? '' : 's')
    }).then(function (ok) {
      if (!ok) return;
      fetch('/setup/models/api/' + encodeURIComponent(type) + '/bulk-delete', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ids: Array.from(selectedModels) })
      })
        .then(function (r) { return r.json(); })
        .then(function (resp) {
          if (resp && resp.success) toast('Deleted ' + resp.deletedCount + ' model(s)', 'success');
          else toast('Bulk delete failed', 'danger');
          selectedModels.clear();
          loadModels();
        })
        .catch(function (err) { toast('Bulk delete failed: ' + err.message, 'danger'); loadModels(); });
    });
  };

  // ─── Apply model to parts ────────────────────────────────────────────
  document.getElementById('btnApplyModel').onclick = function () {
    var id = applyModelId.value.trim();
    if (!id) { toast('Pick a model first — use the link button on its row', 'warning'); return; }
    var selected = Array.from(partsSelect.selectedOptions).map(function (o) { return o.value; });
    if (selected.length === 0) { toast('Select one or more parts to apply it to', 'warning'); return; }
    var status = document.getElementById('applyStatus');
    status.textContent = 'Applying model ' + id + '...';
    var ok = 0, fail = 0;
    Promise.all(selected.map(function (pid) {
      return fetch('/api/parts/' + encodeURIComponent(pid), {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ config: { modelId: id } })
      }).then(function (r) { return r.json(); })
        .then(function (r) { if (r && r.success) ok++; else fail++; })
        .catch(function () { fail++; });
    })).then(function () {
      status.textContent = 'Done. Applied to ' + ok + ' part(s), failed: ' + fail;
      loadPartsOfType();
    });
  };

  document.getElementById('btnPushDefaults').onclick = function () {
    var id = applyModelId.value.trim();
    if (!id) { toast('Pick a model first — use the link button on its row', 'warning'); return; }
    var selected = Array.from(partsSelect.selectedOptions).map(function (o) { return o.value; });
    if (selected.length === 0) { toast('Select one or more parts to apply it to', 'warning'); return; }
    var status = document.getElementById('applyStatus');
    var type = typeSelect.value;
    status.textContent = 'Pushing defaults...';
    fetch('/setup/models/api/' + encodeURIComponent(type) + '/' + encodeURIComponent(id))
      .then(function (r) { return r.json(); })
      .then(function (md) {
        if (!md || !md.success || !md.model) throw new Error('Model not found');
        var defaults = md.model.defaults || {};
        return Promise.all(selected.map(function (pid) {
          return fetch('/api/parts/' + encodeURIComponent(pid))
            .then(function (r) { return r.json(); })
            .then(function (pd) {
              if (!pd || !pd.success || !pd.part) throw new Error('Part not found');
              var cfg = pd.part.config || {};
              var merged = {};
              Object.keys(defaults).forEach(function (k) { merged[k] = defaults[k]; });
              Object.keys(cfg).forEach(function (k) { merged[k] = cfg[k]; });
              merged.modelId = id;
              return fetch('/api/parts/' + encodeURIComponent(pid), {
                method: 'PUT', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ config: merged })
              }).then(function (r) { return r.json(); });
            });
        }));
      })
      .then(function (results) {
        var ok = 0, fail = 0;
        (results || []).forEach(function (r) { if (r && r.success) ok++; else fail++; });
        status.textContent = 'Done. Pushed to ' + ok + ' part(s), failed: ' + fail;
        loadPartsOfType();
      })
      .catch(function (err) { status.textContent = 'Failed: ' + err.message; });
  };

  // ─── Auto-load on type change ─────────────────────────────────────────
  typeSelect.addEventListener('change', function () {
    loadModels();
  });

  document.getElementById('btnRefresh').onclick = loadModels;

  // Initial load
  loadModels();
})();
</script>
