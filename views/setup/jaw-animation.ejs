<div class="jaw-page">
  <% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-alert mb-alert-warning mb-2" role="alert">
    <i class="bi bi-exclamation-triangle"></i> <%= error %>
  </div>
  <% } %>

  <!-- Config Selector Bar -->
  <div class="mb-row-sm align-items-center mb-2">
    <div class="mb-input-group jaw-config-picker">
      <span class="mb-input-addon"><i class="bi bi-collection"></i></span>
      <select class="mb-select" id="configSelector" title="Select a saved jaw config">
        <option value="">Loading...</option>
      </select>
    </div>
    <div class="mb-row-sm">
      <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm" id="saveAsNewBtn" title="Save current settings as a new config">
        <i class="bi bi-plus-lg"></i> Save As New
      </button>
      <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm" id="renameConfigBtn" title="Rename current config">
        <i class="bi bi-pencil"></i> Rename
      </button>
      <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm" id="deleteConfigBtn" title="Delete current config">
        <i class="bi bi-trash"></i> Delete
      </button>
    </div>
    <div class="ms-auto">
      <button type="button" class="mb-btn mb-btn-primary mb-btn-sm" id="saveConfigBtn" title="Save jaw configuration">
        <i class="bi bi-save"></i> Save Config
      </button>
    </div>
  </div>

  <% if (currentCharacter) { %>
  <div class="row g-2">
    <!-- LEFT COLUMN: Configuration -->
    <div class="col-lg-5">
      <!-- Enable Toggle -->
      <div class="jaw-section">
        <label class="mb-switch mb-2" title="Enable jaw animation">
          <input type="checkbox" id="jawEnabled" title="Enable jaw animation">
          <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
          <strong>Enable Jaw Animation</strong>
        </label>

        <!-- Servo Selection -->
        <div class="jaw-field">
          <label for="jawServoSelect" class="mb-field-label"><i class="bi bi-robot"></i> Jaw Servo</label>
          <select class="mb-select" id="jawServoSelect" title="Select the jaw servo">
            <option value="">Select a servo...</option>
          </select>
          <small class="mb-field-hint">
            <span id="servoStatusIndicator"></span>
            <span id="servoStatusText">Select a servo to see its status</span>
          </small>
        </div>
      </div>

      <!-- Tuning -->
      <div class="jaw-section">
        <h6 class="jaw-section-title"><i class="bi bi-sliders"></i> Tuning</h6>

        <div class="jaw-field" title="Amplifies quiet audio so the jaw moves more. Higher values make the jaw react to softer sounds. Default 1.0 = no amplification. Try 2.0-3.0 for quiet voices.">
          <label for="sensitivityRange" class="mb-field-label">
            Sensitivity <span class="mb-badge" id="sensitivityValue">1.0</span>
          </label>
          <input type="range" class="mb-range" id="sensitivityRange" min="0.1" max="5.0" step="0.1" value="1.0" title="Adjust jaw sensitivity">
        </div>

        <div class="jaw-field" title="Controls how much the jaw movement is smoothed between frames. Lower = more responsive but jittery. Higher = smoother but slower to react. For speech, 0.5-0.7 is typical.">
          <label for="smoothingRange" class="mb-field-label">
            Smoothing <span class="mb-badge" id="smoothingValue">0.6</span>
          </label>
          <input type="range" class="mb-range" id="smoothingRange" min="0.1" max="0.9" step="0.1" value="0.6" title="Adjust jaw smoothing">
        </div>

        <div class="jaw-field" title="Audio below this level is treated as silence (jaw stays closed). Increase to ignore background noise. Decrease if the jaw doesn't move during quiet speech.">
          <label for="volumeThresholdRange" class="mb-field-label">
            Vol Threshold <span class="mb-badge" id="volumeThresholdValue">0.02</span>
          </label>
          <input type="range" class="mb-range" id="volumeThresholdRange" min="0.01" max="0.1" step="0.01" value="0.02" title="Adjust volume threshold">
        </div>

        <div class="jaw-grid-2 mb-2">
          <div class="jaw-field">
            <label for="attackTime" class="mb-field-label" title="How fast the jaw opens when audio gets louder. Lower = snappier jaw open. Higher = slower, more gradual opening. 30-80ms for speech, 100-200ms for music.">Attack (ms)</label>
            <input type="number" class="mb-input" id="attackTime" min="10" max="500" value="50" title="Speed of jaw opening (lower = faster)">
          </div>
          <div class="jaw-field">
            <label for="releaseTime" class="mb-field-label" title="How fast the jaw closes when audio gets quieter. Lower = snappy close. Higher = slower, smoother close. 100-200ms for speech, 200-400ms for music.">Release (ms)</label>
            <input type="number" class="mb-input" id="releaseTime" min="10" max="1000" value="150" title="Speed of jaw closing (lower = faster)">
          </div>
        </div>

        <hr class="jaw-rule">

        <!-- Preset Buttons -->
        <div class="jaw-field" title="Quick presets that set optimal filter/quantization values. Speech: bandpass ON, 10 positions. Music: bandpass OFF, 15 positions. Custom: manual control.">
          <label class="mb-field-label">Preset</label>
          <div class="jaw-seg" role="group" aria-label="Jaw tuning preset">
            <input type="radio" class="jaw-seg-input" name="jawPreset" id="presetSpeech" value="speech" checked title="Select speech preset">
            <label class="jaw-seg-label" for="presetSpeech" title="Optimized for TTS/voice: bandpass filter ON, 10 jaw positions">Speech</label>
            <input type="radio" class="jaw-seg-input" name="jawPreset" id="presetMusic" value="music" title="Select music preset">
            <label class="jaw-seg-label" for="presetMusic" title="Optimized for music: bandpass OFF (full spectrum), 15 jaw positions">Music</label>
            <input type="radio" class="jaw-seg-input" name="jawPreset" id="presetCustom" value="custom" title="Select custom preset">
            <label class="jaw-seg-label" for="presetCustom" title="Manual control of all filter settings">Custom</label>
          </div>
        </div>

        <!-- Speech Filter Toggle -->
        <label class="mb-switch mb-2" title="Filters audio to 500-2500Hz range (human speech formants). Reduces jaw movement from non-speech sounds like bass, music, or background noise. Keep ON for TTS, turn OFF for music lip-sync.">
          <input type="checkbox" id="bandpassFilter" checked title="Toggle speech bandpass filter">
          <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
          <span>Speech Filter <small class="mb-text-muted">(500-2500Hz bandpass)</small></span>
        </label>

        <!-- AGC Toggle -->
        <label class="mb-switch mb-2" title="Automatic Gain Control normalizes audio volume so quiet and loud audio both produce full jaw range. Recommended ON for consistent jaw movement regardless of TTS volume.">
          <input type="checkbox" id="agcEnabled" checked title="Toggle automatic gain control">
          <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
          <span>Auto Gain Control</span>
        </label>

        <!-- Quantization Slider -->
        <div class="jaw-field" title="Number of discrete jaw positions between min and max angle. Fewer = chunkier, puppet-like movement (5-8). More = smoother, natural movement (12-20). Reduces servo chatter.">
          <label for="quantizationRange" class="mb-field-label">
            Jaw Positions <span class="mb-badge" id="quantizationValue">10</span>
          </label>
          <input type="range" class="mb-range" id="quantizationRange" min="5" max="20" step="1" value="10" title="Adjust number of jaw positions">
        </div>

        <hr class="jaw-rule">

        <!-- Audio Sync Offset -->
        <div class="jaw-field" title="Compensates for audio device latency. If jaw moves before you hear audio, slide right (positive). If audio plays before jaw moves, slide left (negative). Adjust in 25ms increments and test with Play TTS.">
          <label for="audioLeadTimeRange" class="mb-field-label">
            Audio Sync Offset <span class="mb-badge" id="audioLeadTimeValue">0ms</span>
          </label>
          <!-- Range is +/-1000ms to match the engine, which already clamps to
               Math.max(-1000, Math.min(1000, ...)) in jawAnimationSuperPowerService.
               The slider used to stop at 500 while the engine accepted twice that,
               so an operator who needed more delay than 500ms had no way to ask for
               it. Cold USB-sink resume alone can cost 150-450ms on top of mpg123
               spawn and decode, which puts a cold start past the old limit. -->
          <input type="range" class="mb-range" id="audioLeadTimeRange" min="-1000" max="1000" step="25" value="0" title="Adjust audio sync offset">
          <div class="d-flex justify-content-between">
            <small class="mb-field-hint">Jaw leads &larr;</small>
            <small class="mb-field-hint">&rarr; Audio leads</small>
          </div>
        </div>
      </div>

      <!-- Calibration Quick-Adjust -->
      <div class="jaw-section">
        <h6 class="jaw-section-title" title="Fine-tune the servo angle range without leaving this page. Min = jaw closed, Max = jaw fully open."><i class="bi bi-rulers"></i> Calibration Quick-Adjust</h6>
        <div class="jaw-grid-2">
          <div class="jaw-field">
            <label class="mb-field-label" for="minAngleValue" title="Jaw closed position (degrees). The servo goes here during silence.">Min Angle</label>
            <div class="mb-input-group">
              <button class="mb-btn mb-btn-secondary mb-btn-sm quick-adj-btn" type="button" id="minAngleDown" title="Decrease min angle by 1 degree">&minus;</button>
              <input type="number" class="mb-input mb-input-mono text-center" id="minAngleValue" readonly title="Current closed-jaw servo angle">
              <button class="mb-btn mb-btn-secondary mb-btn-sm quick-adj-btn" type="button" id="minAngleUp" title="Increase min angle by 1 degree">+</button>
            </div>
          </div>
          <div class="jaw-field">
            <label class="mb-field-label" for="maxAngleValue" title="Jaw fully open position (degrees). The servo goes here at maximum audio level.">Max Angle</label>
            <div class="mb-input-group">
              <button class="mb-btn mb-btn-secondary mb-btn-sm quick-adj-btn" type="button" id="maxAngleDown" title="Decrease max angle by 1 degree">&minus;</button>
              <input type="number" class="mb-input mb-input-mono text-center" id="maxAngleValue" readonly title="Current open-jaw servo angle">
              <button class="mb-btn mb-btn-secondary mb-btn-sm quick-adj-btn" type="button" id="maxAngleUp" title="Increase max angle by 1 degree">+</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: TTS Test & Monitoring -->
    <div class="col-lg-7">
      <!-- TTS Test Panel -->
      <div class="jaw-panel mb-2">
        <h6 class="jaw-section-title"><i class="bi bi-megaphone"></i> TTS Test Panel</h6>

        <div class="jaw-field">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="ttsTestText" class="mb-field-label">Test Text</label>
            <button type="button" class="mb-btn mb-btn-ghost mb-btn-sm" id="saveTestTextBtn" title="Save as default test text">
              <i class="bi bi-save"></i> Save
            </button>
          </div>
          <textarea class="mb-textarea mb-dialogue" id="ttsTestText" rows="2" title="Enter TTS test text">The quick brown fox jumped over the lazy dog</textarea>
        </div>

        <div class="d-flex gap-2 mb-2">
          <button type="button" class="mb-btn mb-btn-primary mb-btn-sm flex-grow-1" id="playTtsBtn" title="Speak this text on the character's own speaker and drive the jaw servo from the audio">
            <i class="bi bi-play-fill"></i> Play TTS &amp; Jaw
          </button>
          <button type="button" class="mb-btn mb-btn-danger mb-btn-sm" id="stopBtn" title="Stop TTS playback">
            <i class="bi bi-stop-fill"></i> Stop
          </button>
        </div>

        <!-- Live Status Row -->
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div class="d-flex align-items-center gap-2">
            <span class="live-dot" id="liveDot"></span>
            <span id="ttsStatus">
              <span class="mb-badge">Idle</span>
            </span>
          </div>
          <div>
            <small class="mb-text-muted">Smoothed:</small>
            <span class="mb-mono mb-text-info" id="smoothedAmplitude">0.000</span>
          </div>
        </div>

        <!-- Audio Level Meter -->
        <div class="mb-2">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="meter-label"><i class="bi bi-soundwave"></i> Audio Level</span>
            <span class="meter-value amp" id="currentAmplitude">0.000</span>
          </div>
          <div class="mb-meter jaw-meter-tall"><div class="mb-meter-fill" id="audioMeterFill"></div></div>
        </div>

        <!-- Jaw Angle Meter -->
        <div class="mb-1">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="meter-label"><i class="bi bi-arrows-angle-expand"></i> Jaw Angle</span>
            <span class="meter-value jaw" id="targetAngle">0&deg;</span>
          </div>
          <div class="mb-meter jaw-meter-tall"><div class="mb-meter-fill jaw-meter-fill-angle" id="jawMeterFill"></div></div>
          <div class="d-flex justify-content-between mt-1">
            <small class="mb-text-muted" id="jawMeterMin">0&deg;</small>
            <small class="mb-text-muted" id="jawMeterMax">180&deg;</small>
          </div>
        </div>
      </div>

      <!-- Jaw Timeline Visualization -->
      <div class="jaw-panel mb-2 jaw-hidden" id="timelinePanel">
        <h6 class="jaw-section-title"><i class="bi bi-bar-chart"></i> Jaw Timeline</h6>
        <canvas id="jawTimelineCanvas" class="jaw-timeline-canvas" width="600" height="100"></canvas>
      </div>

      <!-- Servo Test -->
      <div class="jaw-panel">
        <div class="d-flex gap-2">
          <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm flex-grow-1" id="testJawBtn" title="Test jaw mechanical sweep">
            <i class="bi bi-arrow-left-right"></i> Test Mechanical Sweep
          </button>
          <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm" id="emergencyStopBtn" title="Emergency stop jaw servo">
            <i class="bi bi-exclamation-triangle"></i> E-Stop
          </button>
        </div>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="mb-alert mb-alert-info" role="alert">
    <i class="bi bi-info-circle"></i> No character selected. Please select a character from the navigation menu.
  </div>
  <% } %>
</div>

<!-- Confirm dialog for destructive config actions. Named, so the operator can
     see WHAT is about to be deleted — a native browser dialog cannot show that. -->
<div class="mb-modal jaw-hidden" id="jawConfirmModal" role="dialog" aria-modal="true" aria-labelledby="jawConfirmTitle">
  <div class="mb-modal-backdrop" id="jawConfirmBackdrop"></div>
  <div class="mb-modal-dialog">
    <div class="mb-modal-header">
      <h2 class="mb-modal-title" id="jawConfirmTitle">Delete config</h2>
    </div>
    <div class="mb-modal-body">
      <p class="mb-0" id="jawConfirmBody">This cannot be undone.</p>
    </div>
    <div class="mb-modal-footer">
      <button type="button" class="mb-btn mb-btn-secondary" id="jawConfirmCancel" title="Cancel">Cancel</button>
      <button type="button" class="mb-btn mb-btn-danger" id="jawConfirmOk" title="Confirm delete">Delete</button>
    </div>
  </div>
</div>

<script src="/js/jaw-animation.js?v=<%= Date.now() %>"></script>
