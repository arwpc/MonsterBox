<div class="head-page">
  <% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-alert mb-alert-warning mb-2" role="alert">
    <i class="bi bi-exclamation-triangle"></i> <%= error %>
  </div>
  <% } %>

  <% if (currentCharacter) { %>
  <div class="row g-2">
    <!-- LEFT COLUMN: Configuration (scrollable) -->
    <div class="col-lg-5 head-scroll">
      <!-- OpenCV Detection Toggle & Webcam -->
      <div class="head-section opencv-section">
        <label class="mb-switch mb-2" title="Starts the camera motion detection process" data-bs-toggle="tooltip">
          <input type="checkbox" id="ocvEnabled" title="Enable OpenCV motion detection">
          <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
          <strong><i class="bi bi-eye-fill mb-text-success"></i> OpenCV Detection</strong>
        </label>

        <div class="head-field">
          <label for="webcamSelect" class="mb-field-label" title="Which camera to use for tracking" data-bs-toggle="tooltip"><i class="bi bi-webcam"></i> Webcam</label>
          <select class="mb-select" id="webcamSelect" title="Select the tracking webcam">
            <option value="">Select a webcam...</option>
          </select>
        </div>
      </div>

      <!-- Presets -->
      <div class="head-section opencv-section">
        <h6 class="head-section-title head-section-title-ocv"><i class="bi bi-lightning"></i> Presets</h6>
        <div id="presetsContainer" class="mb-row-sm mb-2">
          <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm" id="presetPerson" title="Apply person tracking preset">
            <i class="bi bi-person-walking"></i> Person Tracking
          </button>
          <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm" id="presetNoisy" title="Apply noisy environment preset">
            <i class="bi bi-tv"></i> Noisy Environment
          </button>
          <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm" id="presetSensitive" title="Apply high sensitivity preset">
            <i class="bi bi-bullseye"></i> High Sensitivity
          </button>
        </div>
        <div class="mb-row-sm">
          <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm" id="savePresetBtn" title="Save current settings as preset">
            <i class="bi bi-floppy"></i> Save Current as Preset
          </button>
        </div>
      </div>

      <!-- Detection Mode -->
      <div class="head-section opencv-section">
        <h6 class="head-section-title head-section-title-ocv"><i class="bi bi-search"></i> Detection Mode</h6>
        <select class="mb-select" id="detectionMode" title="Select the detection mode">
          <option value="person">Person (HOG Pedestrian Detector)</option>
          <option value="person+motion">Person + Motion (Hybrid)</option>
          <option value="upperbody">Upper Body (Haar Cascade)</option>
          <option value="motion">Motion (Background Subtraction)</option>
          <option value="face">Face Detection (Haar Cascade)</option>
          <option value="face+hands">Face + Hands</option>
          <option value="all">All (Face + Motion + Hands)</option>
        </select>
        <small class="mb-field-hint">Person modes track people specifically; Motion tracks any movement</small>
      </div>

      <!-- OpenCV Parameters -->
      <div class="head-section opencv-section">
        <h6 class="head-section-title head-section-title-ocv"><i class="bi bi-eye"></i> OpenCV Parameters</h6>

        <div class="head-field">
          <label for="motionThresholdRange" class="mb-field-label" title="How much a pixel must change to count as motion. Higher = less sensitive, ignores small changes. Lower = catches subtle movement but more noise." data-bs-toggle="tooltip">
            Motion Threshold <span class="mb-badge" id="motionThresholdValue">25</span>
          </label>
          <input type="range" class="mb-range" id="motionThresholdRange" min="5" max="100" step="1" value="25" title="Adjust motion threshold">
        </div>

        <div class="head-grid-2 mb-2">
          <div class="head-field">
            <label for="minContourArea" class="mb-field-label" title="Minimum size of motion blob in pixels. Increase to ignore small movements (pets, shadows). A person at mid-range is ~5000-15000." data-bs-toggle="tooltip">Min Contour</label>
            <input type="number" class="mb-input" id="minContourArea" min="100" max="50000" step="100" value="3000" title="Set minimum contour area">
          </div>
          <div class="head-field">
            <label for="maxContourArea" class="mb-field-label" title="Maximum motion blob size. Decrease to ignore full-frame changes (lighting shifts, camera bumps)." data-bs-toggle="tooltip">Max Contour</label>
            <input type="number" class="mb-input" id="maxContourArea" min="1000" max="300000" step="1000" value="100000" title="Set maximum contour area">
          </div>
        </div>

        <div class="head-field">
          <label for="bgLearningRateRange" class="mb-field-label" title="How fast the background model adapts to changes. Lower = more stable background (better for static cameras). Higher = adapts quickly (handles lighting changes)." data-bs-toggle="tooltip">
            BG Learning Rate <span class="mb-badge" id="bgLearningRateValue">0.005</span>
          </label>
          <input type="range" class="mb-range" id="bgLearningRateRange" min="0.001" max="0.1" step="0.001" value="0.005" title="Adjust background learning rate">
        </div>

        <div class="head-field">
          <label for="noiseKernelRange" class="mb-field-label" title="Morphological filter size to remove speckle noise. Higher = more aggressive noise removal but may lose small targets." data-bs-toggle="tooltip">
            Noise Kernel <span class="mb-badge" id="noiseKernelValue">5</span>
          </label>
          <input type="range" class="mb-range" id="noiseKernelRange" min="1" max="11" step="2" value="5" title="Adjust noise kernel size">
        </div>

        <div class="head-field">
          <label for="blurSizeRange" class="mb-field-label" title="Gaussian blur before detection. Higher = smoother image, fewer false detections, but less precise target edges." data-bs-toggle="tooltip">
            Blur Size <span class="mb-badge" id="blurSizeValue">5</span>
          </label>
          <input type="range" class="mb-range" id="blurSizeRange" min="1" max="15" step="2" value="5" title="Adjust blur size">
        </div>

        <div class="head-field">
          <label for="dilateSizeRange" class="mb-field-label" title="Merges nearby motion blobs into one target. Higher = treats spread-out motion (walking person) as one target." data-bs-toggle="tooltip">
            Dilate/Merge Size <span class="mb-badge" id="dilateSizeValue">9</span>
          </label>
          <input type="range" class="mb-range" id="dilateSizeRange" min="1" max="21" step="2" value="9" title="Adjust dilate and merge size">
        </div>

        <div class="head-field">
          <label for="varThresholdRange" class="mb-field-label" title="Background model sensitivity. Higher = ignores more variation (good for noisy environments). Lower = detects subtle changes." data-bs-toggle="tooltip">
            MOG2 Var Threshold <span class="mb-badge" id="varThresholdValue">25</span>
          </label>
          <input type="range" class="mb-range" id="varThresholdRange" min="5" max="80" step="1" value="25" title="Adjust MOG2 variance threshold">
        </div>

        <div class="head-field">
          <label for="targetLockRange" class="mb-field-label" title="How strongly to stick with the current target. Higher = won't jump to new motion. Lower = switches targets more readily." data-bs-toggle="tooltip">
            Target Lock <span class="mb-badge" id="targetLockValue">5</span>
          </label>
          <input type="range" class="mb-range" id="targetLockRange" min="1" max="10" step="1" value="5" title="Adjust target lock strength">
        </div>

        <div class="head-field">
          <label for="confirmFramesRange" class="mb-field-label" title="Frames a new motion must persist before tracking it. Higher = ignores brief flickers (TVs, screens). Lower = faster target acquisition." data-bs-toggle="tooltip">
            Confirm Frames <span class="mb-badge" id="confirmFramesValue">3</span>
          </label>
          <input type="range" class="mb-range" id="confirmFramesRange" min="1" max="10" step="1" value="3" title="Adjust confirm frames count">
        </div>
      </div>

      <!-- Head Tracking Toggle & Servo -->
      <div class="head-section servo-section">
        <label class="mb-switch mb-2" title="Enables servo movement to follow detected motion. Requires OpenCV to be running." data-bs-toggle="tooltip">
          <input type="checkbox" id="htEnabled" title="Enable head tracking servo">
          <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
          <strong><i class="bi bi-robot mb-text-warning"></i> Head Tracking (Servo)</strong>
        </label>
        <span class="toggle-disabled-hint head-hidden" id="htDisabledHint">Requires OpenCV</span>

        <div class="head-field">
          <label for="panServoSelect" class="mb-field-label"><i class="bi bi-robot"></i> Pan Servo</label>
          <select class="mb-select" id="panServoSelect" title="Select the pan servo">
            <option value="">Select a servo...</option>
          </select>
          <!-- Populated by head-animation.js on servo change: status dot plus the
               real calibrated bounds, matching the jaw page. -->
          <div class="servo-bounds-info head-hidden" id="servoBoundsInfo"></div>
        </div>
      </div>

      <!-- Tracking Tuning -->
      <div class="head-section servo-section">
        <h6 class="head-section-title head-section-title-servo"><i class="bi bi-sliders"></i> Servo Tuning</h6>

        <div class="head-field">
          <label for="smoothingRange" class="mb-field-label" title="How gradually the servo follows the target. Higher = smoother but slower response. Lower = faster but may jitter." data-bs-toggle="tooltip">
            Smoothing <span class="mb-badge" id="smoothingValue">0.25</span>
          </label>
          <input type="range" class="mb-range" id="smoothingRange" min="0.05" max="0.95" step="0.05" value="0.25" title="Adjust servo smoothing">
        </div>

        <div class="head-field">
          <label for="deadzoneRange" class="mb-field-label" title="Center region (% of frame) where no servo movement occurs. Prevents jitter when target is near center." data-bs-toggle="tooltip">
            Deadzone <span class="mb-badge" id="deadzoneValue">5</span>
          </label>
          <input type="range" class="mb-range" id="deadzoneRange" min="1" max="25" step="1" value="5" title="Adjust center deadzone">
        </div>

        <div class="head-grid-2 mb-2">
          <div class="head-field">
            <label for="centerDeg" class="mb-field-label" title="Servo angle for the 'looking straight ahead' position." data-bs-toggle="tooltip">Center (&deg;)</label>
            <input type="number" class="mb-input" id="centerDeg" value="0" title="Set servo center angle">
          </div>
          <div class="head-field">
            <label for="rangeDeg" class="mb-field-label" title="Total degrees the servo can sweep. Larger = wider tracking range." data-bs-toggle="tooltip">Range (&deg;)</label>
            <input type="number" class="mb-input" id="rangeDeg" min="1" max="180" value="60" title="Set servo sweep range">
          </div>
        </div>

        <label class="mb-switch mb-2" title="Reverse the pan direction if servo moves opposite to target." data-bs-toggle="tooltip">
          <input type="checkbox" id="invertPan" title="Invert pan direction">
          <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
          <span>Invert Pan Direction</span>
        </label>
      </div>

      <!-- Save Button -->
      <div class="d-flex gap-2 mb-2">
        <button type="button" class="mb-btn mb-btn-primary mb-btn-sm flex-grow-1" id="saveConfigBtn" title="Save head tracking configuration">
          <i class="bi bi-save"></i> Save Config
        </button>
      </div>
    </div>

    <!-- RIGHT COLUMN: Webcam Preview & Controls -->
    <div class="col-lg-7">
      <!-- Webcam Preview with Overlay -->
      <div class="webcam-container mb-2" id="webcamContainer">
        <img id="webcamStream" class="webcam-stream head-hidden" alt="Webcam stream">
        <canvas id="trackingOverlay" class="tracking-overlay"></canvas>
        <div class="webcam-placeholder" id="webcamPlaceholder">
          <div class="text-center">
            <i class="bi bi-webcam webcam-placeholder-icon"></i>
            <p class="mb-0 mt-1">Select a webcam to preview</p>
          </div>
        </div>
      </div>

      <!-- Tracking Status Panel -->
      <div class="head-panel mb-2">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div>
            <span class="status-dot inactive" id="trackingDot"></span>
            <span class="fw-bold mb-mono" id="trackingStatusText">Stopped</span>
          </div>
          <div>
            <span class="mb-badge fps-badge mb-mono" id="fpsDisplay">0 FPS</span>
          </div>
        </div>

        <div class="row g-2">
          <div class="col-4">
            <small class="mb-text-muted">Target</small>
            <div class="fw-bold mb-mono" id="targetStatus">No target</div>
          </div>
          <div class="col-4">
            <small class="mb-text-muted">Position</small>
            <div class="fw-bold mb-mono" id="targetPosition">--</div>
          </div>
          <div class="col-4">
            <small class="mb-text-muted">Head Tracking</small>
            <div class="fw-bold mb-mono" id="headTrackingStatus">Off</div>
          </div>
        </div>
      </div>

      <!-- Servo Test Panel -->
      <div class="head-panel">
        <div class="d-flex gap-2">
          <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm flex-grow-1" id="testSweepBtn" title="Test servo sweep">
            <i class="bi bi-arrow-left-right"></i> Test Sweep
          </button>
          <button type="button" class="mb-btn mb-btn-secondary mb-btn-sm" id="emergencyStopBtn" title="Emergency stop servo">
            <i class="bi bi-exclamation-triangle"></i> E-Stop
          </button>
        </div>
      </div>
    </div>
  </div>
  <% } else { %>
  <div class="mb-alert mb-alert-info" role="alert">
    <i class="bi bi-info-circle"></i> No character selected. Please select a character from the navigation menu.
  </div>
  <% } %>
</div>

<script src="/js/head-animation.js?v=<%= Date.now() %>"></script>
