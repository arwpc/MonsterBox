<!-- Animation Studio - Unified Scenes, Poses & Timeline Editor -->
<!-- Styles live in /public/css/studio.css (extracted in Phase 4a). -->
<link rel="stylesheet" href="/css/studio.css">

<!-- Toolbar -->
<div class="studio-toolbar">
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <strong class="me-2"><i class="bi bi-palette"></i> Animation Studio</strong>

    <div class="mb-btn-group">
      <button class="mb-btn mb-btn-primary mb-btn-sm" id="btnNewScene" title="New Scene"><i class="bi bi-plus-circle"></i> Scene</button>
      <button class="mb-btn mb-btn-secondary mb-btn-sm" id="btnNewPose" title="New Pose"><i class="bi bi-plus-circle"></i> Pose</button>
    </div>

    <button class="mb-btn mb-btn-primary mb-btn-sm" id="btnSave" disabled title="Save current scene"><i class="bi bi-save"></i> Save</button>

    <div class="mb-btn-group">
      <button class="mb-btn mb-btn-primary mb-btn-sm" id="btnPlay" disabled title="Play scene"><i class="bi bi-play-fill"></i></button>
      <button class="mb-btn mb-btn-danger mb-btn-sm" id="btnStop" disabled title="Stop"><i class="bi bi-stop-fill"></i></button>
    </div>

    <div class="vr mx-1"></div>

    <div class="mode-toggle">
      <label class="mb-check" for="jawToggle">
        <input type="checkbox" id="jawToggle" title="Toggle jaw animation">
        <span>Jaw</span>
      </label>
    </div>
    <div class="mode-toggle">
      <label class="mb-check" for="headTrackToggle">
        <input type="checkbox" id="headTrackToggle" title="Toggle head tracking">
        <span>Head Track</span>
      </label>
      <span id="headTrackIndicator" class="studio-hidden"><span class="tracking-pulse"></span></span>
    </div>

    <div class="vr mx-1"></div>

    <button class="mb-btn mb-btn-panic mb-btn-sm" id="btnEmergencyStop" title="Emergency Stop All"><i class="bi bi-exclamation-triangle"></i> E-STOP</button>

    <span class="ms-auto mb-text-xs mb-text-muted mb-mono" id="studioStatus" role="status" aria-live="polite"></span>
  </div>
</div>

<!-- Three-Panel Layout -->
<div class="row g-0 studio-panels">
  <!-- LEFT PANEL: Library & Queue -->
  <div class="col-xl-3 col-lg-3 studio-panel" id="leftPanel">

    <!-- Scene Library -->
    <div class="panel-section">
      <div class="panel-section-header" data-toggle-section="scenesSection">
        <h6><i class="bi bi-film"></i> Scenes</h6>
        <i class="bi bi-chevron-down"></i>
      </div>
      <div class="panel-section-body" id="scenesSection">
        <input type="text" class="mb-input search-input mb-2" id="sceneSearch" placeholder="Search scenes..." title="Search scenes">
        <div id="sceneLibrary"></div>
      </div>
    </div>

    <!-- Pose Library -->
    <div class="panel-section">
      <div class="panel-section-header" data-toggle-section="posesSection">
        <h6><i class="bi bi-person-arms-up"></i> Poses</h6>
        <i class="bi bi-chevron-down"></i>
      </div>
      <div class="panel-section-body" id="posesSection">
        <div id="poseLibrary"></div>
      </div>
    </div>

    <!-- Queue -->
    <div class="panel-section">
      <div class="panel-section-header" data-toggle-section="queueSection">
        <h6><i class="bi bi-collection-play"></i> Queue</h6>
        <i class="bi bi-chevron-down"></i>
      </div>
      <div class="panel-section-body" id="queueSection">
        <div class="mb-btn-group mb-btn-group-fill mb-2">
          <button class="mb-btn mb-btn-primary mb-btn-sm" id="btnQueuePlay" title="Play queue"><i class="bi bi-play-fill"></i> Play</button>
          <button class="mb-btn mb-btn-secondary mb-btn-sm" id="btnQueueLoop" title="Loop queue"><i class="bi bi-repeat"></i> Loop</button>
          <button class="mb-btn mb-btn-secondary mb-btn-sm" id="btnQueueStop" title="Stop queue"><i class="bi bi-stop-fill"></i> Stop</button>
          <button class="mb-btn mb-btn-danger mb-btn-sm" id="btnQueueClear" title="Clear queue"><i class="bi bi-trash"></i></button>
        </div>
        <div class="mb-btn-group mb-btn-group-fill mb-2">
          <button class="mb-btn mb-btn-ghost mb-btn-sm" id="btnQueuePause" title="Pause queue"><i class="bi bi-pause-fill"></i> Pause</button>
          <button class="mb-btn mb-btn-ghost mb-btn-sm" id="btnQueueResume" title="Resume queue"><i class="bi bi-skip-forward-fill"></i> Resume</button>
          <button class="mb-btn mb-btn-ghost mb-btn-sm" id="btnQueueSkip" title="Skip to next scene"><i class="bi bi-skip-end-fill"></i> Skip</button>
        </div>
        <div id="queueStatus" class="mb-1 mb-text-xs"></div>
        <div id="queueList" class="studio-queue-list"></div>
        <div id="emptyQueue" class="mb-text-muted mb-text-xs text-center py-2 studio-hidden">
          <i class="bi bi-inbox"></i> Drag scenes here
        </div>
        <div class="mb-input-group mt-2">
          <input type="text" class="mb-input" id="storyNameInput" placeholder="Story name..." title="Story name">
          <button class="mb-btn mb-btn-secondary" id="btnSaveStory" title="Save queue as story"><i class="bi bi-save"></i></button>
        </div>
      </div>
    </div>
  </div>

  <!-- CENTER PANEL: Timeline/Editor -->
  <div class="col-xl-6 col-lg-6 studio-panel" id="centerPanel">
    <div class="p-3">
      <div id="noSceneSelected" class="mb-empty">
        <i class="bi bi-film mb-empty-icon"></i>
        <p class="mb-empty-body">Select a scene from the library or create a new one</p>
        <button class="mb-btn mb-btn-primary" id="btnNewSceneCenter" title="Create a new scene"><i class="bi bi-plus-circle"></i> Create New Scene</button>
      </div>

      <div id="timelineEditor" class="studio-hidden">
        <div class="studio-scene-bar mb-3">
          <input type="text" class="mb-input mb-serif" id="sceneNameInput" placeholder="Scene name..." title="Scene name">
          <span class="mb-badge mb-mono" id="stepCountBadge">0 steps</span>
          <button class="mb-btn mb-btn-secondary mb-btn-sm mb-btn-icon" id="btnDuplicateScene" title="Duplicate Scene"><i class="bi bi-files"></i></button>
          <button class="mb-btn mb-btn-danger mb-btn-sm mb-btn-icon" id="btnDeleteCurrentScene" title="Delete Scene"><i class="bi bi-trash"></i></button>
        </div>

        <div id="stepsList"></div>

        <div class="add-step-zone mt-2" id="addStepZone">
          <i class="bi bi-plus-circle"></i>
          <div>Drag a part here or click to add a step</div>
        </div>
      </div>
    </div>
  </div>

  <!-- RIGHT PANEL: Preview & Palette -->
  <div class="col-xl-3 col-lg-3 studio-panel" id="rightPanel">

    <!-- Live Preview -->
    <div class="panel-section">
      <div class="panel-section-header" data-toggle-section="previewSection">
        <h6><i class="bi bi-camera-video"></i> Live Preview</h6>
        <i class="bi bi-chevron-down"></i>
      </div>
      <div class="panel-section-body" id="previewSection">
        <div class="webcam-preview" id="webcamContainer">
          <div class="webcam-placeholder" id="webcamPlaceholder">
            <span><i class="bi bi-camera-video-off"></i> No webcam</span>
          </div>
        </div>
        <div class="mt-1 d-flex align-items-center gap-1">
          <select class="mb-select mb-text-xs" id="webcamPartSelect" title="Select webcam">
            <option value="">Select webcam...</option>
          </select>
          <button class="mb-btn mb-btn-secondary mb-btn-sm mb-btn-icon" id="btnStartStream" title="Start Stream"><i class="bi bi-play"></i></button>
          <button class="mb-btn mb-btn-danger mb-btn-sm mb-btn-icon studio-hidden" id="btnStopStream" title="Stop Stream"><i class="bi bi-stop"></i></button>
        </div>
      </div>
    </div>

    <!-- Part Palette -->
    <div class="panel-section">
      <div class="panel-section-header" data-toggle-section="paletteSection">
        <h6><i class="bi bi-tools"></i> Part Palette</h6>
        <i class="bi bi-chevron-down"></i>
      </div>
      <div class="panel-section-body" id="paletteSection">
        <div id="partPalette"></div>

        <hr class="my-2">
        <div class="mb-eyebrow mb-1">Actions</div>
        <div id="actionPalette">
          <div class="palette-action" draggable="true" data-step-type="audio">
            <span class="part-icon"><i class="bi bi-music-note-beamed"></i></span> Audio
          </div>
          <div class="palette-action" draggable="true" data-step-type="sayThis">
            <span class="part-icon"><i class="bi bi-chat-quote"></i></span> Say This (TTS)
          </div>
          <div class="palette-action" draggable="true" data-step-type="askAI">
            <span class="part-icon"><i class="bi bi-robot"></i></span> Ask AI
          </div>
          <div class="palette-action" draggable="true" data-step-type="wait">
            <span class="part-icon"><i class="bi bi-hourglass-split"></i></span> Wait/Pause
          </div>
          <div class="palette-action" draggable="true" data-step-type="pose">
            <span class="part-icon"><i class="bi bi-person-arms-up"></i></span> Pose
          </div>
          <div class="palette-action" draggable="true" data-step-type="goblin-video">
            <span class="part-icon"><i class="bi bi-display"></i></span> Goblin Video
          </div>
          <div class="palette-action" draggable="true" data-step-type="jaw-animation">
            <span class="part-icon"><i class="bi bi-lightning"></i></span> Jaw Animation
          </div>
          <div class="palette-action" draggable="true" data-step-type="head-tracking">
            <span class="part-icon"><i class="bi bi-bullseye"></i></span> Head Tracking
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Step Modal -->
<div class="modal fade" id="addStepModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Add Step</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" title="Close"></button>
      </div>
      <div class="modal-body">
        <h6 class="text-muted mb-2">Actions</h6>
        <div class="row g-2 mb-3" id="modalActions"></div>
        <h6 class="text-muted mb-2">Character Parts</h6>
        <div class="row g-2" id="modalParts"></div>
      </div>
    </div>
  </div>
</div>

<!-- New Pose Modal -->
<div class="modal fade" id="newPoseModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-person-arms-up"></i> New Pose</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" title="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-field">
          <label class="mb-field-label" for="newPoseName">Pose Name</label>
          <input type="text" class="mb-input" id="newPoseName" placeholder="Enter pose name..." title="Pose name">
        </div>
        <div class="mb-field">
          <label class="mb-field-label" for="newPoseCategory">Category</label>
          <input type="text" class="mb-input" id="newPoseCategory" placeholder="e.g., greeting, idle, scare" title="Pose category">
        </div>
        <div class="mb-field">
          <label class="mb-field-label" for="newPoseTemplate">Template</label>
          <select class="mb-select" id="newPoseTemplate" title="Pose template">
            <option value="">Custom (no template)</option>
          </select>
        </div>
        <div id="newPoseTemplateOptions" class="studio-hidden"></div>
        <div id="newPosePartsConfig"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="mb-btn mb-btn-ghost" data-bs-dismiss="modal" title="Cancel">Cancel</button>
        <button type="button" class="mb-btn mb-btn-primary" id="btnCreatePose" title="Create pose">Create Pose</button>
      </div>
    </div>
  </div>
</div>

<!-- Stories Modal -->
<div class="modal fade" id="storiesModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-collection"></i> Stories</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" title="Close"></button>
      </div>
      <div class="modal-body">
        <div id="storiesList"></div>
      </div>
    </div>
  </div>
</div>

<!-- Confirm dialog — replaces the browser's native modal. Unlike that dialog,
     this NAMES the thing about to be destroyed, is themed, and works on a phone. -->
<div class="mb-modal studio-hidden" id="studioConfirm" role="dialog" aria-modal="true" aria-labelledby="studioConfirmTitle">
  <div class="mb-modal-backdrop" data-studio-confirm-cancel></div>
  <div class="mb-modal-dialog studio-confirm-dialog">
    <div class="mb-modal-header">
      <h2 class="mb-modal-title" id="studioConfirmTitle">Confirm</h2>
    </div>
    <div class="mb-modal-body">
      <p id="studioConfirmBody" class="mb-0"></p>
    </div>
    <div class="mb-modal-footer">
      <button type="button" class="mb-btn mb-btn-ghost" id="studioConfirmCancel" data-studio-confirm-cancel title="Cancel without making changes">Cancel</button>
      <button type="button" class="mb-btn mb-btn-danger" id="studioConfirmOk" title="Confirm this action">Delete</button>
    </div>
  </div>
</div>

<script src="/vendor/sortablejs/Sortable.min.js"></script>
<script>
(function() {
  'use strict';

  // ============ STATE ============
  var allScenes = [];
  var allPoses = [];
  var allParts = [];
  var calibrationProfiles = {};
  var sounds = [];
  var goblins = [];
  var poseTemplates = {};

  var currentSceneId = null;
  var currentSteps = [];
  var expandedStepIndex = -1;
  var jawEnabled = false;
  var headTrackEnabled = false;
  var webcamStreaming = false;
  var studioCharacterId = <%= typeof currentCharacter !== 'undefined' && currentCharacter ? currentCharacter : 'null' %>;

  // ============ HELPERS ============
  function $(id) { return document.getElementById(id); }
  function setHtml(id, html) { var el = $(id); if (el) el.innerHTML = html; }
  // Visibility is a class, not an inline style, so the token system and the
  // themes can still reach these elements. style.display is cleared so any
  // legacy inline value cannot outrank the class.
  function show(id) { var el = $(id); if (el) { el.classList.remove('studio-hidden'); el.style.display = ''; } }
  function hide(id) { var el = $(id); if (el) { el.classList.add('studio-hidden'); el.style.display = ''; } }
  function alertBox(type, text) { return '<div class="mb-alert mb-alert-' + type + ' mb-text-sm mb-1">' + text + '</div>'; }
  function escHtml(s) { var d = document.createElement('div'); d.appendChild(document.createTextNode(s || '')); return d.innerHTML; }

  // Toast — same pattern as announce() in public/js/mb-control-bar.js.
  function toast(message, variant) {
    var region = document.querySelector('.mb-toast-region');
    if (!region) {
      region = document.createElement('div');
      region.className = 'mb-toast-region';
      region.setAttribute('role', 'status');
      region.setAttribute('aria-live', 'polite');
      document.body.appendChild(region);
    }
    var el = document.createElement('div');
    el.className = 'mb-toast mb-toast-' + (variant || 'info');
    el.textContent = message;
    region.appendChild(el);
    setTimeout(function() {
      if (el.parentNode) el.parentNode.removeChild(el);
    }, 4000);
  }

  // Replaces the browser's native dialog. Names the target so the operator sees exactly
  // what is about to be destroyed before a scene commands real hardware.
  var confirmAction = null;
  function studioConfirm(opts, onConfirm) {
    var titleEl = $('studioConfirmTitle');
    var bodyEl = $('studioConfirmBody');
    var okEl = $('studioConfirmOk');
    if (!titleEl || !bodyEl || !okEl) { if (onConfirm) onConfirm(); return; }
    titleEl.textContent = opts.title || 'Confirm';
    bodyEl.textContent = opts.body || '';
    okEl.textContent = opts.confirmLabel || 'Delete';
    confirmAction = onConfirm;
    show('studioConfirm');
    okEl.focus();
  }
  function closeStudioConfirm() {
    confirmAction = null;
    hide('studioConfirm');
  }

  function setStatus(msg) {
    var el = $('studioStatus');
    if (el) el.textContent = msg;
    if (msg) setTimeout(function() { if (el && el.textContent === msg) el.textContent = ''; }, 5000);
  }

  // Buttons that dispatch to real hardware get a busy state so a second press
  // cannot queue a duplicate command while the first is still moving metal.
  function withBusy(el, promise) {
    if (!el || !promise || !promise.then) return promise;
    el.setAttribute('data-busy', 'true');
    return promise.then(function(v) {
      el.removeAttribute('data-busy');
      return v;
    }, function(e) {
      el.removeAttribute('data-busy');
      throw e;
    });
  }

  // ============ API CALLS ============
  function apiGet(url) {
    return fetch(url).then(function(r) { return r.json(); });
  }

  function apiPost(url, data) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    }).then(function(r) { return r.json(); });
  }

  function apiPut(url, data) {
    return fetch(url, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    }).then(function(r) { return r.json(); });
  }

  function apiDelete(url) {
    return fetch(url, { method: 'DELETE' }).then(function(r) { return r.json(); });
  }

  // ============ DATA LOADING ============
  function loadAllData() {
    Promise.all([
      apiGet('/scenes/api').then(function(j) { allScenes = (j.success && j.scenes) ? j.scenes : []; }),
      apiGet('/setup/poses/api/poses').then(function(j) { allPoses = (j.success && j.poses) ? j.poses : []; }),
      apiGet('/api/parts').then(function(j) { allParts = (j.success && j.parts) ? j.parts : []; }),
      apiGet('/api/calibration/profiles').then(function(j) { calibrationProfiles = j || {}; }).catch(function() { calibrationProfiles = {}; }),
      apiGet('/api/sounds').then(function(j) { sounds = (j.success && j.sounds) ? j.sounds : []; }).catch(function() { sounds = []; }),
      apiGet('/api/goblins').then(function(j) { goblins = (j.success && j.goblins) ? j.goblins : []; }).catch(function() { goblins = []; }),
      apiGet('/setup/poses/api/templates').then(function(j) { poseTemplates = (j.success && j.templates) ? j.templates : {}; }).catch(function() { poseTemplates = {}; })
    ]).then(function() {
      renderSceneLibrary();
      renderPoseLibrary();
      renderPartPalette();
      renderAddStepModal();
      populateWebcamSelect();
      loadQueue();

      // Check URL for edit parameter
      var params = new URLSearchParams(window.location.search);
      var editId = params.get('edit');
      if (editId) loadSceneIntoEditor(parseInt(editId, 10));
    }).catch(function(err) {
      console.error('Failed to load data:', err);
      setStatus('Error loading data');
    });
  }

  // ============ SCENE LIBRARY ============
  function renderSceneLibrary() {
    var filter = ($('sceneSearch') || {}).value || '';
    filter = filter.toLowerCase();
    var filtered = allScenes.filter(function(s) {
      return !filter || (s.name || '').toLowerCase().indexOf(filter) !== -1;
    });
    var html = '';
    if (filtered.length === 0) {
      html = '<div class="mb-text-muted mb-text-xs text-center py-2">No scenes</div>';
    }
    filtered.forEach(function(s) {
      var stepCount = (s.steps && s.steps.length) || 0;
      var isActive = currentSceneId === s.id;
      html += '<div class="lib-item' + (isActive ? ' active' : '') + '" data-scene-id="' + s.id + '" draggable="true">';
      html += '<i class="bi bi-film me-1"></i> ';
      html += '<span class="text-truncate mb-serif">' + escHtml(s.name || 'Scene ' + s.id) + '</span>';
      html += '<span class="mb-badge mb-mono">' + stepCount + '</span>';
      html += '<span class="lib-actions">';
      html += '<button class="mb-btn mb-btn-primary mb-btn-sm mb-btn-icon scene-play-btn" data-id="' + s.id + '" title="Play"><i class="bi bi-play-fill"></i></button> ';
      html += '<button class="mb-btn mb-btn-danger mb-btn-sm mb-btn-icon scene-delete-btn" data-id="' + s.id + '" title="Delete"><i class="bi bi-trash"></i></button>';
      html += '</span>';
      html += '</div>';
    });
    setHtml('sceneLibrary', html);

    // Attach event listeners
    document.querySelectorAll('#sceneLibrary .lib-item').forEach(function(el) {
      el.addEventListener('click', function(e) {
        if (e.target.closest('.scene-play-btn') || e.target.closest('.scene-delete-btn')) return;
        var id = parseInt(el.getAttribute('data-scene-id'), 10);
        loadSceneIntoEditor(id);
      });
      el.addEventListener('dragstart', function(e) {
        e.dataTransfer.setData('text/plain', 'scene:' + el.getAttribute('data-scene-id'));
        e.dataTransfer.effectAllowed = 'copy';
      });
    });
    document.querySelectorAll('.scene-play-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var id = parseInt(btn.getAttribute('data-id'), 10);
        playScene(id, btn);
      });
    });
    document.querySelectorAll('.scene-delete-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var id = parseInt(btn.getAttribute('data-id'), 10);
        deleteScene(id);
      });
    });
  }

  function loadSceneIntoEditor(id) {
    var scene = allScenes.find(function(s) { return s.id === id; });
    if (!scene) return;
    currentSceneId = id;
    currentSteps = JSON.parse(JSON.stringify(scene.steps || []));
    expandedStepIndex = -1;
    $('sceneNameInput').value = scene.name || '';
    hide('noSceneSelected');
    show('timelineEditor');
    $('btnSave').disabled = false;
    $('btnPlay').disabled = false;
    $('btnStop').disabled = false;
    renderTimeline();
    renderSceneLibrary();
    setStatus('Editing: ' + (scene.name || 'Scene ' + id));
  }

  function createNewScene() {
    var name = prompt('Scene name:');
    if (!name) return;
    apiPost('/scenes/api', { name: name, steps: [] }).then(function(j) {
      if (j.success && j.scene) {
        allScenes.push(j.scene);
        renderSceneLibrary();
        loadSceneIntoEditor(j.scene.id);
        setStatus('Created: ' + name);
      }
    });
  }

  function deleteScene(id) {
    var scene = allScenes.find(function(s) { return s.id === id; });
    var sceneName = (scene && scene.name) || ('Scene ' + id);
    var stepCount = (scene && scene.steps && scene.steps.length) || 0;
    studioConfirm({
      title: 'Delete scene',
      body: 'Delete "' + sceneName + '" (' + stepCount + ' step' + (stepCount === 1 ? '' : 's') + ')? This cannot be undone.',
      confirmLabel: 'Delete scene'
    }, function() {
      apiDelete('/scenes/api/' + id).then(function(j) {
        if (j.success) {
          allScenes = allScenes.filter(function(s) { return s.id !== id; });
          if (currentSceneId === id) {
            currentSceneId = null;
            currentSteps = [];
            hide('timelineEditor');
            show('noSceneSelected');
            $('btnSave').disabled = true;
            $('btnPlay').disabled = true;
          }
          renderSceneLibrary();
          setStatus('Scene deleted');
          toast('Deleted "' + sceneName + '"', 'warning');
        }
      });
    });
  }

  function playScene(id, sourceBtn) {
    setStatus('Playing scene...');
    var p = apiPost('/scenes/api/' + id + '/play', {}).then(function(j) {
      if (j.success) setStatus('Scene played (' + (j.steps || 0) + ' steps)');
      else { setStatus('Play failed: ' + (j.error || 'Unknown')); toast('Play failed: ' + (j.error || 'Unknown'), 'danger'); }
    }).catch(function(e) { setStatus('Error: ' + e.message); toast('Error: ' + e.message, 'danger'); });
    return withBusy(sourceBtn, p);
  }

  function saveCurrentScene() {
    if (!currentSceneId) return;
    var name = ($('sceneNameInput') || {}).value || '';
    if (!name) { setStatus('Enter a scene name'); return; }
    // Collect step data from forms before saving
    collectStepData();
    apiPut('/scenes/api/' + currentSceneId, { name: name, steps: currentSteps }).then(function(j) {
      if (j.success) {
        // Update local data
        var idx = allScenes.findIndex(function(s) { return s.id === currentSceneId; });
        if (idx >= 0) { allScenes[idx].name = name; allScenes[idx].steps = currentSteps; }
        renderSceneLibrary();
        setStatus('Saved!');
      } else {
        setStatus('Save failed: ' + (j.error || 'Unknown'));
      }
    }).catch(function(e) { setStatus('Error: ' + e.message); });
  }

  // ============ POSE LIBRARY ============
  function renderPoseLibrary() {
    // Group by category
    var groups = {};
    allPoses.forEach(function(p) {
      var cat = p.category || 'uncategorized';
      if (!groups[cat]) groups[cat] = [];
      groups[cat].push(p);
    });

    var html = '';
    if (allPoses.length === 0) {
      html = '<div class="mb-text-muted mb-text-xs text-center py-2">No poses</div>';
    }
    Object.keys(groups).forEach(function(cat) {
      html += '<div class="mb-eyebrow mb-1">' + escHtml(cat) + '</div>';
      groups[cat].forEach(function(p) {
        html += '<div class="lib-item lib-item-pose" draggable="true" data-pose-id="' + p.id + '">';
        html += '<i class="bi bi-person-arms-up me-1 lib-item-icon"></i> ';
        html += '<span class="text-truncate mb-serif">' + escHtml(p.name) + '</span>';
        html += '<span class="mb-badge mb-mono">' + ((p.parts && p.parts.length) || 0) + '</span>';
        html += '<span class="lib-actions">';
        html += '<a class="mb-btn mb-btn-secondary mb-btn-sm mb-btn-icon" href="/poses/editor/' + p.id + '" title="Edit"><i class="bi bi-pencil"></i></a> ';
        html += '<button class="mb-btn mb-btn-primary mb-btn-sm mb-btn-icon pose-test-btn" data-id="' + p.id + '" title="Test"><i class="bi bi-play-fill"></i></button> ';
        html += '<button class="mb-btn mb-btn-danger mb-btn-sm mb-btn-icon pose-delete-btn" data-id="' + p.id + '" title="Delete"><i class="bi bi-trash"></i></button>';
        html += '</span>';
        html += '</div>';
      });
    });
    setHtml('poseLibrary', html);

    // Drag handlers for poses
    document.querySelectorAll('#poseLibrary .lib-item').forEach(function(el) {
      el.addEventListener('dragstart', function(e) {
        e.dataTransfer.setData('text/plain', 'pose:' + el.getAttribute('data-pose-id'));
        e.dataTransfer.effectAllowed = 'copy';
      });
    });
    document.querySelectorAll('.pose-test-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var id = parseInt(btn.getAttribute('data-id'), 10);
        withBusy(btn, apiPost('/setup/poses/api/poses/' + id + '/test', {}).then(function(j) {
          setStatus(j.success ? 'Pose tested' : ('Pose failed: ' + (j.error || j.message || '')));
          if (!j.success) toast('Pose failed: ' + (j.error || j.message || ''), 'danger');
        }));
      });
    });
    document.querySelectorAll('.pose-delete-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var id = parseInt(btn.getAttribute('data-id'), 10);
        var pose = allPoses.find(function(p) { return p.id === id; });
        var poseName = (pose && pose.name) || ('Pose ' + id);
        studioConfirm({
          title: 'Delete pose',
          body: 'Delete the pose "' + poseName + '"? Scenes that reference it will stop working.',
          confirmLabel: 'Delete pose'
        }, function() {
          apiDelete('/setup/poses/api/poses/' + id).then(function(j) {
            if (j.success) {
              allPoses = allPoses.filter(function(p) { return p.id !== id; });
              renderPoseLibrary();
              setStatus('Pose deleted');
              toast('Deleted pose "' + poseName + '"', 'warning');
            }
          });
        });
      });
    });
  }

  // ============ PART PALETTE ============
  function renderPartPalette() {
    // Colour is a role, not a literal: each palette row carries data-step-type and
    // studio.css paints its icon from the matching --mb-step-* token.
    var typeGroups = {
      'servo': { icon: 'bi-gear', label: 'Servos', items: [] },
      'linear_actuator': { icon: 'bi-arrows-expand', label: 'Actuators', items: [] },
      'motor': { icon: 'bi-fan', label: 'Motors', items: [] },
      'light': { icon: 'bi-lightbulb', label: 'Lights', items: [] },
      'led': { icon: 'bi-lightbulb', label: 'LEDs', items: [] },
      'motion_sensor': { icon: 'bi-radar', label: 'Sensors', items: [] },
      'sensor': { icon: 'bi-radar', label: 'Sensors', items: [] }
    };

    allParts.forEach(function(p) {
      var t = p.type || '';
      if (typeGroups[t]) typeGroups[t].items.push(p);
    });

    // Merge led into light, sensor into motion_sensor
    if (typeGroups.led.items.length > 0) {
      typeGroups.light.items = typeGroups.light.items.concat(typeGroups.led.items);
    }
    if (typeGroups.sensor.items.length > 0) {
      typeGroups.motion_sensor.items = typeGroups.motion_sensor.items.concat(typeGroups.sensor.items);
    }

    var html = '';
    ['servo', 'linear_actuator', 'motor', 'light', 'motion_sensor'].forEach(function(t) {
      var g = typeGroups[t];
      if (g.items.length === 0) return;
      html += '<div class="mb-eyebrow mb-1"><i class="bi ' + g.icon + '"></i> ' + g.label + '</div>';
      g.items.forEach(function(p) {
        var stepType = t;
        if (t === 'linear_actuator') stepType = 'linear-actuator';
        if (t === 'motion_sensor' || t === 'sensor') stepType = 'sensor';
        if (t === 'led') stepType = 'light';
        var cls = p.enabled ? '' : ' disabled-part';
        html += '<div class="palette-part' + cls + '" draggable="' + (p.enabled ? 'true' : 'false') + '" data-step-type="' + stepType + '" data-part-id="' + p.id + '">';
        html += '<span class="part-icon"><i class="bi ' + g.icon + '"></i></span>';
        html += '<span class="text-truncate">' + escHtml(p.name) + '</span>';
        if (!p.enabled) html += ' <span class="mb-badge">off</span>';
        html += '</div>';
      });
    });
    setHtml('partPalette', html);

    // Drag handlers
    document.querySelectorAll('.palette-part[draggable=true], .palette-action[draggable=true]').forEach(function(el) {
      el.addEventListener('dragstart', function(e) {
        var data = 'step:' + el.getAttribute('data-step-type');
        var partId = el.getAttribute('data-part-id');
        if (partId) data += ':' + partId;
        e.dataTransfer.setData('text/plain', data);
        e.dataTransfer.effectAllowed = 'copy';
      });
    });
  }

  // ============ WEBCAM PREVIEW ============
  function populateWebcamSelect() {
    var sel = $('webcamPartSelect');
    if (!sel) return;
    var html = '<option value="">Select webcam...</option>';
    allParts.forEach(function(p) {
      if ((p.type || '').toLowerCase() === 'webcam' && p.enabled) {
        html += '<option value="' + p.id + '">' + escHtml(p.name) + '</option>';
      }
    });
    sel.innerHTML = html;
  }

  function startWebcamStream() {
    var partId = ($('webcamPartSelect') || {}).value;
    if (!partId) { setStatus('Select a webcam first'); return; }
    var container = $('webcamContainer');
    var placeholder = $('webcamPlaceholder');
    if (placeholder) placeholder.style.display = 'none';
    var img = document.createElement('img');
    img.id = 'webcamStream';
    img.src = '/setup/calibration/api/webcam/parts/' + partId + '/stream';
    img.alt = 'Live webcam';
    img.onerror = function() { setStatus('Webcam stream failed'); stopWebcamStream(); };
    container.appendChild(img);
    webcamStreaming = true;
    hide('btnStartStream');
    show('btnStopStream');
  }

  function stopWebcamStream() {
    var img = $('webcamStream');
    if (img) { img.src = ''; img.remove(); }
    var placeholder = $('webcamPlaceholder');
    if (placeholder) placeholder.style.display = '';
    webcamStreaming = false;
    show('btnStartStream');
    hide('btnStopStream');
  }

  // ============ TIMELINE RENDERING ============
  var STEP_META = {
    'servo':            { icon: 'bi-gear',              label: 'Servo' },
    'motor':            { icon: 'bi-fan',               label: 'Motor' },
    'linear-actuator':  { icon: 'bi-arrows-expand',     label: 'Actuator' },
    'light':            { icon: 'bi-lightbulb',         label: 'Light' },
    'led':              { icon: 'bi-lightbulb',         label: 'LED' },
    'audio':            { icon: 'bi-music-note-beamed', label: 'Audio' },
    'sayThis':          { icon: 'bi-chat-quote',        label: 'Say This' },
    'askAI':            { icon: 'bi-robot',             label: 'Ask AI' },
    'wait':             { icon: 'bi-hourglass-split',   label: 'Wait' },
    'pose':             { icon: 'bi-person-arms-up',    label: 'Pose' },
    'sensor':           { icon: 'bi-radar',             label: 'Sensor' },
    'goblin-video':     { icon: 'bi-display',           label: 'Goblin Video' },
    'jaw-animation':    { icon: 'bi-lightning',         label: 'Jaw Animation' },
    'head-tracking':    { icon: 'bi-bullseye',          label: 'Head Tracking' },
    'part':             { icon: 'bi-wrench',            label: 'Part (Legacy)' },
    'hardware':         { icon: 'bi-cpu',               label: 'Hardware' }
  };

  function getStepSummary(step) {
    var t = step.type || '';
    switch (t) {
      case 'servo':
        var pName = getPartName(step.partId);
        if (step.usePreset) return pName + ' -> Preset: ' + (step.presetName || '?');
        return pName + ' -> ' + (step.angle != null ? step.angle + '\u00B0' : '?');
      case 'motor':
        return getPartName(step.partId) + ' ' + (step.direction || 'fwd') + ' ' + (step.speed || 50) + '%';
      case 'linear-actuator':
        return getPartName(step.partId) + ' ' + (step.direction || 'extend');
      case 'light': case 'led':
        return getPartName(step.partId) + ' ' + (step.state || 'on');
      case 'audio':
        var snd = sounds.find(function(s) { return s.filename === step.audioId || s.id === step.audioId; });
        return snd ? snd.name : (step.audioId || 'No audio');
      case 'sayThis':
        return (step.text || '').substring(0, 40) || 'No text';
      case 'askAI':
        return (step.question || step.text || '').substring(0, 40) || 'No question';
      case 'wait':
        var ms = parseInt(step.duration, 10) || 0;
        return (ms / 1000).toFixed(1) + 's';
      case 'pose':
        var pose = allPoses.find(function(p) { return p.id == step.poseId; });
        return pose ? pose.name : ('Pose #' + (step.poseId || '?'));
      case 'sensor':
        return getPartName(step.partId) + ' (wait for motion)';
      case 'goblin-video':
        return (step.goblinId || '?') + ': ' + (step.videoId || '?');
      case 'jaw-animation':
        return (step.action || 'enable');
      case 'head-tracking':
        return (step.action || 'start');
      default:
        return t;
    }
  }

  function getPartName(partId) {
    if (!partId) return '?';
    var p = allParts.find(function(pp) { return String(pp.id) === String(partId); });
    return p ? p.name : ('Part #' + partId);
  }

  function renderTimeline() {
    var container = $('stepsList');
    if (!container) return;
    $('stepCountBadge').textContent = currentSteps.length + ' step' + (currentSteps.length !== 1 ? 's' : '');

    if (currentSteps.length === 0) {
      container.innerHTML = '<div class="mb-text-muted mb-text-sm text-center py-3">No steps. Add from the palette or click below.</div>';
      return;
    }

    var html = '';
    currentSteps.forEach(function(step, idx) {
      var t = step.type || 'unknown';
      var meta = STEP_META[t] || { icon: 'bi-question-circle', label: t };
      var colorClass = 'step-color-' + t;
      var isExpanded = expandedStepIndex === idx;
      var jawBadge = '';
      if (jawEnabled && (t === 'sayThis' || t === 'askAI')) {
        jawBadge = ' <span class="mb-badge mb-badge-success">JAW</span>';
      }

      html += '<div class="step-block ' + colorClass + (isExpanded ? ' expanded' : '') + '" data-step-index="' + idx + '">';

      // Concurrent link
      if (step.concurrent && idx < currentSteps.length - 1) {
        html += '<div class="concurrent-link" title="Runs with next step"><i class="bi bi-link-45deg"></i></div>';
      }

      // Header
      html += '<div class="step-block-header">';
      html += '<div class="step-type-icon"><i class="bi ' + meta.icon + '"></i></div>';
      html += '<div class="step-info"><strong>' + meta.label + '</strong> <span class="' + ((t === 'sayThis' || t === 'askAI') ? 'mb-dialogue' : '') + '">' + escHtml(getStepSummary(step)) + '</span>' + jawBadge + '</div>';
      html += '<div class="step-actions">';
      html += '<button class="mb-btn mb-btn-primary mb-btn-sm mb-btn-icon step-play-btn" data-idx="' + idx + '" title="Test"><i class="bi bi-play-fill"></i></button>';
      html += '<button class="mb-btn mb-btn-secondary mb-btn-sm mb-btn-icon step-dup-btn" data-idx="' + idx + '" title="Duplicate"><i class="bi bi-files"></i></button>';
      html += '<button class="mb-btn mb-btn-danger mb-btn-sm mb-btn-icon step-del-btn" data-idx="' + idx + '" title="Remove"><i class="bi bi-trash"></i></button>';
      html += '</div>';
      html += '</div>';

      // Edit form (shown when expanded)
      html += '<div class="step-edit-form">';
      html += renderStepForm(step, idx);
      html += '</div>';

      html += '</div>';
    });
    container.innerHTML = html;

    // Init SortableJS
    if (window.Sortable) {
      new Sortable(container, {
        animation: 150,
        handle: '.step-block',
        ghostClass: 'dragging',
        onEnd: function(evt) {
          var item = currentSteps.splice(evt.oldIndex, 1)[0];
          currentSteps.splice(evt.newIndex, 0, item);
          if (expandedStepIndex === evt.oldIndex) expandedStepIndex = evt.newIndex;
          else if (expandedStepIndex > evt.oldIndex && expandedStepIndex <= evt.newIndex) expandedStepIndex--;
          else if (expandedStepIndex < evt.oldIndex && expandedStepIndex >= evt.newIndex) expandedStepIndex++;
          renderTimeline();
        }
      });
    }

    // Event listeners
    container.querySelectorAll('.step-block').forEach(function(el) {
      el.addEventListener('click', function(e) {
        if (e.target.closest('.step-actions') || e.target.closest('.step-edit-form')) return;
        var idx = parseInt(el.getAttribute('data-step-index'), 10);
        expandedStepIndex = (expandedStepIndex === idx) ? -1 : idx;
        renderTimeline();
      });
    });
    container.querySelectorAll('.step-play-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var idx = parseInt(btn.getAttribute('data-idx'), 10);
        testStep(idx, btn);
      });
    });
    container.querySelectorAll('.step-dup-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var idx = parseInt(btn.getAttribute('data-idx'), 10);
        currentSteps.splice(idx + 1, 0, JSON.parse(JSON.stringify(currentSteps[idx])));
        renderTimeline();
      });
    });
    container.querySelectorAll('.step-del-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var idx = parseInt(btn.getAttribute('data-idx'), 10);
        currentSteps.splice(idx, 1);
        if (expandedStepIndex === idx) expandedStepIndex = -1;
        else if (expandedStepIndex > idx) expandedStepIndex--;
        renderTimeline();
      });
    });

    // Step form input change handlers
    attachStepFormHandlers();
  }

  function testStep(idx, sourceBtn) {
    var step = currentSteps[idx];
    if (!step) return;
    collectStepData();
    step = currentSteps[idx];
    setStatus('Testing step...');
    withBusy(sourceBtn, apiPost('/scenes/api/test-step', step).then(function(j) {
      setStatus(j.success ? 'Step OK' : ('Step failed: ' + (j.error || '')));
      if (!j.success) toast('Step failed: ' + (j.error || 'Unknown'), 'danger');
    }).catch(function(e) { setStatus('Error: ' + e.message); toast('Error: ' + e.message, 'danger'); }));
  }

  // ============ STEP FORMS ============
  function renderStepForm(step, idx) {
    var t = step.type || '';
    var html = '';

    switch (t) {
      case 'servo': html = renderServoForm(step, idx); break;
      case 'motor': html = renderMotorForm(step, idx); break;
      case 'linear-actuator': html = renderActuatorForm(step, idx); break;
      case 'light': case 'led': html = renderLightForm(step, idx); break;
      case 'audio': html = renderAudioForm(step, idx); break;
      case 'sayThis': html = renderSayThisForm(step, idx); break;
      case 'askAI': html = renderAskAIForm(step, idx); break;
      case 'wait': html = renderWaitForm(step, idx); break;
      case 'pose': html = renderPoseForm(step, idx); break;
      case 'sensor': html = renderSensorForm(step, idx); break;
      case 'goblin-video': html = renderGoblinForm(step, idx); break;
      case 'jaw-animation': html = renderJawAnimForm(step, idx); break;
      case 'head-tracking': html = renderHeadTrackForm(step, idx); break;
      default: html = '<div class="text-muted">Unknown step type: ' + escHtml(t) + '</div>'; break;
    }

    // Concurrent toggle (for all types)
    html += '<label class="mb-check mt-2" for="conc' + idx + '">';
    html += '<input title="Run this step at the same time as the next step" class="sf-input" type="checkbox" data-idx="' + idx + '" data-field="concurrent" id="conc' + idx + '"' + (step.concurrent ? ' checked' : '') + '>';
    html += '<span class="mb-text-sm">Run with next step</span>';
    html += '</label>';

    return html;
  }

  function renderServoForm(step, idx) {
    var servos = allParts.filter(function(p) { return p.type === 'servo' && p.enabled; });
    var html = '<div class="row g-2">';
    html += '<div class="col-6"><label class="mb-field-label">Servo</label>';
    html += '<select title="Select the hardware part for this step" class="mb-select sf-input" data-idx="' + idx + '" data-field="partId">';
    html += '<option value="">Select...</option>';
    servos.forEach(function(p) {
      html += '<option value="' + p.id + '"' + (String(step.partId) === String(p.id) ? ' selected' : '') + '>' + escHtml(p.name) + '</option>';
    });
    html += '</select></div>';
    html += '<div class="col-6"><label class="mb-field-label">Mode</label>';
    html += '<select title="Choose a saved preset or set values manually" class="mb-select sf-input" data-idx="' + idx + '" data-field="usePreset">';
    html += '<option value="false"' + (!step.usePreset ? ' selected' : '') + '>Manual</option>';
    html += '<option value="true"' + (step.usePreset ? ' selected' : '') + '>Preset</option>';
    html += '</select></div>';
    if (!step.usePreset) {
      // A multi-turn (geared) output declares its real travel in
      // config.rotationRangeDeg (e.g. 900 for the knight's neck); the executor
      // and hardware layer already take real degrees, so the input must not
      // cap every servo at 180. Re-render on partId change keeps this current.
      var selServo = servos.find(function(p) { return String(step.partId) === String(p.id); });
      var servoMaxDeg = (selServo && selServo.config && Number(selServo.config.rotationRangeDeg) > 0)
        ? Number(selServo.config.rotationRangeDeg) : 180;
      html += '<div class="col-6"><label class="mb-field-label">Angle</label>';
      html += '<input type="number" title="Target angle in degrees (0-' + servoMaxDeg + ')" class="mb-input sf-input" data-idx="' + idx + '" data-field="angle" value="' + (step.angle != null ? step.angle : 90) + '" min="0" max="' + servoMaxDeg + '"></div>';
      html += '<div class="col-6"><label class="mb-field-label">Duration (ms)</label>';
      html += '<input type="number" title="Movement duration in milliseconds" class="mb-input sf-input" data-idx="' + idx + '" data-field="duration" value="' + (step.duration || 1000) + '" min="0"></div>';
    } else {
      html += '<div class="col-12"><label class="mb-field-label">Preset</label>';
      html += '<select title="Select a saved preset" class="mb-select sf-input" data-idx="' + idx + '" data-field="presetName">';
      html += '<option value="__MIN__"' + (step.presetName === '__MIN__' ? ' selected' : '') + '>Min</option>';
      html += '<option value="__MAX__"' + (step.presetName === '__MAX__' ? ' selected' : '') + '>Max</option>';
      if (step.partId && calibrationProfiles[step.partId] && calibrationProfiles[step.partId].presets) {
        calibrationProfiles[step.partId].presets.forEach(function(pr) {
          html += '<option value="' + escHtml(pr.name) + '"' + (step.presetName === pr.name ? ' selected' : '') + '>' + escHtml(pr.name) + '</option>';
        });
      }
      html += '</select></div>';
    }
    html += '</div>';
    return html;
  }

  function renderMotorForm(step, idx) {
    var motors = allParts.filter(function(p) { return p.type === 'motor' && p.enabled; });
    var html = '<div class="row g-2">';
    html += '<div class="col-12"><label class="mb-field-label">Motor</label>';
    html += '<select title="Select the hardware part for this step" class="mb-select sf-input" data-idx="' + idx + '" data-field="partId"><option value="">Select...</option>';
    motors.forEach(function(p) {
      html += '<option value="' + p.id + '"' + (String(step.partId) === String(p.id) ? ' selected' : '') + '>' + escHtml(p.name) + '</option>';
    });
    html += '</select></div>';
    html += '<div class="col-4"><label class="mb-field-label">Direction</label>';
    html += '<select title="Select the movement direction" class="mb-select sf-input" data-idx="' + idx + '" data-field="direction">';
    html += '<option value="forward"' + (step.direction === 'forward' ? ' selected' : '') + '>Forward</option>';
    html += '<option value="backward"' + (step.direction === 'backward' ? ' selected' : '') + '>Backward</option>';
    html += '</select></div>';
    html += '<div class="col-4"><label class="mb-field-label">Speed %</label>';
    html += '<input type="number" title="Motor speed as a percentage" class="mb-input sf-input" data-idx="' + idx + '" data-field="speed" value="' + (step.speed || 50) + '" min="0" max="100"></div>';
    html += '<div class="col-4"><label class="mb-field-label">Duration</label>';
    html += '<input type="number" title="Movement duration in milliseconds" class="mb-input sf-input" data-idx="' + idx + '" data-field="duration" value="' + (step.duration || 1000) + '" min="0"></div>';
    html += '</div>';
    return html;
  }

  function renderActuatorForm(step, idx) {
    var acts = allParts.filter(function(p) { return p.type === 'linear_actuator' && p.enabled; });
    var html = '<div class="row g-2">';
    html += '<div class="col-12"><label class="mb-field-label">Actuator</label>';
    html += '<select title="Select the hardware part for this step" class="mb-select sf-input" data-idx="' + idx + '" data-field="partId"><option value="">Select...</option>';
    acts.forEach(function(p) {
      html += '<option value="' + p.id + '"' + (String(step.partId) === String(p.id) ? ' selected' : '') + '>' + escHtml(p.name) + '</option>';
    });
    html += '</select></div>';
