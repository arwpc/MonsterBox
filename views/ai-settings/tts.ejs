<div class="container-fluid">
    <header class="mb-page-header">
        <h1 class="mb-page-header-title">
            <i class="bi bi-megaphone"></i> Text-to-Speech
            <span class="mb-text-secondary">· voice assignment and tuning</span>
        </h1>
        <div class="mb-page-header-actions">
            <a href="/ai-settings" class="mb-btn mb-btn-secondary mb-btn-sm" title="Back to AI Settings">
                <i class="bi bi-arrow-left"></i> AI Settings
            </a>
            <!-- This one plays nothing anywhere: it only proves the API key and the
                 assigned voice work. Named for what it checks, not for "test". -->
            <button class="mb-btn mb-btn-secondary mb-btn-sm" id="testTTS"
                title="Check the ElevenLabs API and the assigned voice respond. Generates a short clip on the server and plays no audio.">
                <i class="bi bi-plug"></i> Check API &amp; Voice
            </button>
        </div>
    </header>

    <!-- Character Voice Assignment Banner -->
    <div class="mb-alert mb-alert-info mb-3" id="ttsCharacterBanner">
        <div class="mb-row-sm align-items-center">
            <span><i class="bi bi-person-badge"></i> <strong>Assigning voice to:</strong>
                <span id="ttsCharacterName">Loading...</span></span>
            <span class="mb-text-muted mb-hide-sm">|</span>
            <span><i class="bi bi-volume-up"></i> Current voice:
                <strong id="ttsCurrentVoiceName">Loading...</strong></span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Voice Selection + Settings -->
        <div class="col-lg-8">
            <div class="mb-panel">
                <div class="mb-panel-header">
                    <h2 class="mb-panel-title">
                        <i class="bi bi-gear"></i> Voice Assignment &amp; Configuration
                    </h2>
                </div>
                <div class="mb-panel-body">
                    <form id="ttsConfigForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="ttsModel" class="mb-field-label">TTS Model</label>
                                    <select class="mb-select" id="ttsModel" name="model" title="Select the text-to-speech model">
                                        <option value="eleven_v3">Eleven v3 (Most Expressive)</option>
                                        <option value="eleven_flash_v2_5">Eleven Flash v2.5 (Fastest)</option>
                                        <option value="eleven_multilingual_v2">Eleven Multilingual v2</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="defaultVoice" class="mb-field-label"><i class="bi bi-person-badge"></i> Character Voice</label>
                                    <select class="mb-select" id="defaultVoice" name="voice_id" title="Voice for text-to-speech output">
                                        <option value="">Loading voices...</option>
                                    </select>
                                    <small class="mb-field-hint">This voice will be used for all TTS output for this character</small>
                                </div>
                            </div>
                        </div>

                        <!-- Voice Settings -->
                        <h3 class="ai-subhead">Voice Settings</h3>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="stability" class="mb-field-label">Stability</label>
                                    <input type="range" class="mb-range" id="stability" name="stability" min="0"
                                        max="1" step="0.1" value="0.5" title="Voice stability setting">
                                    <div class="ai-range-ends">
                                        <small class="mb-field-hint">Variable</small>
                                        <small class="mb-field-hint">Stable</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="similarityBoost" class="mb-field-label">Similarity Boost</label>
                                    <input type="range" class="mb-range" id="similarityBoost" name="similarity_boost" title="Voice similarity boost setting"
                                        min="0" max="1" step="0.1" value="0.5">
                                    <div class="ai-range-ends">
                                        <small class="mb-field-hint">Low</small>
                                        <small class="mb-field-hint">High</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Style and Speaker Boost are ignored by Eleven v3. When v3 is
                             selected, ai-settings-tts.js adds .ai-inactive here and disables
                             both controls, so the UI stops implying they will do something. -->
                        <div class="row" id="legacyVoiceSettings">
                            <div class="col-12">
                                <div class="mb-alert mb-alert-warning ai-hidden" id="v3SettingsNote">
                                    <i class="bi bi-info-circle"></i>
                                    <strong>Disabled for Eleven v3.</strong>
                                    v3 takes its expressiveness from audio tags and punctuation in the
                                    text, and ignores Style and Speaker Boost entirely. Switch to
                                    Flash v2.5 or Multilingual v2 to use them.
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="style" class="mb-field-label">Style</label>
                                    <input type="range" class="mb-range" id="style" name="style" min="0" max="1"
                                        step="0.1" value="0.0" title="Voice style expressiveness">
                                    <div class="ai-range-ends">
                                        <small class="mb-field-hint">Natural</small>
                                        <small class="mb-field-hint">Expressive</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label class="mb-switch">
                                        <input type="checkbox" id="speakerBoost" title="Use speaker boost"
                                            name="use_speaker_boost" checked>
                                        <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
                                        <span>Use Speaker Boost</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="mb-btn mb-btn-primary" title="Save TTS configuration">
                                <i class="bi bi-check-circle"></i> Save Configuration
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Speaker Integration -->
            <div class="mb-panel mt-4">
                <div class="mb-panel-header">
                    <h2 class="mb-panel-title">
                        <i class="bi bi-link-45deg"></i> Speaker Integration
                    </h2>
                </div>
                <div class="mb-panel-body">
                    <div class="ai-field">
                        <label for="speakerPart" class="mb-field-label">Select Speaker Part</label>
                        <select class="mb-select" id="speakerPart" title="Select the speaker hardware part">
                            <option value="">Loading speaker parts...</option>
                        </select>
                    </div>
                    <div class="d-grid">
                        <!-- The only button on this page that makes the animatronic
                             itself make a noise. Say so. -->
                        <button type="button" class="mb-btn mb-btn-primary" id="testSpeakerIntegration"
                            title="Speak a test line out loud on the animatronic's own speaker in the room">
                            <i class="bi bi-megaphone"></i> Play Out Loud on Character Speaker
                        </button>
                    </div>
                    <small class="ai-destination">
                        <i class="bi bi-volume-up"></i> Sound comes out of the animatronic in the room — not this browser.
                    </small>
                </div>
            </div>

            <!-- Voice Cloning -->
            <div class="mb-panel mt-4">
                <div class="mb-panel-header">
                    <h2 class="mb-panel-title">
                        <i class="bi bi-person-plus"></i> Voice Cloning
                    </h2>
                </div>
                <div class="mb-panel-body">
                    <p class="mb-text-secondary mb-text-sm">Clone custom voices from audio samples</p>
                    <div class="d-grid">
                        <button type="button" class="mb-btn mb-btn-ai" data-bs-toggle="modal"
                            data-bs-target="#voiceCloningModal" title="Open voice cloning dialog">
                            <i class="bi bi-plus-circle"></i> Clone Voice
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Sticky Voice Preview + Voice Library -->
        <div class="col-lg-4">
            <div class="ai-sticky">
                <div class="mb-panel mb-panel-accent-warning mb-3">
                    <div class="mb-panel-header">
                        <h2 class="mb-panel-title">
                            <i class="bi bi-headphones"></i> Browser Preview
                        </h2>
                    </div>
                    <div class="mb-panel-body">
                        <div class="ai-field">
                            <label for="testText" class="mb-field-label">Test Text</label>
                            <textarea class="mb-textarea mb-serif" id="testText" rows="3" title="Text to convert to speech"
                                placeholder="Enter text to convert to speech...">Hello! This is a test of the ElevenLabs text-to-speech system. How does this voice sound?</textarea>
                        </div>
                        <div class="ai-field">
                            <label for="testVoice" class="mb-field-label">Preview Voice</label>
                            <select class="mb-select" id="testVoice" title="Voice to preview">
                                <option value="">Use character voice</option>
                            </select>
                        </div>
                        <div class="d-grid gap-2">
                            <!-- Plays in THIS browser via the audio element below. -->
                            <button type="button" class="mb-btn mb-btn-secondary" id="generateSpeech"
                                title="Generate the clip and play it here in your browser. The animatronic stays silent.">
                                <i class="bi bi-play-circle"></i> Preview in This Browser
                            </button>
                        </div>
                        <small class="ai-destination">
                            <i class="bi bi-laptop"></i> Sound comes out of the device you are reading this on.
                        </small>
                        <!-- Audio Player -->
                        <div id="audioPlayer" class="mt-3 ai-hidden">
                            <audio controls class="w-100">
                                Your browser does not support the audio element.
                            </audio>
                        </div>
                    </div>
                </div>

                <!-- Voice Library -->
                <div class="mb-panel">
                    <div class="mb-panel-header">
                        <h2 class="mb-panel-title">
                            <i class="bi bi-collection"></i> Voice Library
                        </h2>
                    </div>
                    <div class="mb-panel-body ai-voice-library">
                        <div id="voiceLibrary">
                            <div class="mb-empty">
                                <span class="mb-spinner"></span>
                                <p class="mb-empty-body">Loading voices...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Voice Cloning Modal — kept on Bootstrap's modal plumbing because
         ai-settings-tts.js closes it through bootstrap.Modal.getInstance().
         Its controls are design-system components. -->
    <div class="modal fade" id="voiceCloningModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-plus"></i> Clone Voice
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" title="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="voiceCloningForm">
                        <div class="ai-field">
                            <label for="voiceName" class="mb-field-label">Voice Name</label>
                            <input type="text" class="mb-input" id="voiceName" name="name" required title="Name for the cloned voice">
                        </div>
                        <div class="ai-field">
                            <label for="voiceDescription" class="mb-field-label">Description</label>
                            <textarea class="mb-textarea" id="voiceDescription" name="description" rows="2" title="Description of the cloned voice"></textarea>
                        </div>
                        <div class="ai-field">
                            <label for="audioSamples" class="mb-field-label">Audio Samples</label>
                            <input type="file" class="mb-input" id="audioSamples" name="files" multiple
                                accept="audio/*" title="Upload audio samples to clone">
                            <small class="mb-field-hint">Upload 3-5 audio samples (WAV, MP3) of the voice you want to clone</small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="mb-btn mb-btn-secondary" data-bs-dismiss="modal" title="Cancel voice cloning">Cancel</button>
                    <button type="button" class="mb-btn mb-btn-ai" id="cloneVoice" title="Clone voice from samples">
                        <i class="bi bi-upload"></i> Clone Voice
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>
