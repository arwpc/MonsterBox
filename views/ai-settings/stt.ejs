<div class="container-fluid">
    <header class="mb-page-header">
        <h1 class="mb-page-header-title">
            <i class="bi bi-mic"></i> Speech-to-Text
            <span class="mb-text-secondary">· microphone and recognition model</span>
        </h1>
        <div class="mb-page-header-actions">
            <a href="/ai-settings" class="mb-btn mb-btn-secondary mb-btn-sm" title="Back to AI Settings">
                <i class="bi bi-arrow-left"></i> AI Settings
            </a>
        </div>
    </header>

    <!-- Character Banner -->
    <div class="mb-alert mb-alert-info mb-3" id="sttCharacterBanner">
        <i class="bi bi-person-badge"></i> <strong>Currently tuning:</strong>
        <span id="sttCharacterName">Loading...</span>
    </div>

    <div class="row g-4">
        <!-- Left Column: STT Configuration -->
        <div class="col-lg-8">

            <!-- Real-time Transcription - THE MOST IMPORTANT FEATURE -->
            <div class="mb-panel mb-panel-accent mb-4">
                <div class="mb-panel-header">
                    <h2 class="mb-panel-title">
                        <i class="bi bi-mic-fill"></i> Real-time Transcription
                    </h2>
                </div>
                <div class="mb-panel-body">
                    <div class="mb-row">
                        <button type="button" class="mb-btn mb-btn-primary mb-btn-lg" id="startListening" title="Start real-time transcription from the character's microphone">
                            <i class="bi bi-record-circle"></i> Start Listening
                        </button>
                        <!-- Deliberately NOT disabled: ai-settings-stt.js keeps this
                             clickable so a stuck session can always be torn down, and
                             only styles it as inert. Same behaviour, no inline style. -->
                        <button type="button" class="mb-btn mb-btn-danger mb-btn-lg ai-btn-inert" id="stopListening" title="Stop real-time transcription">
                            <i class="bi bi-stop-circle"></i> Stop Listening
                        </button>
                        <button type="button" class="mb-btn mb-btn-secondary mb-btn-lg" id="sttTwoSecTest" title="Run a 2-second microphone test">
                            <i class="bi bi-mic-fill"></i> 2s Test
                        </button>
                    </div>
                </div>
            </div>

            <!-- Browser Audio Bridge -->
            <div class="mb-panel mb-4">
                <div class="mb-panel-header">
                    <h2 class="mb-panel-title">
                        <i class="bi bi-headset"></i> Browser Audio Bridge
                    </h2>
                </div>
                <div class="mb-panel-body">
                    <p class="mb-text-secondary mb-text-sm">
                        Listen to the character's microphone through your browser speaker, or speak through your browser microphone to the character's speaker.
                    </p>
                    <div class="row g-3">
                        <!-- Listen In: Browser Speaker -->
                        <div class="col-md-6">
                            <div class="mb-panel mb-panel-accent">
                                <div class="mb-panel-header">
                                    <h3 class="mb-panel-title"><i class="bi bi-headphones"></i> Listen In (Browser Speaker)</h3>
                                </div>
                                <div class="mb-panel-body">
                                    <p class="mb-text-secondary mb-text-sm">Hear what the character's microphone picks up through your browser.</p>
                                    <div class="ai-field">
                                        <label for="stt-listenin-source" class="mb-field-label">Source Microphone</label>
                                        <select id="stt-listenin-source" class="mb-select" title="Source microphone to listen in on">
                                            <option value="default">System Default Input</option>
                                        </select>
                                    </div>
                                    <div class="ai-field">
                                        <label for="stt-listenin-volume" class="mb-field-label">Browser Volume</label>
                                        <input type="range" id="stt-listenin-volume" class="mb-range" min="0" max="100" value="75" step="5" title="Browser playback volume">
                                    </div>
                                    <div class="ai-meter-row mb-2">
                                        <div class="mb-meter">
                                            <div id="stt-listenin-vu" class="mb-meter-fill"></div>
                                        </div>
                                        <span id="stt-listenin-vu-label" class="mb-badge ai-meter-label mb-mono">0%</span>
                                    </div>
                                    <div class="mb-row-sm align-items-center">
                                        <button id="btn-stt-listenin" class="mb-btn mb-btn-secondary mb-btn-sm" type="button" title="Start listening through browser speaker">
                                            <i class="bi bi-headphones"></i> <span id="stt-listenin-text">Start Listening</span>
                                        </button>
                                        <span id="stt-listenin-status" class="mb-badge mb-mono">Off</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Talk Through: Browser Mic -->
                        <div class="col-md-6">
                            <div class="mb-panel mb-panel-accent-warning">
                                <div class="mb-panel-header">
                                    <h3 class="mb-panel-title"><i class="bi bi-mic-fill"></i> Talk Through (Browser Mic)</h3>
                                </div>
                                <div class="mb-panel-body">
                                    <p class="mb-text-secondary mb-text-sm">Speak into your browser mic and hear it through the character's speaker.</p>
                                    <div class="ai-field">
                                        <label for="stt-talkthrough-sink" class="mb-field-label">Target Speaker</label>
                                        <select id="stt-talkthrough-sink" class="mb-select" title="Target speaker for talk-through">
                                            <option value="default">System Default Output</option>
                                        </select>
                                    </div>
                                    <div class="ai-meter-row mb-2">
                                        <div class="mb-meter">
                                            <div id="stt-talkthrough-vu" class="mb-meter-fill"></div>
                                        </div>
                                        <span id="stt-talkthrough-vu-label" class="mb-badge ai-meter-label mb-mono">0%</span>
                                    </div>
                                    <div class="mb-row-sm align-items-center">
                                        <button id="btn-stt-talkthrough" class="mb-btn mb-btn-secondary mb-btn-sm" type="button" title="Talk through the character speaker">
                                            <i class="bi bi-mic-fill"></i> <span id="stt-talkthrough-text">Start Talking</span>
                                        </button>
                                        <span id="stt-talkthrough-status" class="mb-badge mb-mono">Off</span>
                                    </div>
                                    <div id="stt-talkthrough-https-warn" class="mb-alert mb-alert-warning mb-text-sm mt-2 d-none">
                                        <i class="bi bi-shield-lock"></i> Browser microphone requires HTTPS or localhost.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- STT Configuration -->
            <div class="mb-panel">
                <div class="mb-panel-header">
                    <h2 class="mb-panel-title">
                        <i class="bi bi-gear"></i> STT Configuration
                    </h2>
                </div>
                <div class="mb-panel-body">
                    <!-- Filter Presets -->
                    <div class="mb-alert mb-alert-info mb-4">
                        <div>
                            <div class="mb-2"><i class="bi bi-magic"></i> <strong>Quick Presets</strong></div>
                            <div class="row g-2" id="filterPresets">
                                <div class="col-12 mb-text-muted mb-text-sm">Loading presets...</div>
                            </div>
                        </div>
                    </div>

                    <form id="sttConfigForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="sttModel" class="mb-field-label">STT Model</label>
                                    <select class="mb-select" id="sttModel" name="model" title="Select the speech-to-text model">
                                        <option value="">Loading models...</option>
                                    </select>
                                    <small class="mb-field-hint">
                                        <i class="bi bi-info-circle"></i> <strong>Scribe v2</strong> is recommended for
                                        best accuracy and multilingual support
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="sttLanguage" class="mb-field-label">Language</label>
                                    <select class="mb-select" id="sttLanguage" name="language" title="Language for speech recognition">
                                        <option value="en">English (Recommended)</option>
                                        <option value="es">Spanish</option>
                                        <option value="fr">French</option>
                                        <option value="de">German</option>
                                        <option value="it">Italian</option>
                                        <option value="pt">Portuguese</option>
                                        <option value="auto">Auto-detect (May transcribe in other languages)</option>
                                    </select>
                                    <small class="mb-field-hint">
                                        <i class="bi bi-exclamation-triangle"></i> Auto-detect may transcribe background
                                        noise as foreign languages
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <span class="mb-field-label">Voice Activity Detection (VAD)</span>
                                    <label class="mb-switch">
                                        <input type="checkbox" id="vadEnabled" title="Enable voice activity detection"
                                            name="vadEnabled" checked>
                                        <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
                                        <span>Enable VAD</span>
                                    </label>
                                    <small class="mb-field-hint">Automatically detect when speech starts/stops</small>
                                </div>
                            </div>
                        </div>

                        <!-- Microphone Hardware Section -->
                        <hr class="ai-rule">
                        <h3 class="ai-subhead"><i class="bi bi-mic"></i> Microphone Hardware</h3>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="ai-field">
                                    <label for="microphonePart" class="mb-field-label">Microphone Part</label>
                                    <select class="mb-select" id="microphonePart" title="Select the microphone hardware">
                                        <option value="">Loading microphone parts...</option>
                                    </select>
                                    <small class="mb-field-hint">Select the microphone hardware for this character</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="ai-field">
                                    <label for="inputGain" class="mb-field-label">Input Gain <span id="inputGainLabel" class="mb-badge mb-mono">100%</span></label>
                                    <input type="range" class="mb-range" id="inputGain" min="0" max="200" step="1" title="Adjust microphone input gain"
                                        value="100">
                                    <small class="mb-field-hint">Adjusted via PipeWire/PulseAudio (applies immediately)</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="ai-field">
                                    <span class="mb-field-label">Round-trip check</span>
                                    <button type="button" class="mb-btn mb-btn-secondary mb-btn-block"
                                        id="testMicrophoneIntegration" title="Record from the character microphone and transcribe it">
                                        <i class="bi bi-arrow-repeat"></i> Test Microphone &rarr; STT
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- VAD Tuning Section -->
                        <hr class="ai-rule">
                        <h3 class="ai-subhead"><i class="bi bi-activity"></i> Voice Activity Detection (VAD) Tuning</h3>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="vadThreshold" class="mb-field-label">
                                        VAD Threshold:
                                        <span id="vadThresholdValue" class="mb-mono">0.40</span>
                                        <span id="vadThresholdLabel" class="mb-text-muted ai-hidden">40%</span>
                                    </label>
                                    <input type="range" class="mb-range" id="vadThreshold" name="vadThreshold" title="Voice activity detection threshold"
                                        min="0.05" max="0.95" step="0.05" value="0.40">
                                    <small class="mb-field-hint">Lower = more sensitive (may pick up noise). Tune while
                                        watching VU meter.</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="vadSilenceDuration" class="mb-field-label">
                                        Silence Duration: <span id="vadSilenceDurationValue" class="mb-mono">500</span>ms
                                    </label>
                                    <input type="range" class="mb-range" id="vadSilenceDuration" title="Silence duration before ending speech"
                                        name="vadSilenceDuration" min="100" max="2000" step="100" value="500">
                                    <small class="mb-field-hint">How long to wait before ending speech</small>
                                </div>
                            </div>
                        </div>

                        <!-- Audio Filtering Section -->
                        <hr class="ai-rule">
                        <h3 class="ai-subhead"><i class="bi bi-soundwave"></i> Audio Filtering</h3>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <span class="mb-field-label">Audio Preprocessing</span>
                                    <label class="mb-switch">
                                        <input type="checkbox" id="audioFilterEnabled" title="Enable bandpass and denoise filters"
                                            name="audioFilterEnabled" checked>
                                        <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
                                        <span>Enable Bandpass &amp; Denoise Filters</span>
                                    </label>
                                    <small class="mb-field-hint">Removes background noise and non-speech frequencies</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="highpassFreq" class="mb-field-label">
                                        Highpass Filter: <span id="highpassFreqValue" class="mb-mono">180</span>Hz
                                    </label>
                                    <input type="range" class="mb-range" id="highpassFreq" name="highpassFreq" title="Highpass filter cutoff frequency"
                                        min="50" max="500" step="50" value="180">
                                    <small class="mb-field-hint">Remove low-frequency rumble</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="lowpassFreq" class="mb-field-label">
                                        Lowpass Filter: <span id="lowpassFreqValue" class="mb-mono">4200</span>Hz
                                    </label>
                                    <input type="range" class="mb-range" id="lowpassFreq" name="lowpassFreq" title="Lowpass filter cutoff frequency"
                                        min="2000" max="8000" step="200" value="4200">
                                    <small class="mb-field-hint">Remove high-frequency hiss</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="denoiseLevel" class="mb-field-label">
                                        Denoise Level: <span id="denoiseLevelValue" class="mb-mono">-22</span>dB
                                    </label>
                                    <input type="range" class="mb-range" id="denoiseLevel" name="denoiseLevel" title="Noise reduction strength"
                                        min="-50" max="-10" step="5" value="-22">
                                    <small class="mb-field-hint">Noise reduction strength</small>
                                </div>
                            </div>
                        </div>

                        <!-- Text Filtering Section -->
                        <hr class="ai-rule">
                        <h3 class="ai-subhead"><i class="bi bi-filter"></i> Text Filtering</h3>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <span class="mb-field-label">Sound Effects Filtering</span>
                                    <label class="mb-switch">
                                        <input type="checkbox" id="filterSfx" name="filterSfx" title="Filter bracketed sound effects"
                                            checked>
                                        <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
                                        <span>Filter Bracketed Sound Effects</span>
                                    </label>
                                    <small class="mb-field-hint">Remove transcriptions like "(beep)", "(music)", etc.</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <span class="mb-field-label">Language Validation</span>
                                    <label class="mb-switch">
                                        <input type="checkbox" id="validateEnglish" title="Validate transcriptions are English"
                                            name="validateEnglish" checked>
                                        <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
                                        <span>Validate English Text</span>
                                    </label>
                                    <small class="mb-field-hint">Reject non-English or gibberish transcriptions</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <label for="minLetterRatio" class="mb-field-label">
                                        Min Letter Ratio: <span id="minLetterRatioValue" class="mb-mono">55</span>%
                                    </label>
                                    <input type="range" class="mb-range" id="minLetterRatio" name="minLetterRatio" title="Minimum percentage of letters in text"
                                        min="30" max="90" step="5" value="55">
                                    <small class="mb-field-hint">Minimum percentage of letters in text</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ai-field">
                                    <span class="mb-field-label">Require Vowels</span>
                                    <label class="mb-switch">
                                        <input type="checkbox" id="requireVowels" title="Require at least one vowel"
                                            name="requireVowels" checked>
                                        <span class="mb-switch-track"><span class="mb-switch-thumb"></span></span>
                                        <span>Require At Least One Vowel</span>
                                    </label>
                                    <small class="mb-field-hint">Reject consonant-only gibberish</small>
                                </div>
                            </div>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="mb-btn mb-btn-primary" title="Save STT configuration">
                                <i class="bi bi-check-circle"></i> Save Configuration
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div><!-- end col-lg-8 -->

        <!-- Right Column: Sticky Transcript + VU Meter -->
        <div class="col-lg-4">
            <div class="ai-sticky">
                <div class="mb-panel mb-panel-accent mb-3">
                    <div class="mb-panel-header">
                        <h2 class="mb-panel-title">
                            <i class="bi bi-activity"></i> Live Transcript
                        </h2>
                    </div>
                    <div class="mb-panel-body">
                        <div class="ai-meter-row mb-2">
                            <small class="mb-text-muted"
                                title="Amplified 10x for visibility. Speak to see levels spike.">
                                <i class="bi bi-activity"></i> Audio Input:
                            </small>
                            <div class="mb-meter mb-meter-lg">
                                <div id="micVUMeter" class="mb-meter-fill" role="progressbar"
                                    aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <span id="micVULabel" class="mb-badge ai-meter-label mb-mono">0%</span>
                        </div>
                        <div id="liveTranscript" class="ai-transcript mb-serif"></div>
                    </div>
                </div>
            </div>
        </div><!-- end col-lg-4 -->

    </div><!-- end row -->
</div>

<!-- STT page logic -->
<script src="/js/ai-settings-stt.js"></script>
