<div class="container-fluid">
  <div class="d-flex justify-content-end mb-2">
    <span class="badge bg-success fs-6"><i class="bi bi-lightning-charge"></i> Live Mode Active</span>
  </div>

  <div class="row">
    <div class="col-12 col-lg-8 mb-3">
      <div class="card">
        <div class="card-header"><h5 class="mb-0"><i class="bi bi-person-arms-up"></i> Quick Poses</h5></div>
        <div class="card-body" id="posesContainer">
          <div class="text-center text-muted">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <div>Loading quick poses…</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-4 mb-3">
      <div class="card">
        <div class="card-header"><h5 class="mb-0"><i class="bi bi-activity"></i> System</h5></div>
        <div class="card-body">
          <button class="mb-btn mb-btn-secondary mb-btn-block" onclick="location.reload()" title="Reload this page to refresh live status"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
          <div id="posesStatus" class="mt-2 small"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async function () {
    try {
      const resp = await fetch('/poses?format=json');
      const data = await resp.json();
      const container = document.getElementById('posesContainer');

      if (!data || !data.success) {
        container.innerHTML = '<div class="mb-alert mb-alert-warning">No poses available</div>';
        document.getElementById('posesStatus').textContent = 'No poses available';
        return;
      }

      const poses = (data.poses || []).slice(0, 12);
      if (poses.length === 0) {
        container.innerHTML = '<div class="mb-alert mb-alert-info">No poses defined. Create some in Setup → Poses.</div>';
        return;
      }

      // Show Mode is used at arm's length, in the dark, one-handed. The whole row is
      // the play target rather than a small icon button beside the name.
      container.innerHTML = poses.map(p => `
        <button class="mb-live-pose" onclick="execPose(${p.id}, this)" title="Play the &quot;${p.name}&quot; pose on the hardware now" aria-label="Play ${p.name}">
          <span class="mb-live-pose-name">${p.name}</span>
          <span class="mb-live-pose-icon"><i class="bi bi-play-fill"></i></span>
        </button>
      `).join('');
    } catch (e) {
      // Keep logging gentle to avoid flaking tests
      console.log('Issue loading quick poses:', (e && e.message) || e);
      const st = document.getElementById('posesStatus');
      if (st) st.textContent = 'Issue loading quick poses';
    }
  });

  async function execPose(id, btn) {
    const st = document.getElementById('posesStatus');
    // A servo move takes 500ms+; without a busy state an unacknowledged tap gets
    // tapped again, and a double tap double-fires the hardware.
    if (btn) btn.setAttribute('data-busy', 'true');
    try {
      const resp = await fetch(`/poses/${id}/execute`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const res = await resp.json();
      if (res.success) {
        if (st) st.textContent = 'Played.';
      } else {
        // Say WHICH parts refused and why — a bare "failed" next to a pose that
        // partly moved tells the operator nothing they can act on.
        const failed = Array.isArray(res.failedParts) ? res.failedParts : [];
        const detail = failed.length
          ? failed.map(f => 'part ' + f.partId + ': ' + (f.error || 'refused')).join(' · ')
          : (res.error || 'no reason given');
        if (st) st.textContent = (res.partialFailure ? 'Played, but ' : 'Did not play — ') + detail;
      }
    } catch (e) {
      if (st) st.textContent = 'Could not reach the animatronic — ' + ((e && e.message) || e);
    } finally {
      if (btn) btn.removeAttribute('data-busy');
    }
  }
</script>
