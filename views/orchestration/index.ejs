<%
// Fleet Command Center (v8.5.0) — a single pane to monitor and run the entire
// network of animatronics. Chrome lives in /css/mb-orchestration.css (wired via
// the `styles` local in routes/orchestration.js); shared components come from
// components.css. Backend: /api/orchestration/* (fleet-health, nodes, superpower,
// emergency-stop, volume, per-node say/ask/audio/auto-ai/webcam-stream).
// See routes/api/orchestrationRoutes.js.
%>

<header class="mb-page-header">
  <h1 class="mb-page-header-title">
    <i class="bi bi-diagram-3"></i> Fleet Command Center
    <span class="mb-text-secondary">· monitor &amp; run the entire MonsterNet from one place</span>
  </h1>
</header>

<!-- ============ STICKY COMMAND BAR ============ -->
<div class="fcc-bar">
  <!-- Mobile-only compact strip. The full toolbar measured 433px of an 844px phone
       viewport -- 51% of the screen, permanently, because .fcc-bar is sticky. It also
       intercepted taps aimed at the cards underneath it. On narrow screens the toolbar
       collapses to this strip; EMERGENCY STOP stays visible at all times because a
       panic control you have to expand a menu to reach is not a panic control. -->
  <div class="fcc-mobile-strip">
    <span class="mb-badge" title="Nodes currently online / total in the fleet">
      <span class="mb-dot mb-dot-idle" id="fleetDotMini"></span>
      <span id="fleetCountMini" class="mb-mono">— / —</span>
    </span>
    <button class="mb-btn mb-btn-sm mb-btn-secondary" id="toolbarToggle" type="button"
      aria-expanded="false" aria-controls="fccBarRows" title="Show or hide the fleet controls">
      <i class="bi bi-sliders"></i> Controls</button>
    <button class="mb-btn mb-btn-sm mb-btn-danger fcc-estop ms-auto" id="estopMini" type="button"
      title="Immediately halt every animatronic">
      <i class="bi bi-exclamation-octagon-fill"></i> STOP</button>
  </div>
  <div id="fccBarRows">
  <div class="fcc-row">
    <!-- Fleet health rollup -->
    <span class="mb-badge" id="fleetPill" title="Nodes currently online / total in the fleet">
      <span class="mb-dot mb-dot-idle" id="fleetDot"></span>
      <span id="fleetCount" class="mb-mono">— / —</span>
    </span>

    <span class="fcc-sep"></span>

    <!-- Fleet superpower masters -->
    <div class="mb-btn-group" role="group" aria-label="Fleet superpowers">
      <button class="mb-btn mb-btn-sm mb-btn-secondary fcc-sp" data-sp="lurk" title="Toggle Lurk mode on every animatronic">Lurk</button>
      <button class="mb-btn mb-btn-sm mb-btn-secondary fcc-sp" data-sp="jaw" title="Toggle jaw animation fleet-wide">Jaw</button>
      <button class="mb-btn mb-btn-sm mb-btn-secondary fcc-sp" data-sp="head" title="Toggle head tracking fleet-wide">Head</button>
        <button class="mb-btn mb-btn-sm mb-btn-secondary fcc-sp" data-sp="aiMotion" title="Toggle AI Motion fleet-wide — the characters move as they speak and obey spoken movement requests">AI Motion</button>
      <button class="mb-btn mb-btn-sm mb-btn-secondary fcc-sp" data-sp="motion" title="Toggle PIR motion sensor fleet-wide">Motion</button>
      <button class="mb-btn mb-btn-sm mb-btn-secondary fcc-sp" data-sp="idle" title="Toggle idle movement loop fleet-wide">Idle</button>
      <button class="mb-btn mb-btn-sm mb-btn-secondary fcc-sp" data-sp="mute" title="Mute / unmute all speakers">Mute</button>
      <button class="mb-btn mb-btn-sm mb-btn-secondary fcc-sp" data-sp="orders" title="Toggle voice orders fleet-wide">Orders</button>
    </div>

    <span class="fcc-sep"></span>

    <!-- Master volume -->
    <span class="mb-row-sm" title="Set master speaker volume on every node">
      <i class="bi bi-volume-up"></i>
      <input type="range" class="mb-range fcc-vol" id="masterVol" min="0" max="100" value="80"
        aria-label="Master fleet volume">
      <span class="mb-text-sm mb-text-secondary fcc-vol-val mb-mono" id="masterVolVal">80%</span>
    </span>

    <span class="fcc-sep"></span>

    <!-- Show transport -->
    <button class="mb-btn mb-btn-sm mb-btn-primary" id="startLoops" title="Start each node's default scene queue loop">
      <i class="bi bi-play-fill"></i> Start Loops</button>
    <button class="mb-btn mb-btn-sm mb-btn-secondary" id="stopLoops" title="Stop all scene queue loops across the fleet">
      <i class="bi bi-stop-fill"></i> Stop Loops</button>

    <!-- Panic -->
    <button class="mb-btn mb-btn-sm mb-btn-danger fcc-estop ms-auto" id="estop"
      title="Immediately halt every animatronic: stop queues, stop audio, disable random poses, mute">
      <i class="bi bi-exclamation-octagon-fill"></i> EMERGENCY STOP</button>
  </div>

  <div class="fcc-row">
    <!-- Say to all -->
    <!-- One box, two behaviours. "say <words>" speaks those exact words. Anything else
         is handed to each animatronic's ElevenLabs agent as an instruction, and the
         agents are already well enough developed to interpret it in character. -->
    <div class="mb-input-group fcc-say">
      <input type="text" class="mb-input mb-serif" id="sayAllText"
        placeholder="say Welcome to Warner Castle"
        title="Two ways to use this:&#10;  say <words>  — speaks those exact words, quotes optional&#10;  anything else — an instruction for their AI agents to interpret&#10;Examples:&#10;  say Welcome to Warner Castle&#10;  make them all howl at the moon&#10;  everyone greet our guest by name&#10;  run a short welcome ceremony together"
        aria-describedby="promptHint"
        aria-label="Tell the targeted animatronics what to say or do">
      <button class="mb-btn mb-btn-sm mb-btn-secondary" id="sayAllBtn" title="Send to the targeted nodes (all if none selected)">
        <i class="bi bi-megaphone"></i> Send</button>
    </div>
    <div class="fcc-prompt-hint" id="promptHint" aria-live="polite">
      <b>say</b> <i>words</i> speaks them exactly · anything else is an instruction their agents interpret
    </div>

    <span class="fcc-sep"></span>

    <!-- Target scope -->
    <span class="mb-text-sm mb-text-secondary" title="Global actions apply to selected nodes; none selected = all online">
      Target: <span id="targetSummary" class="mb-text-primary">All</span></span>
    <button class="mb-btn mb-btn-sm mb-btn-secondary" id="clearTargets" title="Clear node selection (target all)">Clear</button>

    <span class="fcc-sep"></span>

    <button class="mb-btn mb-btn-sm mb-btn-secondary" id="refreshBtn" title="Refresh fleet health now">
      <i class="bi bi-arrow-clockwise"></i> Refresh</button>
    <button class="mb-btn mb-btn-sm mb-btn-secondary" id="restartSvc" title="Restart the MonsterBox service on targeted nodes">
      <i class="bi bi-arrow-repeat"></i> Restart Services</button>
    <button class="mb-btn mb-btn-sm mb-btn-danger" id="rebootAll" title="Reboot targeted animatronics (SSH)">
      <i class="bi bi-power"></i> Reboot</button>
  </div>
  </div><!-- /#fccBarRows -->
</div>

<!-- ============ NODE WALL ============ -->
<div class="row g-3" id="nodeWall">
  <%
    // Reserve the real grid's footprint before any fetch returns. The old placeholder
    // was a single 177px spinner row, so when the six cards arrived everything below
    // jumped down by 838-3257px depending on viewport (CLS 0.18 desktop / 0.45 tablet,
    // "poor" above 0.25). These skeletons carry the SAME column classes and card
    // height as the real cards, so the swap is close to shift-free. Count comes from
    // the animatronics registry, so adding a seventh animatronic reserves seven.
    const skeletonCount = (typeof nodeCount === 'number' && nodeCount > 0) ? nodeCount : 6;
  %>
  <div class="col-12" id="wallLoading" aria-live="polite" aria-busy="true">
    <span class="mb-spinner"></span>
    <span class="mb-text-sm mb-text-secondary">Loading fleet…</span>
  </div>
  <% for (let i = 0; i < skeletonCount; i++) { %>
  <div class="col-sm-6 col-lg-4 col-xxl-3 fcc-skeleton-col" aria-hidden="true">
    <div class="mb-card fcc-card fcc-skeleton"></div>
  </div>
  <% } %>
</div>

<!-- ============ GOBLINS ============ -->
<div class="mt-4">
  <h2 class="mb-heading-3 mb-text-secondary"><i class="bi bi-tv"></i> Goblins (video displays)</h2>
  <div class="row g-2" id="goblinRow"><div class="col-12 mb-text-sm mb-text-secondary">Loading…</div></div>
</div>

<!-- ============ BOTTOM RAIL: LOG + DISCOVERY ============ -->
<div class="row g-3 mt-3">
  <div class="col-lg-8">
    <section class="mb-panel">
      <div class="mb-panel-header">
        <h2 class="mb-panel-title"><i class="bi bi-terminal"></i> Command Log</h2>
        <button class="mb-btn mb-btn-sm mb-btn-ghost" id="clearLog" title="Clear the command log">Clear</button>
      </div>
      <div class="fcc-log" id="commandLog" role="log" aria-live="polite"></div>
    </section>
  </div>
  <div class="col-lg-4">
    <section class="mb-panel">
      <div class="mb-panel-header">
        <h2 class="mb-panel-title"><i class="bi bi-broadcast"></i> Discovery</h2>
      </div>
      <div class="mb-panel-body">
        <div class="mb-text-sm mb-mono" id="discoveryState">mDNS: <span class="mb-text-secondary">checking…</span></div>
        <div class="mb-text-sm mb-text-secondary mb-mono" id="sourceBreakdown"></div>
        <form id="pinForm" class="fcc-pin-grid mt-3" title="Pin a node by IP for networks that block mDNS multicast">
          <input class="mb-input" id="pinId" placeholder="id" title="Node id" aria-label="Node id">
          <input class="mb-input" id="pinIp" placeholder="IP address" title="Node IP" aria-label="Node IP address">
          <input class="mb-input" id="pinName" placeholder="name" title="Display name" aria-label="Node display name">
          <button class="mb-btn mb-btn-sm mb-btn-secondary mb-btn-block fcc-pin-full" type="submit"
            title="Persist this pinned node (survives restarts)">
            <i class="bi bi-pin-map"></i> Pin node</button>
        </form>
      </div>
    </section>
  </div>
</div>

<!-- Webcam expand modal (Bootstrap-driven; dialog chrome uses design-system tokens) -->
<div class="modal fade" id="fccCamModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2"><h2 class="modal-title mb-heading-3 mb-live" id="fccCamTitle">Webcam</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body p-0"><img id="fccCamModalImg" alt="Live webcam"></div>
    </div>
  </div>
</div>

<!-- Confirmation dialog. Replaces three native browser confirmations, which
     could not be styled, were unusable on a phone, and — worst here — never
     named the machines the command was about to reach. -->
<div class="mb-modal-backdrop" id="fccConfirmBackdrop" hidden></div>
<div class="mb-modal" id="fccConfirm" role="dialog" aria-modal="true" aria-labelledby="fccConfirmTitle" hidden>
  <div class="mb-modal-dialog">
    <div class="mb-modal-header">
      <h2 class="mb-modal-title" id="fccConfirmTitle">Confirm</h2>
    </div>
    <div class="mb-modal-body">
      <p id="fccConfirmBody" class="mb-text-base"></p>
      <p class="mb-field-hint">Targets: <span id="fccConfirmTargets" class="mb-mono"></span></p>
    </div>
    <div class="mb-modal-footer">
      <button type="button" class="mb-btn mb-btn-secondary" id="fccConfirmCancel" title="Cancel — send nothing">Cancel</button>
      <button type="button" class="mb-btn mb-btn-danger" id="fccConfirmOk" title="Send this command to the listed targets">Confirm</button>
    </div>
  </div>
</div>

<div class="mb-toast-region" role="status" aria-live="polite"></div>

<script>
(function () {
  'use strict';
  const API = '/api/orchestration';
  const POLL_MS = 15000;
  const state = { nodes: new Map(), targets: new Set(), avahi: null };

  // ---------- helpers ----------
  const $ = (sel, root) => (root || document).querySelector(sel);
  const el = (tag, cls, html) => { const e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; };
  const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  // Toast, lifted from public/js/mb-control-bar.js so this page speaks the same
  // language as the rest of the app instead of blocking on a native dialog.
  function announce(message, severity) {
    let region = document.querySelector('.mb-toast-region');
    if (!region) {
      region = document.createElement('div');
      region.className = 'mb-toast-region';
      region.setAttribute('role', 'status');
      region.setAttribute('aria-live', 'polite');
      document.body.appendChild(region);
    }
    const toast = document.createElement('div');
    toast.className = 'mb-toast mb-toast-' + (severity || 'warning');
    toast.textContent = message;
    region.appendChild(toast);
    setTimeout(() => { if (toast.parentNode) toast.parentNode.removeChild(toast); }, 4000);
  }

  // Styled replacement for the native browser confirmation. Names the machines the
  // command will reach — "REBOOT?" with no list is a question nobody can answer safely.
  let confirmResolve = null;
  function askConfirm(title, body, targets) {
    $('#fccConfirmTitle').textContent = title;
    $('#fccConfirmBody').textContent = body;
    $('#fccConfirmTargets').textContent = targets;
    $('#fccConfirmBackdrop').hidden = false;
    $('#fccConfirm').hidden = false;
    $('#fccConfirmOk').focus();
    return new Promise(resolve => { confirmResolve = resolve; });
  }
  function closeConfirm(answer) {
    $('#fccConfirmBackdrop').hidden = true;
    $('#fccConfirm').hidden = true;
    if (confirmResolve) { const r = confirmResolve; confirmResolve = null; r(answer); }
  }
  $('#fccConfirmOk').addEventListener('click', () => closeConfirm(true));
  $('#fccConfirmCancel').addEventListener('click', () => closeConfirm(false));
  $('#fccConfirmBackdrop').addEventListener('click', () => closeConfirm(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && confirmResolve) closeConfirm(false); });

  function log(msg, type) {
    const line = el('div', type || 'muted', '<span class="muted">' + new Date().toLocaleTimeString() + '</span> ' + esc(msg));
    const box = $('#commandLog'); box.appendChild(line); box.scrollTop = box.scrollHeight;
    while (box.children.length > 300) box.removeChild(box.firstChild);
  }
  // Per-node failures already travel in results[] and were being thrown away, so
  // "2/5 ok" never said which three failed or why. Print them, named.
  function logNodeFailures(r) {
    if (!r || !Array.isArray(r.results)) return;
    r.results.filter(x => x && x.success === false).forEach(x => {
      const who = x.animatronic || x.goblin || x.id || 'node';
      const line = el('div', 'err detail', '↳ ' + esc(who) + ': ' + esc(x.error || 'failed'));
      const box = $('#commandLog'); box.appendChild(line); box.scrollTop = box.scrollHeight;
    });
  }
  function summarize(r) {
    if (!r) return '';
    if (typeof r.successful === 'number' && typeof r.total === 'number') return r.successful + '/' + r.total + ' ok';
    if (r.online != null && r.total != null) return r.online + '/' + r.total + ' online';
    return r.success ? 'ok' : 'failed';
  }
  async function api(path, opts) {
    const res = await fetch(API + path, Object.assign({ headers: { 'Content-Type': 'application/json' } }, opts));
    let body = null; try { body = await res.json(); } catch (_) {}
    if (!res.ok) throw new Error((body && (body.error || body.message)) || ('HTTP ' + res.status));
    return body;
  }
  // Run non-urgent work once the browser is not busy, with a hard fallback so it
  // always happens even on engines without requestIdleCallback.
  function whenIdle(fn) {
    if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(fn, { timeout: 3000 });
    else setTimeout(fn, 1200);
  }

  function targetIds() { return state.targets.size ? Array.from(state.targets) : undefined; }
  function targetLabel() {
    if (!state.targets.size) return 'All';
    return Array.from(state.targets).map(id => { const n = state.nodes.get(String(id)); return n ? n.name : id; }).join(', ');
  }
  function refreshTargetSummary() { $('#targetSummary').textContent = targetLabel(); }

  // ---------- node cards ----------
  function cardId(id) { return 'node-' + String(id).replace(/[^a-z0-9]/gi, '_'); }

  // ---------- camera wall: snapshots, not six endless streams ----------
  //
  // The wall used to open one live MJPEG <img> per node. An MJPEG response never
  // ends, so six cards permanently held all SIX of the browser's per-host HTTP/1.1
  // connections and every fetch the page made queued behind them. Measured on a node,
  // identical page, the only difference being whether the streams ran:
  //
  //     cameras ON : fleet-health 9146ms max, pill read "1 / 6 online"
  //     cameras OFF: fleet-health 3621ms max, pill read "6 / 6 online"
  //
  // Those nodes were never offline — the health poll just never got a connection in
  // time. The wall now pulls single frames, which release their connection on
  // arrival. The modal still opens a true live stream: one card, one connection.
  const SNAP_MS = 200;                                   // target wall cadence
  const SNAP_BACKOFF = [500, 1000, 2000, 5000, 10000];   // per consecutive failure
  const CAM_RETRY_LIMIT = 3;                             // failures before the card says "no webcam"
  const camTimers = new WeakMap();

  // The loop is CHAINED, never on an interval: the next frame is requested only
  // after the previous one resolves, so a slow node degrades to a lower frame rate
  // instead of piling up requests it will never catch up on.
  function camRunnable(img) {
    return !document.hidden
      && !img.dataset.camOffscreen
      && !img.dataset.camCollapsed
      && img.dataset.camWanted === '1';
  }

  function camSchedule(img, delay) {
    const prev = camTimers.get(img);
    if (prev) clearTimeout(prev);
    camTimers.set(img, setTimeout(function () { camTick(img); }, delay));
  }

  function camTick(img) {
    if (!camRunnable(img)) return;   // camResume() restarts the loop
    const id = img.dataset.camNodeId;
    const off = img.parentNode && img.parentNode.querySelector('.fcc-cam-off');
    const url = API + '/animatronic/' + id + '/webcam-snapshot?_=' + Date.now();

    // Decode offscreen first, then hand the SAME url to the visible <img>. The
    // browser serves it from memory, so the swap never blanks the card.
    const probe = new Image();
    probe.onload = function () {
      if (!camRunnable(img)) return;
      img.src = url;
      img.dataset.camFails = '0';
      delete img.dataset.camGaveUp;
      if (off) off.classList.add('fcc-hidden');
      img.classList.remove('fcc-invisible');
      camSchedule(img, SNAP_MS);
    };
    probe.onerror = function () {
      if (!camRunnable(img)) return;
      const fails = (parseInt(img.dataset.camFails || '0', 10) || 0) + 1;
      img.dataset.camFails = String(fails);
      if (off) {
        off.textContent = fails >= CAM_RETRY_LIMIT
          ? 'No webcam — click to retry'
          : 'Webcam unavailable…';
        off.classList.remove('fcc-hidden');
      }
      if (fails >= CAM_RETRY_LIMIT) img.dataset.camGaveUp = '1';
      img.classList.add('fcc-invisible');
      // Never give up entirely: a snapshot is one small request, so a camera that
      // gets plugged in later heals on its own at the slow end of the backoff.
      camSchedule(img, SNAP_BACKOFF[Math.min(fails - 1, SNAP_BACKOFF.length - 1)]);
    };
    probe.src = url;
  }

  // Cards start their loops staggered rather than all at once. Six simultaneous
  // first-frames landed on top of the page's own fleet-health/nodes/audio calls and
  // pushed them into the connection queue — audio-files measured 6471ms in the
  // browser for work the server finished in 240ms.
  let camStagger = 0;
  function camStart(img, id) {
    img.dataset.camNodeId = String(id);
    img.dataset.camWanted = '1';
    const delay = camStagger;
    camStagger = (camStagger + 120) % 720;
    camSchedule(img, delay);
  }
  function camStop(img) {
    img.dataset.camWanted = '';
    delete img.dataset.camWanted;
    const t = camTimers.get(img);
    if (t) { clearTimeout(t); camTimers.delete(img); }
  }
  function camResume(img) {
    if (img.dataset.camNodeId && camRunnable(img)) camSchedule(img, 0);
  }

  // Live MJPEG — the modal only. One card at a time is one connection, which the
  // per-host pool can always afford.
  function startCam(img, id) { img.src = API + '/animatronic/' + id + '/webcam-stream?_=' + Date.now(); }

  // A hidden tab should cost the yard nothing. Snapshot loops simply stop asking.
  document.addEventListener('visibilitychange', () => {
    document.querySelectorAll('.fcc-cam-wrap img').forEach(img => {
      if (document.hidden) { const t = camTimers.get(img); if (t) clearTimeout(t); }
      else camResume(img);
    });
  });

  // Only pull frames for the cards the operator can actually see. A card scrolled
  // off the bottom of the wall is pure waste — network, decode and yard bandwidth.
  const camVisibility = ('IntersectionObserver' in window) ? new IntersectionObserver((entries) => {
    for (const e of entries) {
      const img = e.target;
      if (e.isIntersecting) { delete img.dataset.camOffscreen; camResume(img); }
      else { img.dataset.camOffscreen = '1'; const t = camTimers.get(img); if (t) clearTimeout(t); }
    }
  }, { rootMargin: '200px' }) : null;   // 200px so a card wakes just before it scrolls in

  function isNarrow() { return window.matchMedia('(max-width: 767.98px)').matches; }

  // Mobile toolbar strip. The real controls live in #fccBarRows; on a phone they start
  // hidden and the strip carries the online count, a Controls toggle, and STOP.
  (function wireMobileToolbar() {
    const toggle = document.getElementById('toolbarToggle');
    const rows = document.getElementById('fccBarRows');
    const estopMini = document.getElementById('estopMini');
    if (toggle && rows) {
      toggle.addEventListener('click', () => {
        const open = rows.classList.toggle('fcc-rows-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
    }
    // Reuse the real handler rather than duplicating panic logic.
    if (estopMini) {
      estopMini.addEventListener('click', () => {
        const real = document.getElementById('estop');
        if (real) real.click();
      });
    }
  })();

  // Keep the compact strip's count in step with the main pill.
  function mirrorFleetPill() {
    const src = document.getElementById('fleetCount');
    const dst = document.getElementById('fleetCountMini');
    if (src && dst) dst.textContent = src.textContent;
    const sd = document.getElementById('fleetDot');
    const dd = document.getElementById('fleetDotMini');
    if (sd && dd) dd.className = sd.className;
  }

  // Roll up the whole lower half of the page on a phone. The operator's words: "super
  // long and mountains of scrolling with no categories that roll up." These three
  // blocks (Goblins, Command Log, Discovery) are reference panels, not things you
  // steer with, so they start closed on narrow screens and stay open on desktop.
  function makeSectionsCollapsible() {
    if (!isNarrow()) return;
    const targets = [
      { head: document.querySelector('#goblinRow')?.closest('.mt-4')?.querySelector('h2'), body: document.querySelector('#goblinRow') },
      { head: document.querySelector('#commandLog')?.closest('.mb-panel')?.querySelector('.mb-panel-title'), body: document.querySelector('#commandLog') },
      { head: document.querySelector('#discoveryState')?.closest('.mb-panel')?.querySelector('.mb-panel-title'), body: document.querySelector('#discoveryState')?.closest('.mb-panel-body') },
    ];
    for (const t of targets) {
      if (!t.head || !t.body || t.head.dataset.collapsible) continue;
      t.head.dataset.collapsible = '1';
      t.head.classList.add('fcc-section-toggle');
      t.head.setAttribute('role', 'button');
      t.head.setAttribute('tabindex', '0');
      t.body.classList.add('fcc-section-body', 'fcc-section-closed');
      t.head.setAttribute('aria-expanded', 'false');
      const toggle = () => {
        const closed = t.body.classList.toggle('fcc-section-closed');
        t.head.setAttribute('aria-expanded', String(!closed));
      };
      t.head.addEventListener('click', toggle);
      t.head.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
      });
    }
  }

  // Collapsing must also stop the stream, and must survive the poll: updateCard()
  // restarts any src-less camera, so without its own flag a collapsed card would
  // quietly keep decoding video behind a hidden panel -- exactly the cost we are
  // trying to remove on a phone.
  function setCardCollapsed(card, collapsed) {
    card.classList.toggle('fcc-collapsed', collapsed);
    const btn = card.querySelector('[data-role="collapse"]');
    if (btn) { btn.setAttribute('aria-expanded', String(!collapsed)); btn.textContent = collapsed ? '\u25B8' : '\u25BE'; }
    const img = card.querySelector('.fcc-cam-wrap img');
    if (!img) return;
    if (collapsed) {
      img.dataset.camCollapsed = '1';
      const t = camTimers.get(img);
      if (t) clearTimeout(t);
    } else {
      delete img.dataset.camCollapsed;
      camResume(img);
    }
  }

  function buildCard(node) {
    const col = el('div', 'col-sm-6 col-lg-4 col-xxl-3');
    col.id = cardId(node.id);
    const card = el('div', 'mb-card fcc-card');

    // header
    const head = el('div', 'fcc-card-head');
    head.innerHTML =
      '<span class="mb-dot ' + (node.online ? 'mb-dot-live' : 'mb-dot-idle') + '" data-role="dot" title="' +
        (node.online ? 'Online' : 'Offline') + '"></span>' +
      '<span class="fcc-card-name mb-serif" title="' + esc(node.name) + '">' + esc(node.name) + '</span>' +
      '<span class="fcc-chip ' + (node.trusted === false ? 'untrusted' : (node.source || 'config')) + '" data-role="chip" title="Discovery source / trust">' +
        (node.trusted === false ? 'untrusted' : (node.source || 'config')) + '</span>' +
      '<label class="mb-check" title="Target this node for global actions">' +
        '<input type="checkbox" data-role="target" aria-label="Target ' + esc(node.name) + '"></label>' +
      '<button class="fcc-collapse-btn" data-role="collapse" type="button" aria-expanded="true" ' +
        'aria-label="Collapse ' + esc(node.name) + '" title="Collapse / expand this node">\u25BE</button>';
    card.appendChild(head);

    // On a phone the six cards stacked to 3434px -- the whole page was 5164px, about
    // six full screens of scrolling with nothing that rolled up. Cards now start
    // COLLAPSED on narrow viewports: the header row still carries name, status dot and
    // discovery chip, and one tap opens the camera and controls. Desktop is unchanged.
    if (isNarrow()) card.classList.add('fcc-collapsed');
    const collapseBtn = head.querySelector('[data-role="collapse"]');
    collapseBtn.onclick = function (ev) {
      ev.stopPropagation();
      setCardCollapsed(card, !card.classList.contains('fcc-collapsed'));
    };

    // Double-click the node's name → that node's own dashboard in a new tab.
    // The IP is resolved at click time from state, not from this closure: mDNS
    // discovery can overlay a fresh IP onto a card built while the node was
    // still offline, and the closure would hold the stale null.
    const nameEl = head.querySelector('.fcc-card-name');
    nameEl.classList.add('fcc-name-link');
    nameEl.title = node.name + " — double-click to open this node's dashboard";
    nameEl.addEventListener('dblclick', function () {
      const live = state.nodes.get(String(node.id)) || node;
      if (!live.ip) { log(live.name + ': no IP known yet — cannot open its dashboard', 'warn'); return; }
      window.open('https://' + live.ip + ':' + (live.port || 3000) + '/', '_blank', 'noopener');
    });

    // webcam
    const cam = el('div', 'fcc-cam-wrap');
    // No loading="lazy" here: this is an endless multipart MJPEG response, and a
    // lazily-deferred stream may never be started at all.
    const img = el('img'); img.alt = esc(node.name) + ' webcam';
    // Tell the browser the frame size up front. Streams are served at 320x240
    // (/etc/default/monsterbox-cam) since 2026-08-31; without intrinsic dimensions the
    // first frame of each of six streams triggers its own layout pass. decoding=async
    // keeps JPEG decode off the critical path -- six concurrent MJPEG decodes were the
    // bulk of ~4s of long tasks per load.
    img.width = 320; img.height = 240;
    img.decoding = 'async';
    const off = el('div', 'fcc-cam-off fcc-hidden', 'Webcam unavailable');
    if (node.online && !isNarrow()) { camStart(img, node.id); }
    else { off.textContent = 'Node offline'; off.classList.remove('fcc-hidden'); img.classList.add('fcc-invisible'); }
    // A manual click always overrides the give-up latch — the operator may have just
    // plugged a camera in, and should not have to reload the page to find out.
    off.onclick = function (ev) {
      ev.stopPropagation();
      img.dataset.camFails = '0';
      delete img.dataset.camGaveUp;
      off.textContent = 'Reconnecting…';
      camStart(img, node.id);
    };
    if (camVisibility) camVisibility.observe(img);
    cam.appendChild(img); cam.appendChild(off);
    cam.onclick = function () { openCam(node); };
    card.appendChild(cam);

    // body
    const body = el('div', 'fcc-card-body');

    const health = el('div', 'fcc-health mb-mono', '');
    health.setAttribute('data-role', 'health');
    body.appendChild(health);

    // Why this card is inert. Rendered for every node, shown only when offline.
    const note = el('div', 'mb-alert mb-alert-warning fcc-offline-note fcc-hidden',
      '<i class="bi bi-plug"></i><span>Offline — controls are disabled. Nothing on this card can reach the machine until it answers.</span>');
    note.setAttribute('data-role', 'offlineNote');
    body.appendChild(note);

    // Say / Ask row
    const sayGrp = el('div', 'mb-input-group');
    sayGrp.innerHTML =
      '<input type="text" class="mb-input mb-serif" data-role="text" placeholder="Say or Ask…" title="Text to speak or ask the AI" aria-label="Text to speak or ask">' +
      '<button class="mb-btn mb-btn-sm mb-btn-secondary" data-role="say" title="Speak this text (TTS)"><i class="bi bi-megaphone"></i></button>' +
      '<button class="mb-btn mb-btn-sm mb-btn-ai" data-role="ask" title="Ask the AI agent and speak the reply"><i class="bi bi-robot"></i></button>';
    body.appendChild(sayGrp);

    // Audio row
    const audioGrp = el('div', 'mb-input-group');
    audioGrp.innerHTML =
      '<select class="mb-select" data-role="audioSel" title="Audio clip on this node" aria-label="Audio clip"><option value="">— audio —</option></select>' +
      '<button class="mb-btn mb-btn-sm mb-btn-secondary" data-role="playAudio" title="Play selected audio"><i class="bi bi-play"></i></button>' +
      '<button class="mb-btn mb-btn-sm mb-btn-secondary" data-role="loopAudio" title="Loop selected audio"><i class="bi bi-repeat"></i></button>' +
      '<button class="mb-btn mb-btn-sm mb-btn-secondary" data-role="stopAudio" title="Stop audio on this node"><i class="bi bi-stop"></i></button>';
    body.appendChild(audioGrp);

    // Auto-AI row
    const autoGrp = el('div', 'mb-input-group');
    autoGrp.innerHTML =
      '<span class="mb-input-addon" title="Auto-AI makes the node speak on an interval">Auto-AI</span>' +
      '<input type="number" class="mb-input" data-role="autoInterval" value="30" min="5" title="Interval in seconds" aria-label="Auto-AI interval in seconds">' +
      '<button class="mb-btn mb-btn-sm mb-btn-secondary" data-role="autoStart" title="Start Auto-AI"><i class="bi bi-play-circle"></i></button>' +
      '<button class="mb-btn mb-btn-sm mb-btn-secondary" data-role="autoStop" title="Stop Auto-AI"><i class="bi bi-stop-circle"></i></button>';
    body.appendChild(autoGrp);

    card.appendChild(body);
    col.appendChild(card);
    wireCard(col, node);
    return col;
  }

  // Every control on a node card that talks to the machine. The target checkbox
  // is deliberately excluded: selecting a dead node is how you scope a reboot.
  const NODE_CONTROLS = ['text', 'say', 'ask', 'audioSel', 'playAudio', 'loopAudio',
                         'stopAudio', 'autoInterval', 'autoStart', 'autoStop'];

  function setCardEnabled(col, online) {
    NODE_CONTROLS.forEach(role => {
      const control = col.querySelector('[data-role="' + role + '"]');
      if (control) control.disabled = !online;
    });
    const note = col.querySelector('[data-role="offlineNote"]');
    if (note) note.classList.toggle('fcc-hidden', !!online);
    const cam = col.querySelector('.fcc-cam-wrap');
    if (cam) cam.setAttribute('aria-disabled', online ? 'false' : 'true');
  }

  function wireCard(col, node) {
    const id = node.id;
    const q = (r) => col.querySelector('[data-role="' + r + '"]');
    q('target').addEventListener('change', function () {
      if (this.checked) state.targets.add(String(id)); else state.targets.delete(String(id));
      refreshTargetSummary();
    });
    const textEl = q('text');
    q('say').addEventListener('click', () => doNode(id, '/say', { text: textEl.value }, node.name + ' speaking'));
    q('ask').addEventListener('click', () => doNode(id, '/ask-ai', { text: textEl.value }, node.name + ' asked AI'));
    q('playAudio').addEventListener('click', () => playAudio(id, node, false));
    q('loopAudio').addEventListener('click', () => playAudio(id, node, true));
    q('stopAudio').addEventListener('click', () => doNode(id, '/stop-audio', {}, node.name + ' audio stopped'));
    q('autoStart').addEventListener('click', () => doNode(id, '/auto-ai/start', { interval: parseInt(q('autoInterval').value, 10) || 30 }, node.name + ' Auto-AI on'));
    q('autoStop').addEventListener('click', () => doNode(id, '/auto-ai/stop', {}, node.name + ' Auto-AI off'));
    setCardEnabled(col, node.online);
    // lazy-load audio list once the node is known online
    // Deferred: the picker is not usable until the operator reaches for it, and
    // during page load these six proxied calls only crowded the fleet poll.
    if (node.online) whenIdle(() => loadAudio(id, col));
  }

  function patchCard(col, node) {
    const dot = col.querySelector('[data-role="dot"]');
    if (dot) {
      dot.className = 'mb-dot ' + (node.online ? 'mb-dot-live' : 'mb-dot-idle');
      dot.title = node.online ? 'Online' : 'Offline';
    }
    const chip = col.querySelector('[data-role="chip"]');
    if (chip) { const c = node.trusted === false ? 'untrusted' : (node.source || 'config'); chip.className = 'fcc-chip ' + c; chip.textContent = c; }
    const h = col.querySelector('[data-role="health"]');
    if (h) {
      if (node.online) {
        const bits = [];
        if (node.version) bits.push('v' + node.version);
        if (node.rssMb != null) bits.push(Math.round(node.rssMb) + 'MB');
        if (node.uptimeSec != null) bits.push('up ' + fmtUptime(node.uptimeSec));
        if (node.servoLatencyMs != null) bits.push(node.servoLatencyMs + 'ms');
        if (node.cpuCount != null) bits.push(node.cpuCount + ' cpu');
        h.textContent = bits.join(' · ') || (node.ip || '');
      } else {
        h.textContent = (node.error ? node.error : 'offline') + ' (' + (node.ip || '?') + ')';
      }
    }
    setCardEnabled(col, node.online);
    // Restart the stream on every poll where the img has no src — that covers both
    // "node just came online" and "the stream died and onerror cleared it", so a
    // camera that recovers comes back on its own without a page reload.
    const img = col.querySelector('.fcc-cam-wrap img');
    if (img) {
      // The snapshot loop is self-healing, so a poll only needs to start or stop it:
      // start when a node comes online, stop the moment it goes away so an offline
      // node is not polled for pictures it cannot take.
      if (node.online && !isNarrow()) {
        if (img.dataset.camWanted !== '1') camStart(img, node.id);
      } else if (img.dataset.camWanted === '1') {
        camStop(img);
        const camOff = col.querySelector('.fcc-cam-off');
        if (camOff && !node.online) { camOff.textContent = 'Node offline'; camOff.classList.remove('fcc-hidden'); }
        img.classList.add('fcc-invisible');
      }
    }
  }

  function fmtUptime(s) { s = Math.round(s); if (s < 90) return s + 's'; if (s < 5400) return Math.round(s / 60) + 'm'; return Math.round(s / 3600) + 'h'; }

  // ---------- node actions ----------
  async function doNode(id, path, body, okMsg) {
    try { const r = await api('/animatronic/' + id + '/' + path.replace(/^\//, ''), { method: 'POST', body: JSON.stringify(body || {}) });
      log(okMsg + (r && r.data && r.data.text ? ': “' + r.data.text + '”' : ''), 'ok');
    } catch (e) { log('Node ' + id + ' ' + path + ' failed: ' + e.message, 'err'); }
  }
  async function loadAudio(id, col) {
    try {
      const r = await api('/animatronic/' + id + '/audio-files');
      const sel = col.querySelector('[data-role="audioSel"]');
      if (!sel) return;
      const files = (r && (r.audio || r.files)) || [];
      for (const f of files) {
        const o = el('option'); o.value = f.id || f.filename; o.textContent = f.title || f.filename || o.value;
        o.setAttribute('data-filename', f.filename || ''); sel.appendChild(o);
      }
    } catch (e) { /* node may have no audio API — non-fatal */ }
  }
  async function playAudio(id, node, loop) {
    const col = $('#' + cardId(id)); const sel = col && col.querySelector('[data-role="audioSel"]');
    if (!sel || !sel.value) { log(node.name + ': pick an audio clip first', 'warn'); return; }
    const opt = sel.options[sel.selectedIndex];
    try {
      await api('/animatronic/' + id + '/play-audio', { method: 'POST', body: JSON.stringify({ audioId: sel.value, filename: opt.getAttribute('data-filename') || undefined, audioTitle: opt.textContent, loop: !!loop }) });
      log(node.name + (loop ? ' looping ' : ' playing ') + '“' + opt.textContent + '”', 'ok');
    } catch (e) { log(node.name + ' play-audio failed: ' + e.message, 'err'); }
  }

  // ---------- webcam modal ----------
  let camModal = null;
  function openCam(node) {
    if (!node.online) return;
    if (!camModal) camModal = new bootstrap.Modal($('#fccCamModal'));
    $('#fccCamTitle').textContent = node.name + ' — live';
    startCam($('#fccCamModalImg'), node.id); // cache-buster too: never replay a cached failure
    camModal.show();
  }
  $('#fccCamModal').addEventListener('hidden.bs.modal', () => { $('#fccCamModalImg').src = ''; });

  // ---------- fleet health poll ----------
  // A poll that is still in flight must not be joined by the next one. The interval
  // is 15s but a slow fleet made refresh() take longer than that, and the overlapping
  // polls competed for the same connections and made each other slower still.
  let refreshInFlight = false;
  async function refresh() {
    if (refreshInFlight) return;
    refreshInFlight = true;
    try { await refreshOnce(); } finally { refreshInFlight = false; }
  }

  async function refreshOnce() {
    // Independent calls, issued together: serially these cost two round trips and
    // left the wall stale for the sum of both.
    const [healthRes, nodesRes] = await Promise.allSettled([api('/fleet-health'), api('/nodes')]);
    if (healthRes.status !== 'fulfilled') {
      const msg = healthRes.reason && healthRes.reason.message || 'unknown error';
      log('Fleet health failed: ' + msg, 'err'); showWallError(msg); return;
    }
    const health = healthRes.value;
    const nodesInfo = nodesRes.status === 'fulfilled' ? nodesRes.value : { nodes: [], avahiAvailable: null };

    // merge /nodes provenance (source/trust) into health cards by id
    const prov = new Map();
    (nodesInfo.nodes || []).forEach(n => prov.set(String(n.id), n));
    const merged = (health.nodes || []).map(n => {
      const p = prov.get(String(n.id)) || {};
      return Object.assign({}, n, { source: p.source || n.source, trusted: p.trusted, hostname: p.hostname });
    });

    renderWall(merged);
    renderFleetPill(health);
    renderDiscovery(nodesInfo);
  }

  function renderWall(nodes) {
    const loading = $('#wallLoading'); if (loading) loading.remove();
    // Drop the reserved skeletons the moment real cards are about to be appended.
    document.querySelectorAll('.fcc-skeleton-col').forEach(sk => sk.remove());
    const wall = $('#nodeWall');
    // online first, then offline; stable by id within group
    nodes.sort((a, b) => (b.online === a.online) ? String(a.id).localeCompare(String(b.id)) : (b.online ? 1 : -1));
    for (const node of nodes) {
      state.nodes.set(String(node.id), node);
      let col = $('#' + cardId(node.id));
      if (!col) { col = buildCard(node); wall.appendChild(col); }
      patchCard(col, node); // populate health/dot immediately on first render too
      col.classList.toggle('fcc-ghost', !node.online);
    }
    refreshTargetSummary();
  }
  function showWallError(msg) {
    const wall = $('#nodeWall');
    if (wall.querySelector('.fcc-card')) return; // keep existing cards
    wall.innerHTML = '<div class="col-12"><div class="mb-alert mb-alert-danger mb-row-between">' +
      '<span>Could not load fleet: ' + esc(msg) + '</span>' +
      '<button class="mb-btn mb-btn-sm mb-btn-secondary" onclick="location.reload()" title="Reload the page and try again">Retry</button></div></div>';
  }
  function renderFleetPill(health) {
    const online = health.online || 0, total = health.total || 0;
    $('#fleetCount').textContent = online + ' / ' + total + ' online';
    const dot = $('#fleetDot');
    dot.className = 'mb-dot ' + (online === 0 ? 'mb-dot-idle' : (online < total ? 'mb-dot-warning' : 'mb-dot-live'));
  }
  function renderDiscovery(info) {
    state.avahi = info.avahiAvailable;
    const ds = $('#discoveryState');
    if (info.avahiAvailable === true) ds.innerHTML = 'mDNS: <span class="mb-text-success">available</span>';
    else if (info.avahiAvailable === false) ds.innerHTML = 'mDNS: <span class="mb-text-warning">unavailable</span> — using config + pins';
    else ds.innerHTML = 'mDNS: <span class="mb-text-secondary">unknown</span>';
    const counts = { config: 0, discovered: 0, manual: 0 };
    (info.nodes || []).forEach(n => { counts[n.source] = (counts[n.source] || 0) + 1; });
    $('#sourceBreakdown').textContent = counts.config + ' config · ' + counts.discovered + ' discovered · ' + counts.manual + ' pinned';
  }

  // ---------- goblins ----------
  async function loadGoblins() {
    const row = $('#goblinRow');
    try {
      const res = await fetch('/goblin-management/api/goblins');
      const data = await res.json();
      const goblins = (data && (data.goblins || data)) || [];
      if (!goblins.length) { row.innerHTML = '<div class="col-12 mb-text-sm mb-text-secondary">No goblins registered.</div>'; return; }
      row.innerHTML = '';
      goblins.forEach(g => {
        const id = g.id || g.goblinId; // fixed: goblin objects expose `id`, not `goblinId`
        const online = g.online || g.status === 'online';
        const col = el('div', 'col-sm-6 col-lg-3');
        col.innerHTML = '<div class="mb-card mb-row-sm align-items-center">' +
          '<span class="mb-dot ' + (online ? 'mb-dot-live' : 'mb-dot-idle') + '" title="' + (online ? 'Online' : 'Offline') + '"></span>' +
          '<span class="fcc-card-name mb-serif" title="' + esc(g.name || id) + '">' + esc(g.name || id) + '</span>' +
          '<a class="mb-btn mb-btn-sm mb-btn-secondary" href="/goblin-management?goblin=' + encodeURIComponent(id) + '" title="Open in Goblin Management">Manage</a>' +
          '</div>';
        row.appendChild(col);
      });
    } catch (e) { row.innerHTML = '<div class="col-12 mb-text-sm mb-text-danger">Goblin list failed: ' + esc(e.message) + '</div>'; }
  }

  // ---------- global actions ----------
  async function fleetAction(desc, path, opts) {
    try {
      const r = await api(path, opts);
      const partial = r && typeof r.successful === 'number' && r.successful > 0 && r.failed > 0;
      log(desc + ' → ' + summarize(r), (r && r.success === false) || partial ? 'warn' : 'ok');
      logNodeFailures(r);
      if (partial) announce(desc + ': only ' + r.successful + ' of ' + r.total + ' nodes accepted it — see the command log.', 'warning');
      return r;
    }
    catch (e) { log(desc + ' failed: ' + e.message, 'err'); announce(desc + ' failed: ' + e.message, 'danger'); }
  }

  document.querySelectorAll('.fcc-sp').forEach(btn => {
    btn.addEventListener('click', async () => {
      const sp = btn.getAttribute('data-sp');
      const next = !btn.classList.contains('on');
      btn.setAttribute('data-busy', 'true');
      const r = await fleetAction((next ? 'Enable ' : 'Disable ') + sp, '/superpower/' + sp,
        { method: 'POST', body: JSON.stringify({ enabled: next, ids: targetIds() }) });
      btn.removeAttribute('data-busy');
      if (!r) return;
      // Three states. A toggle that reached some of the fleet is neither on nor
      // off, and the operator has to be able to see that at a glance.
      const partial = typeof r.successful === 'number' && r.successful > 0 && r.failed > 0;
      btn.classList.toggle('mixed', partial);
      btn.classList.toggle('on', !partial && next && r.successful > 0);
      btn.title = partial
        ? sp + ': ' + r.successful + ' of ' + r.total + ' nodes accepted this — the fleet is not in one state'
        : btn.title.split('\n')[0];
    });
  });

  // ---------- fleet prompt ----------
  // Short, clear English. The first is deliberately the literal form: the word `say`
  // followed by the words, no quotes needed.
  const PROMPT_EXAMPLES = [
    'say Welcome to Warner Castle',
    'make them all howl at the moon',
    'everyone greet our guest by name',
    'run a short welcome ceremony together',
  ];

  // Quotes are optional around what you want said. If they are there, drop them --
  // otherwise the animatronic dutifully pronounces them. Handles straight, curly and
  // guillemet pairs.
  function stripWrappingQuotes(str) {
    const pairs = [['"', '"'], ["'", "'"], ['\u201C', '\u201D'], ['\u2018', '\u2019'], ['\u00AB', '\u00BB']];
    let out = String(str || '').trim();
    for (const [open, close] of pairs) {
      if (out.length >= 2 && out[0] === open && out[out.length - 1] === close) {
        return out.slice(1, -1).trim();
      }
    }
    return out;
  }

  // `say <words>` -> speak those words verbatim. Anything else -> hand the whole thing
  // to the agents as an instruction. Exported onto window for testing.
  function parseFleetPrompt(raw) {
    const text = String(raw || '').trim();
    if (!text) return null;
    const literal = text.match(/^say\b\s*([\s\S]*)$/i);
    if (literal) {
      const words = stripWrappingQuotes(literal[1]);
      // "say" with nothing after it is not a literal command; let the agents field it.
      if (words) return { mode: 'say', text: words };
    }
    return { mode: 'agent', text: stripWrappingQuotes(text) };
  }
  window.parseFleetPrompt = parseFleetPrompt;

  (function wirePromptExamples() {
    const input = $('#sayAllText');
    const hint = $('#promptHint');
    if (!input) return;
    let i = 0;
    // Cycle the greyed example while the box is empty; it disappears the moment they
    // type, because that is what a placeholder does.
    const cycle = setInterval(() => {
      if (input.value || document.activeElement === input) return;
      i = (i + 1) % PROMPT_EXAMPLES.length;
      input.placeholder = PROMPT_EXAMPLES[i];
    }, 4000);
    window.addEventListener('beforeunload', () => clearInterval(cycle));
    const syncHint = () => { if (hint) hint.classList.toggle('fcc-hidden', !!input.value); };
    input.addEventListener('input', syncHint);
    syncHint();
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') $('#sayAllBtn').click(); });
  })();

  $('#sayAllBtn').addEventListener('click', async () => {
    const parsed = parseFleetPrompt($('#sayAllText').value);
    if (!parsed) return;
    const { mode, text } = parsed;
    const names = () => (state.targets.size ? targetLabel() : 'the fleet');

    if (mode === 'say') {
      // Literal speech — unchanged behaviour, just with the `say` prefix removed.
      log('Say to ' + names() + ': "' + text + '"', 'ok');
      if (state.targets.size) { for (const id of state.targets) doNode(id, '/say', { text }, (state.nodes.get(String(id)) || {}).name + ' speaking'); }
      else fleetAction('Say-all', '/say-all', { method: 'POST', body: JSON.stringify({ text }) });
      return;
    }

    // Agent instruction. There is no fleet-wide ask endpoint, so fan out per node the
    // same way a targeted say already does. Each node's /ask-ai forwards to its own
    // ElevenLabs agent with its own characterId, so every character answers in its own
    // voice and personality rather than reciting one shared line.
    const ids = state.targets.size
      ? Array.from(state.targets)
      : Array.from(state.nodes.values()).filter(n => n.online).map(n => n.id);
    if (!ids.length) { log('No online nodes to instruct', 'warn'); return; }
    log('Instruction to ' + names() + ' (' + ids.length + ' agent' + (ids.length === 1 ? '' : 's') + '): ' + text, 'ok');
    for (const id of ids) {
      const node = state.nodes.get(String(id)) || {};
      doNode(id, '/ask-ai', { text }, (node.name || id) + ' interpreting');
    }
  });

  $('#startLoops').addEventListener('click', () => fleetAction('Start queue loops', '/start-all-queue-loops', { method: 'POST' }));
  $('#stopLoops').addEventListener('click', () => fleetAction('Stop queue loops', '/stop-all-queue-loops', { method: 'POST', body: JSON.stringify({ ids: targetIds() }) }));
  $('#restartSvc').addEventListener('click', async () => {
    if (await askConfirm('Restart MonsterBox service?', 'Each targeted animatronic restarts its service and drops offline for a few seconds.', targetLabel()))
      fleetAction('Restart services', '/restart-services', { method: 'POST' });
  });
  $('#rebootAll').addEventListener('click', async () => {
    if (await askConfirm('Reboot animatronics?', 'These machines will power-cycle their OS and be offline for roughly 30 seconds.', targetLabel()))
      fleetAction('Reboot', '/reboot/animatronics', { method: 'POST', body: JSON.stringify({ ids: targetIds() ? targetIds().map(Number) : undefined }) });
  });
  $('#estop').addEventListener('click', async () => {
    if (await askConfirm('EMERGENCY STOP', 'Halts scene queues, stops audio, disables random poses and mutes every targeted node immediately.', targetLabel()))
      fleetAction('EMERGENCY STOP', '/emergency-stop', { method: 'POST', body: JSON.stringify({ ids: targetIds() }) });
  });

  const volEl = $('#masterVol'); let volTimer = null;
  volEl.addEventListener('input', () => { $('#masterVolVal').textContent = volEl.value + '%'; });
  volEl.addEventListener('change', () => {
    clearTimeout(volTimer);
    volTimer = setTimeout(() => fleetAction('Master volume ' + volEl.value + '%', '/volume', { method: 'PUT', body: JSON.stringify({ volume: parseInt(volEl.value, 10), ids: targetIds() }) }), 250);
  });

  $('#clearTargets').addEventListener('click', () => {
    state.targets.clear();
    document.querySelectorAll('[data-role="target"]').forEach(c => { c.checked = false; });
    refreshTargetSummary();
  });
  $('#refreshBtn').addEventListener('click', refresh);
  $('#clearLog').addEventListener('click', () => { $('#commandLog').innerHTML = ''; });

  $('#pinForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = $('#pinId').value.trim(), ip = $('#pinIp').value.trim(), name = $('#pinName').value.trim();
    if (!id || !ip) { log('Pin needs at least id and IP', 'warn'); announce('Pin needs at least an id and an IP address.', 'warning'); return; }
    try { await api('/nodes/manual', { method: 'POST', body: JSON.stringify({ id, ip, name }) }); log('Pinned node ' + name + ' (' + ip + ')', 'ok'); $('#pinForm').reset(); refresh(); }
    catch (err) { log('Pin failed: ' + err.message, 'err'); announce('Pin failed: ' + err.message, 'danger'); }
  });

  // ---------- boot ----------
  log('Fleet Command Center ready', 'muted');
  refresh(); loadGoblins();
  setInterval(mirrorFleetPill, 2000);
  // Goblins render asynchronously, so wire the roll-ups after that has had a chance to
  // paint; the helper is idempotent (it skips anything already marked collapsible).
  makeSectionsCollapsible();
  setTimeout(makeSectionsCollapsible, 1500);
  window.addEventListener('resize', makeSectionsCollapsible);
  setInterval(refresh, POLL_MS);
})();
</script>
