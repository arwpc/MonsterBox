#!/bin/bash
# MonsterBox pre-push hook — run the gate before anything reaches origin.
# Bypass in emergencies only: MB_SKIP_GATE=1 git push   (CI still runs the gate)
# Install (also done by install.sh):
#   cp scripts/git-hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
if [ "${MB_SKIP_GATE:-0}" = "1" ]; then
    echo "MB_SKIP_GATE=1 — skipping gate (CI will still run it)"
    exit 0
fi
npm run gate
